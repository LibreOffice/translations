#. %SLIDES will be replaced with the number of slides to delete
#: sdext/inc/strings.hrc:24
msgctxt "STR_DELETE_SLIDES"
msgid "Delete 1 slide."
msgid_plural "Delete %SLIDES slides."
msgstr[0] "یک اسلاید را حذف کن."
msgstr[1] "%SLIDES اسلاید را حذف کن."

#. DBh7w
#. %IMAGES will be replaced with the number of images to optimize. It will only be used in the plural.
#: sdext/inc/strings.hrc:26
msgctxt "STR_OPTIMIZE_IMAGES"
msgid "Optimize 1 image to %QUALITY% JPEG quality at %RESOLUTION DPI."
msgid_plural "Optimize %IMAGES images to %QUALITY% JPEG quality at %RESOLUTION DPI."
msgstr[0] "یک تصویر را با کیفیت JPEG معادل %QUALITY% و وضوح %RESOLUTION DPI بهینه‌سازی کن."
msgstr[1] "%IMAGES تصویر را با کیفیت JPEG معادل %QUALITY% و وضوح %RESOLUTION DPI بهینه‌سازی کن."


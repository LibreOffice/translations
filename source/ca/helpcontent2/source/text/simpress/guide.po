#: printing.xhp
msgctxt ""
"printing.xhp\n"
"par_id3157875\n"
"help.text"
msgid "Choose <emph>File - Print</emph>."
msgstr "Trieu <emph>Fitxer ▸ Imprimeix</emph>."

#. t7G82
#: printing.xhp

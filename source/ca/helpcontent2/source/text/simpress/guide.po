#: printing.xhp
msgctxt ""
"printing.xhp\n"
"par_id2901394\n"
"help.text"
msgid "Choose <item type=\"menuitem\">File - Print</item>."
msgstr "Trieu <item type=\"menuitem\">Fitxer ▸ Imprimeix</item>."


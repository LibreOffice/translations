msgid "The maximum number of rows has been exceeded. Excess rows were not imported!"
msgstr "Maksymalno wielość wierszōw była przekroczōno. Nadmiarowe wiersze niy były zaimportowane!"

#. nvQMF
#: sc/inc/scerrors.hrc:76
msgctxt "RID_ERRHDLSC"
msgid "The data could not be loaded completely because the maximum number of rows per sheet was exceeded."
msgstr "Niy wszyjske dane mogły być zaladowane, bo maksymalno wielość wierszōw we arsze była przekroczōno."

#. gCUj2

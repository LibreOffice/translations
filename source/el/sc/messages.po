msgctxt "ocV_LOOKUP"
msgid "Search criterion"
msgstr "Κριτήριο αναζήτησης"

#. 36Fus
#: sc/inc/scfuncs.hrc:3439
msgctxt "ocV_LOOKUP"
msgid "The value to be found in the first column."
msgstr "Η τιμή αναζήτησης της πρώτης στήλης."

#. 4YE5g
#: sc/inc/scfuncs.hrc:3440
msgctxt "ocV_LOOKUP"
msgid "Array"
msgstr "Πίνακας"

#. GNBYQ
#: sc/inc/scfuncs.hrc:3441
msgctxt "ocV_LOOKUP"
msgid "The array or range for referencing."
msgstr "Ο πίνακας ή η περιοχή για παραπομπή."

#. FzFuG
#: sc/inc/scfuncs.hrc:3442
msgctxt "ocV_LOOKUP"
msgid "Index"
msgstr "Δείκτης"

#. bbGH5
#: sc/inc/scfuncs.hrc:3443
msgctxt "ocV_LOOKUP"
msgid "Column index number in the array."
msgstr "Αριθμός ευρετηρίου στήλης στον πίνακα."

#. 69ZMK
#: sc/inc/scfuncs.hrc:3444
msgctxt "ocV_LOOKUP"
msgid "Sorted range lookup"
msgstr "Ταξινομημένη αναζήτηση περιοχής"

#. Tvcub
#: sc/inc/scfuncs.hrc:3445
msgctxt "ocV_LOOKUP"
msgid "If the value is TRUE or not given, the search column of the array represents a series of ranges, and must be sorted in ascending order."
msgstr "Εάν η τιμή είναι TRUE ή δεν δίνεται, η στήλη αναζήτησης του πίνακα αντιπροσωπεύει σειρά περιοχών και πρέπει να ταξινομηθεί κατά αύξουσα σειρά."

#. t6g9j
#: sc/inc/scfuncs.hrc:3451
msgctxt "ocX_LOOKUP"

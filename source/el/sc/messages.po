msgstr "Ο πίνακας ή η περιοχή για την παραπομπή."

#. sZVjU
#: sc/inc/scfuncs.hrc:3428
msgctxt "ocH_LOOKUP"
msgid "Index"
msgstr "Δείκτης"

#. yW8Mk
#: sc/inc/scfuncs.hrc:3429
msgctxt "ocH_LOOKUP"
msgid "The row index in the array."
msgstr "Ο δείκτης γραμμών στον πίνακα."

#. DoWac
#: sc/inc/scfuncs.hrc:3430
msgctxt "ocH_LOOKUP"
msgid "Sorted range lookup"
msgstr "Ταξινομημένη αναζήτηση περιοχής"

#. zmBsJ
#: sc/inc/scfuncs.hrc:3431
msgctxt "ocH_LOOKUP"
msgid "If the value is TRUE or not given, the search row of the array represents a series of ranges, and must be sorted in ascending order."
msgstr "Εάν η τιμή είναι TRUE ή δεν δίνεται, η γραμμή αναζήτησης του πίνακα αντιπροσωπεύει σειρά περιοχών και πρέπει να ταξινομηθεί σε αύξουσα σειρά."

#. siCjd
#: sc/inc/scfuncs.hrc:3437
msgctxt "ocV_LOOKUP"

msgid "Rounds a number to predefined significant digits."
msgstr "Στρογγυλοποιεί έναν αριθμό στα προκαθορισμένα σημαντικά ψηφία."

#. pGftA
#: sc/inc/scfuncs.hrc:4179
msgctxt "ocROUNDSIG"
msgid "Value"
msgstr "Τιμή"

#. DBGjV
#: sc/inc/scfuncs.hrc:4180
msgctxt "ocROUNDSIG"
msgid "The number to be rounded."
msgstr "Ο αριθμός που θα στρογγυλοποιηθεί."

#. PhDoE
#: sc/inc/scfuncs.hrc:4181
msgctxt "ocROUNDSIG"
msgid "Digits"
msgstr "Ψηφία"

#. Tr4Mj
#: sc/inc/scfuncs.hrc:4182
msgctxt "ocROUNDSIG"
msgid "The number of significant digits to which value is to be rounded."
msgstr "Ο αριθμός των σημαντικών ψηφίων στα οποία θα στρογγυλοποιηθεί η τιμή."

#. XCopK
#: sc/inc/scfuncs.hrc:4187
msgctxt "ocREPLACEB"
msgid "Replaces characters within a text string with a different text string, with DBCS."
msgstr "Αντικαθιστά χαρακτήρες σε συμβολοσειρά κειμένου με διαφορετική συμβολοσειρά κειμένου, με DBCS."

#. mALez
#: sc/inc/scfuncs.hrc:4188
msgctxt "ocREPLACEB"
msgid "Text"
msgstr "Κείμενο"

#. nnRic
#: sc/inc/scfuncs.hrc:4189
msgctxt "ocREPLACEB"
msgid "The text in which some characters are to be replaced."
msgstr "Το κείμενο στο οποίο θα αντικατασταθούν κάποιοι χαρακτήρες."

#. 7Rm6G
#: sc/inc/scfuncs.hrc:4190
msgctxt "ocREPLACEB"
msgid "Position"
msgstr "Θέση"

#. DvGNE
#: sc/inc/scfuncs.hrc:4191
msgctxt "ocREPLACEB"
msgid "The character position from which text is to be replaced."
msgstr "Η θέση του χαρακτήρα από την οποία θα αντικατασταθεί το κείμενο."

#. ASw33
#: sc/inc/scfuncs.hrc:4192
msgctxt "ocREPLACEB"
msgid "Length"
msgstr "Μήκος"

#. 6SDEX
#: sc/inc/scfuncs.hrc:4193
msgctxt "ocREPLACEB"
msgid "The number of characters to be replaced."
msgstr "Ο αριθμός των χαρακτήρων που θα αντικατασταθούν."

#. HNuH5
#: sc/inc/scfuncs.hrc:4194
msgctxt "ocREPLACEB"
msgid "New text"
msgstr "Νέο κείμενο"

#. AcoCB
#: sc/inc/scfuncs.hrc:4195
msgctxt "ocREPLACEB"
msgid "The text to be inserted."
msgstr "Το κείμενο που θα εισαχθεί."

#. 2AsJk
#: sc/inc/scfuncs.hrc:4201
msgctxt "ocFINDB"
msgid "Looks for a string of text within another (case sensitive), using byte positions."
msgstr "Αναζητεί συμβολοσειρά κειμένου μέσα σε άλλη (διάκριση πεζών - κεφαλαίων), χρησιμοποιώντας θέσης ψηφιολέξεων (byte)."

#. 8QmhN
#: sc/inc/scfuncs.hrc:4202
msgctxt "ocFINDB"
msgid "Find text"
msgstr "Εύρεση κειμένου"

#. DDBpT
#: sc/inc/scfuncs.hrc:4203
msgctxt "ocFINDB"
msgid "The text to be found."
msgstr "Το κείμενο που θα βρεθεί."

#. wfRuB
#: sc/inc/scfuncs.hrc:4204
msgctxt "ocFINDB"
msgid "Text"
msgstr "Κείμενο"

#. DmzDs
#: sc/inc/scfuncs.hrc:4205
msgctxt "ocFINDB"
msgid "The text in which a search is to be made."
msgstr "Το κείμενο όπου θα γίνει η αναζήτηση."

#. mo2Wk
#: sc/inc/scfuncs.hrc:4206
msgctxt "ocFINDB"
msgid "Position"
msgstr "Θέση"

#. Xfkdk
#: sc/inc/scfuncs.hrc:4207
msgctxt "ocFINDB"
msgid "The position in the text from which the search starts."
msgstr "Η θέση στο κείμενο, από την οποία θα ξεκινήσει η αναζήτηση."

#. tEDa4
#: sc/inc/scfuncs.hrc:4213
msgctxt "ocSEARCHB"
msgid "Looks for a string of text within another (not case sensitive), using byte positions."
msgstr "Αναζητεί συμβολοσειρά κειμένου μέσα σε άλλη (διάκριση πεζών - κεφαλαίων), χρησιμοποιώντας θέσεις ψηφιολέξεων (byte)."

#. QcxMk
#: sc/inc/scfuncs.hrc:4214
msgctxt "ocSEARCHB"
msgid "Find text"
msgstr "Εύρεση κειμένου"

#. YhDPX
#: sc/inc/scfuncs.hrc:4215
msgctxt "ocSEARCHB"
msgid "The text to be found."
msgstr "Το κείμενο που θα βρεθεί."

#. uREXw
#: sc/inc/scfuncs.hrc:4216
msgctxt "ocSEARCHB"
msgid "Text"
msgstr "Κείμενο"

#. FdNfZ
#: sc/inc/scfuncs.hrc:4217
msgctxt "ocSEARCHB"
msgid "The text in which a search is to be made."
msgstr "Το κείμενο όπου θα γίνει η αναζήτηση."

#. gEBkG
#: sc/inc/scfuncs.hrc:4218
msgctxt "ocSEARCHB"
msgid "Position"
msgstr "Θέση"

#. YGeMx
#: sc/inc/scfuncs.hrc:4219
msgctxt "ocSEARCHB"
msgid "The position in the text from which the search starts."
msgstr "Η θέση στο κείμενο, από την οποία θα ξεκινήσει η αναζήτηση."

#. VPfDS
#: sc/inc/scfuncs.hrc:4225
msgctxt "ocFOURIER"
msgid "Computes the Discrete Fourier Transform (DFT) of an array"
msgstr "Υπολογίζει τον διακριτό μετασχηματισμό Φουριέ (DFT) ενός πίνακα"

#. SV2Tq
#: sc/inc/scfuncs.hrc:4226
msgctxt "ocFOURIER"
msgid "Array"
msgstr "Πίνακας"

#. K9YnP
#: sc/inc/scfuncs.hrc:4227
msgctxt "ocFOURIER"
msgid "The array whose DFT needs to be computed. The dimensions of this array can be Nx1 or Nx2 or 1xN or 2xN."
msgstr "Ο πίνακας του οποίου το DFT χρειάζεται να υπολογιστεί. Οι διαστάσεις αυτού του πίνακα μπορεί να είναι Nx1, ή Nx2, ή 1xN, ή 2xN."

#. RL4zG
#: sc/inc/scfuncs.hrc:4228
msgctxt "ocFOURIER"
msgid "GroupedByColumns"
msgstr "Ομαδοποιημένος κατά στήλες"

#. jJ5f8
#: sc/inc/scfuncs.hrc:4229
msgctxt "ocFOURIER"
msgid "Flag to indicate whether the array is grouped by columns or not (default TRUE)."
msgstr "Σημαία για να υποδεικνύει εάν ο πίνακας είναι ομαδοποιημένος κατά στήλες ή όχι (προεπιλογή ΑΛΗΘΕΣ (TRUE))."

#. KqWyU
#: sc/inc/scfuncs.hrc:4230
msgctxt "ocFOURIER"
msgid "Inverse"
msgstr ""

#. RJc49
#: sc/inc/scfuncs.hrc:4231
msgctxt "ocFOURIER"
msgid "Flag to indicate whether an inverse DFT is to be computed (default FALSE)."
msgstr "Σημαία για δείξει εάν πρόκειται να υπολογιστεί ένας αντίστροφος DFT (προεπιλογή ψευδές (FALSE))."

#. UKq8b
#: sc/inc/scfuncs.hrc:4232
msgctxt "ocFOURIER"
msgid "Polar"
msgstr "Πολικός"

#. 2Fzbq
#: sc/inc/scfuncs.hrc:4233
msgctxt "ocFOURIER"
msgid "Flag to indicate whether to return the results in polar form (default FALSE)."
msgstr "Σημαία για να δείξει εάν τα αποτελέσματα θα επιστρέψουν σε πολική μορφή (προεπιλογή ψευδές (FALSE))."

#. 6A3GQ
#: sc/inc/scfuncs.hrc:4234
msgctxt "ocFOURIER"
msgid "MinimumMagnitude"
msgstr "Ελάχιστο μέγεθος"

#. WFDbz
#: sc/inc/scfuncs.hrc:4235
msgctxt "ocFOURIER"
msgid "In case of Polar=TRUE, the frequency components below this magnitude are clipped out (default 0.0)."
msgstr "Στην περίπτωση που πολικός=αληθής (Polar=TRUE), τα συστατικά συχνότητας κάτω από αυτό το μέγεθος περικόπτονται (προεπιλογή 0,0)."

#. SDqjG
#: sc/inc/scfuncs.hrc:4241
msgctxt "ocRANDOM_NV"
msgid "Returns a random number between 0 and 1, non-volatile."
msgstr "Επιστρέφει τυχαίο αριθμό μεταξύ 0 και 1,  μόνιμο."

#. zUzWN
#: sc/inc/scfuncs.hrc:4247
msgctxt "ocRANDBETWEEN_NV"
msgid "Returns a random integer between the specified Bottom and Top values (both inclusive), non-volatile."
msgstr "Επιστρέφει έναν τυχαίο ακέραιο μεταξύ των καθορισμένων τιμών κάτω και άνω (συμπεριλαμβανομένων και των δύο), σταθερό."

#. XRTEX
#: sc/inc/scfuncs.hrc:4248
msgctxt "ocRANDBETWEEN_NV"
msgid "Bottom"
msgstr ""

#. Vipt3
#: sc/inc/scfuncs.hrc:4249
msgctxt "ocRANDBETWEEN_NV"
msgid "The smallest integer that can be returned."
msgstr "Ο μικρότερος ακέραιος αριθμός που μπορεί να επιστραφεί."

#. TXWYA
#: sc/inc/scfuncs.hrc:4250
msgctxt "ocRANDBETWEEN_NV"
msgid "Top"
msgstr ""

#. A6fAC
#: sc/inc/scfuncs.hrc:4251
msgctxt "ocRANDBETWEEN_NV"
msgid "The largest integer that can be returned."
msgstr "Ο μεγαλύτερος ακέραιος αριθμός που μπορεί να επιστραφεί."

#. TVBBo
#: sc/inc/scfuncs.hrc:4257
msgctxt "ocFILTER"
msgid "Filters an array based on a Boolean (True/False) array."
msgstr "Φιλτράρει έναν πίνακα που βασίζεται σε έναν πίνακα Μπουλ (True/False)."

#. d65Ge
#: sc/inc/scfuncs.hrc:4258
msgctxt "ocFILTER"
msgid "Range"
msgstr "Περιοχή"

#. RMEDy
#: sc/inc/scfuncs.hrc:4259
msgctxt "ocFILTER"
msgid "The array, or range to filter."
msgstr "Ο πίνακας ή το εύρος για φιλτράρισμα."

#. DaokM
#: sc/inc/scfuncs.hrc:4260
msgctxt "ocFILTER"
msgid "Include"
msgstr ""

#. AEy68
#: sc/inc/scfuncs.hrc:4261
msgctxt "ocFILTER"
msgid "A Boolean array whose height or width is the same as the array."
msgstr "Ένας πίνακας Μπουλ του οποίου το ύψος ή το πλάτος είναι το ίδιο με τον πίνακα."

#. hGyPL
#: sc/inc/scfuncs.hrc:4262
msgctxt "ocFILTER"
msgid "Result if empty"
msgstr "Αποτέλεσμα εάν είναι κενό"

#. Ka6BT
#: sc/inc/scfuncs.hrc:4263
msgctxt "ocFILTER"
msgid "The value to return if all values in the included array are empty (filter returns nothing)."
msgstr "Η τιμή προς επιστροφή εάν όλες οι τιμές στον πίνακα που περιλαμβάνεται είναι κενές (το φίλτρο δεν επιστρέφει τίποτα)."

#. nxhBg
#: sc/inc/scfuncs.hrc:4269
msgctxt "ocSORT"
msgid "Sorts the contents of a range or array."
msgstr "Ταξινομεί τα περιεχόμενα μιας περιοχής ή πίνακα."

#. HKENV
#: sc/inc/scfuncs.hrc:4270
msgctxt "ocSORT"
msgid "Range"
msgstr "Περιοχή"

#. vgj8a
#: sc/inc/scfuncs.hrc:4271
msgctxt "ocSORT"
msgid "The range, or array to sort."
msgstr "Το εύρος ή ο πίνακας για ταξινόμηση."

#. mdeDi
#: sc/inc/scfuncs.hrc:4272
msgctxt "ocSORT"
msgid "Sort index"
msgstr "Ταξινόμηση ευρετηρίου"

#. DuQFW
#: sc/inc/scfuncs.hrc:4273
msgctxt "ocSORT"
msgid "A number indicating the row or column to sort by."
msgstr "Ένας αριθμός που υποδεικνύει τη σειρά ή τη στήλη προς ταξινόμηση."

#. BK4XX
#: sc/inc/scfuncs.hrc:4274
msgctxt "ocSORT"
msgid "Sort order"
msgstr "Σειρά ταξινόμησης"

#. zFBzs
#: sc/inc/scfuncs.hrc:4275
msgctxt "ocSORT"
msgid "A number indicating the desired sort order; 1 for ascending order (default), -1 for descending order."
msgstr "Ένας αριθμός που υποδεικνύει την επιθυμητή σειρά ταξινόμησης. 1 για αύξουσα σειρά (προεπιλογή), -1 για φθίνουσα σειρά."

#. ResTu
#: sc/inc/scfuncs.hrc:4276
msgctxt "ocSORT"
msgid "By col"
msgstr "Κατά στήλη"

#. DwWWz
#: sc/inc/scfuncs.hrc:4277
msgctxt "ocSORT"
msgid "A logical value indicating the desired sort direction; FALSE to sort by row (default), TRUE to sort by column."
msgstr "Μια λογική τιμή που υποδεικνύει την επιθυμητή κατεύθυνση ταξινόμησης. FALSE για ταξινόμηση κατά σειρά (προεπιλογή), TRUE για ταξινόμηση κατά στήλη."

#. UEqVF
#: sc/inc/scfuncs.hrc:4283
msgctxt "ocSORTBY"
msgid "Sorts the contents of a range or array based on the values in a corresponding range or array."
msgstr "Ταξινομεί τα περιεχόμενα μιας περιοχής ή πίνακα με βάση τις τιμές σε μια αντίστοιχη περιοχή ή πίνακα."

#. Htvdm
#: sc/inc/scfuncs.hrc:4284
msgctxt "ocSORTBY"
msgid "Sort range"
msgstr "Εύρος ταξινόμησης"

#. EWvvS
#: sc/inc/scfuncs.hrc:4285
msgctxt "ocSORTBY"
msgid "The array or range to sort."
msgstr "Ο πίνακας ή το εύρος προς ταξινόμηση."

#. yh5AE
#: sc/inc/scfuncs.hrc:4286
msgctxt "ocSORTBY"
msgid "Sort by range "
msgstr "Ταξινόμηση κατά εύρος "

#. g2AAw
#: sc/inc/scfuncs.hrc:4287
msgctxt "ocSORTBY"
msgid "Range 1, range 2,... are the arrays or ranges to sort on."
msgstr "Το εύρος 1, το εύρος 2,... είναι οι πίνακες ή τα εύρη προς ταξινόμηση."

#. Hxhru
#: sc/inc/scfuncs.hrc:4288
msgctxt "ocSORTBY"
msgid "Sort order "
msgstr "Σειρά ταξινόμησης "

#. qWxek
#: sc/inc/scfuncs.hrc:4289
msgctxt "ocSORTBY"
msgid "Order 1, order 2,... are the orders to use for sorting. 1 for ascending, -1 for descending. Default is ascending."
msgstr "Σειρά 1, σειρά 2,... είναι οι σειρές που χρησιμοποιούνται για ταξινόμηση. 1 για αύξουσα, -1 για φθίνουσα. Η προεπιλογή είναι αύξουσα."

#. Js6Dj
#: sc/inc/scfuncs.hrc:4295
msgctxt "ocMAT_SEQUENCE"
msgid "Generates a list of sequential numbers in an array, such as 1, 2, 3, 4."
msgstr "Δημιουργεί έναν κατάλογο με διαδοχικούς αριθμούς σε έναν πίνακα, όπως 1, 2, 3, 4."

#. QBMEL
#: sc/inc/scfuncs.hrc:4296
msgctxt "ocMAT_SEQUENCE"
msgid "Rows"
msgstr "Σειρές"

#. QJTBL
#: sc/inc/scfuncs.hrc:4297
msgctxt "ocMAT_SEQUENCE"
msgid "The number of rows to return."
msgstr "Ο αριθμός των σειρών προς επιστροφή."

#. GEC8c
#: sc/inc/scfuncs.hrc:4298
msgctxt "ocMAT_SEQUENCE"
msgid "Columns"
msgstr "Στήλες"

#. fhnFH
#: sc/inc/scfuncs.hrc:4299
msgctxt "ocMAT_SEQUENCE"
msgid "The number of columns to return."
msgstr "Ο αριθμός των στηλών προς επιστροφή."

#. kWPVy
#: sc/inc/scfuncs.hrc:4300
msgctxt "ocMAT_SEQUENCE"
msgid "Start"
msgstr "Έναρξη"

#. dCwre
#: sc/inc/scfuncs.hrc:4301
msgctxt "ocMAT_SEQUENCE"
msgid "The first number in the sequence."
msgstr "Ο πρώτος αριθμός της σειράς."

#. Vuu2D
#: sc/inc/scfuncs.hrc:4302
msgctxt "ocMAT_SEQUENCE"
msgid "Step"
msgstr "Βήμα"

#. usMFD
#: sc/inc/scfuncs.hrc:4303
msgctxt "ocMAT_SEQUENCE"
msgid "The amount to increment each subsequent value in the array."
msgstr "Το ποσό που πρέπει να αυξηθεί κάθε επόμενη τιμή στον πίνακα."

#. LbVEK
#: sc/inc/scfuncs.hrc:4309
msgctxt "ocRANDARRAY"
msgid "Generates an array of random numbers between two limit values."
msgstr "Δημιουργεί έναν πίνακα τυχαίων αριθμών μεταξύ δύο οριακών τιμών."

#. FkAEX
#: sc/inc/scfuncs.hrc:4310
msgctxt "ocRANDARRAY"
msgid "Rows"
msgstr "Σειρές"

#. MAEDm
#: sc/inc/scfuncs.hrc:4311
msgctxt "ocRANDARRAY"
msgid "The number of rows to return."
msgstr "Ο αριθμός των σειρών προς επιστροφή."

#. KEjFn
#: sc/inc/scfuncs.hrc:4312
msgctxt "ocRANDARRAY"
msgid "Columns"
msgstr "Στήλες"

#. Bf74v
#: sc/inc/scfuncs.hrc:4313
msgctxt "ocRANDARRAY"
msgid "The number of columns to return."
msgstr "Ο αριθμός των στηλών προς επιστροφή."

#. sH4qD
#: sc/inc/scfuncs.hrc:4314
msgctxt "ocRANDARRAY"
msgid "Min"
msgstr "Ελάχιστο"

#. gEAsz
#: sc/inc/scfuncs.hrc:4315
msgctxt "ocRANDARRAY"
msgid "The lower limit of the generated numbers."
msgstr "Το κατώτερο όριο των παραγόμενων αριθμών."

#. zBinA
#: sc/inc/scfuncs.hrc:4316
msgctxt "ocRANDARRAY"
msgid "Max"
msgstr "Μέγιστο"

#. kSq6A
#: sc/inc/scfuncs.hrc:4317
msgctxt "ocRANDARRAY"
msgid "The upper limit of the generated numbers."
msgstr "Το ανώτερο όριο των παραγόμενων αριθμών."

#. 3E6Xi
#: sc/inc/scfuncs.hrc:4318
msgctxt "ocRANDARRAY"
msgid "Integers"
msgstr "Ακέραιοι"

#. RM5HL
#: sc/inc/scfuncs.hrc:4319
msgctxt "ocRANDARRAY"
msgid "Return integer (TRUE) or decimal (FALSE) values."
msgstr "Επιστροφή ακέραιων (TRUE) ή δεκαδικών (FALSE) τιμών."

#. 6xiFb
#: sc/inc/scfuncs.hrc:4325
msgctxt "ocCHOOSECOLS"
msgid "Returns the specified columns from an array."
msgstr "Επιστρέφει τις καθορισμένες στήλες από έναν πίνακα."

#. vDNp8
#: sc/inc/scfuncs.hrc:4326
msgctxt "ocCHOOSECOLS"
msgid "Array"
msgstr "Πίνακας"

#. R3koe
#: sc/inc/scfuncs.hrc:4327
msgctxt "ocCHOOSECOLS"
msgid "The array containing the columns to be returned in the new array."
msgstr "Ο πίνακας που περιέχει τις στήλες που θα επιστραφούν στον νέο πίνακα."

#. kZPeA
#: sc/inc/scfuncs.hrc:4328
msgctxt "ocCHOOSECOLS"
msgid "Column "
msgstr "Στήλη "

#. cwS8A
#: sc/inc/scfuncs.hrc:4329
msgctxt "ocCHOOSECOLS"
msgid "Column 1, Column 2,... The list of column numbers to be returned."
msgstr "Στήλη 1, Στήλη 2,... Ο κατάλογος με τους αριθμούς των στηλών που θα επιστραφούν."

#. sGgbA
#: sc/inc/scfuncs.hrc:4335
msgctxt "ocCHOOSEROWS"
msgid "Returns the specified rows from an array."
msgstr "Επιστρέφει τις καθορισμένες σειρές από έναν πίνακα."

#. HkSKg
#: sc/inc/scfuncs.hrc:4336
msgctxt "ocCHOOSEROWS"
msgid "Array"
msgstr "Πίνακας"

#. AL6gZ
#: sc/inc/scfuncs.hrc:4337
msgctxt "ocCHOOSEROWS"
msgid "The array containing the rows to be returned in the new array."
msgstr "Ο πίνακας που περιέχει τις σειρές που θα επιστραφούν στον νέο πίνακα."

#. eMwdB
#: sc/inc/scfuncs.hrc:4338
msgctxt "ocCHOOSEROWS"
msgid "Row "
msgstr "Σειρά "

#. z9XmC
#: sc/inc/scfuncs.hrc:4339
msgctxt "ocCHOOSEROWS"
msgid "Row 1, Row 2,... The list of row numbers to be returned."
msgstr "Σειρά 1, Σειρά 2,... ο κατάλογος με τους αριθμούς των σειρών που θα επιστραφούν."

#. 6uAUo
#: sc/inc/scfuncs.hrc:4345
msgctxt "ocDROP"
msgid "Excludes a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Εξαιρεί έναν καθορισμένο αριθμό συνεχόμενων σειρών ή στηλών από την αρχή ή το τέλος ενός πίνακα."

#. qqDwt
#: sc/inc/scfuncs.hrc:4346
msgctxt "ocDROP"
msgid "Array"
msgstr "Πίνακας"

#. 6hEEw
#: sc/inc/scfuncs.hrc:4347
msgctxt "ocDROP"
msgid "The array from which to drop rows or columns."
msgstr "Ο πίνακας από τον οποίο θα απορριφθοιύν γραμμές ή στήλες."

#. CCEFR
#: sc/inc/scfuncs.hrc:4348
msgctxt "ocDROP"
msgid "Rows"
msgstr "Γραμμές"

#. 6afd9
#: sc/inc/scfuncs.hrc:4349
msgctxt "ocDROP"
msgid "The number of rows to drop. A negative value drops from the end of the array."
msgstr "Ο αριθμός των σειρών προς απόρριψη. Μια αρνητική τιμή απορρίπτεται από το τέλος του πίνακα."

#. 4NBh4
#: sc/inc/scfuncs.hrc:4350
msgctxt "ocDROP"
msgid "Columns"
msgstr "Στήλες"

#. Smjhs
#: sc/inc/scfuncs.hrc:4351
msgctxt "ocDROP"
msgid "The number of columns to drop. A negative value drops from the end of the array."
msgstr "Ο αριθμός των στηλών προς απόρριψη. Μια αρνητική τιμή απορρίπτεται από το τέλος του πίνακα."

#. bLqBs
#: sc/inc/scfuncs.hrc:4357
msgctxt "ocEXPAND"
msgid "Expands or pads an array to specified row and column dimensions."
msgstr "Επεκτείνει ή συμπληρώνει έναν πίνακα σε καθορισμένες διαστάσεις σειρών και στηλών."

#. nQF65
#: sc/inc/scfuncs.hrc:4358
msgctxt "ocEXPAND"
msgid "Array"
msgstr "Πίνακας"

#. GZwDK
#: sc/inc/scfuncs.hrc:4359
msgctxt "ocEXPAND"
msgid "The array to expand."
msgstr "Ο πίνακας προς επέκταση."

#. YiNrW
#: sc/inc/scfuncs.hrc:4360
msgctxt "ocEXPAND"
msgid "Rows"
msgstr "Σειρές"

#. xkjNy
#: sc/inc/scfuncs.hrc:4361
msgctxt "ocEXPAND"
msgid "The number of rows in the expanded array. If missing, rows will not be expanded."
msgstr "Ο αριθμός των σειρών στον αναπτυγμένο πίνακα. Εάν λείπει, οι σειρές δεν θα επεκταθούν."

#. DjLn4
#: sc/inc/scfuncs.hrc:4362
msgctxt "ocEXPAND"
msgid "Columns"
msgstr "Στήλες"

#. EFJZX
#: sc/inc/scfuncs.hrc:4363
msgctxt "ocEXPAND"
msgid "The number of columns in the expanded array. If missing, columns will not be expanded."
msgstr "Ο αριθμός των στηλών στον αναπτυγμένο πίνακα. Εάν λείπει, οι στήλες δεν θα επεκταθούν."

#. hBDD6
#: sc/inc/scfuncs.hrc:4364
msgctxt "ocEXPAND"
msgid "Pad with"
msgstr "Συμπλήρωση με"

#. kTicG
#: sc/inc/scfuncs.hrc:4365
msgctxt "ocEXPAND"
msgid "The value with which to pad. The default is #N/A."
msgstr "Η τιμή με την οποία θα συμπληρωθεί. Η προεπιλογή είναι #N/A."

#. VuRi8
#: sc/inc/scfuncs.hrc:4371
msgctxt "ocHSTACK"
msgid "Appends arrays horizontally to create a larger array."
msgstr "Προσθέτει πίνακες οριζόντια για να δημιουργήσει έναν μεγαλύτερο πίνακα."

#. NBBGw
#: sc/inc/scfuncs.hrc:4372 sc/inc/scfuncs.hrc:4374
msgctxt "ocHSTACK"
msgid "Array"
msgstr "Πίνακας"

#. nM6qp
#: sc/inc/scfuncs.hrc:4373
msgctxt "ocHSTACK"
msgid "The first array to append."
msgstr "Ο πρώτος πίνακας για προσθήκη."

#. atWUi
#: sc/inc/scfuncs.hrc:4375
msgctxt "ocHSTACK"
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer rows, #N/A error will be returned in the additional rows."
msgstr "Πίνακας 1, Πίνακας 2,... Οι παρακάτω πίνακες προς προσθήκη. Εάν ένας πίνακας έχει λιγότερες σειρές, το σφάλμα #N/A θα επιστραφεί στις πρόσθετες σειρές."

#. TzKoX
#: sc/inc/scfuncs.hrc:4381
msgctxt "ocVSTACK"
msgid "Appends arrays vertically to create a larger array."
msgstr "Προσθέτει πίνακες κάθετα για να δημιουργήσει έναν μεγαλύτερο πίνακα."

#. xBs6J
#: sc/inc/scfuncs.hrc:4382 sc/inc/scfuncs.hrc:4384
msgctxt "ocVSTACK"
msgid "Array"
msgstr "Πίνακας"

#. oLuqo
#: sc/inc/scfuncs.hrc:4383
msgctxt "ocVSTACK"
msgid "The first array to append."
msgstr "Ο πρώτος πίνακας για προσθήκη."

#. 8A7Me
#: sc/inc/scfuncs.hrc:4385
msgctxt "ocVSTACK"
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer columns, #N/A error will be returned in the additional columns."
msgstr "Πίνακας 1, Πίνακας 2,... Οι παρακάτω πίνακες προς προσθήκη. Εάν ένας πίνακας έχει λιγότερες στήλες, το σφάλμα #N/A θα επιστραφεί στις πρόσθετες στήλες."

#. wiwq5
#: sc/inc/scfuncs.hrc:4391
msgctxt "ocTAKE"
msgid "Returns a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Επιστρέφει έναν καθορισμένο αριθμό συνεχόμενων γραμμών ή στηλών από την αρχή ή το τέλος ενός πίνακα."

#. rvJFs
#: sc/inc/scfuncs.hrc:4392
msgctxt "ocTAKE"
msgid "Array"
msgstr "Πίνακας"

#. tBVU7
#: sc/inc/scfuncs.hrc:4393
msgctxt "ocTAKE"
msgid "The array from which to take rows or columns."
msgstr "Ο πίνακας από τον οποίο λαμβάνονται γραμμές ή στήλες."

#. A6Jw7
#: sc/inc/scfuncs.hrc:4394
msgctxt "ocTAKE"
msgid "Rows"
msgstr "Γραμμές"

#. VP2FG
#: sc/inc/scfuncs.hrc:4395
msgctxt "ocTAKE"
msgid "The number of rows to take. A negative value takes from the end of the array."
msgstr "Ο αριθμός των γραμμών που πρέπει να ληφθούν. Μια αρνητική τιμή παίρνει από το τέλος του πίνακα."

#. Bw54q
#: sc/inc/scfuncs.hrc:4396
msgctxt "ocTAKE"
msgid "Columns"
msgstr "Στήλες"

#. fGjJX
#: sc/inc/scfuncs.hrc:4397
msgctxt "ocTAKE"
msgid "The number of columns to take. A negative value takes from the end of the array."
msgstr "Ο αριθμός των στηλών που πρέπει να ληφθούν. Μια αρνητική τιμή παίρνει από το τέλος του πίνακα."

#. okoEs
#: sc/inc/scfuncs.hrc:4403
msgctxt "ocTEXTAFTER"
msgid "Returns the text that occurs after a given substring or delimiter."
msgstr "Επιστρέφει το κείμενο που εμφανίζεται μετά από μια δεδομένη υποσυμβολοσειρά ή οριοθέτη."

#. FiLe9
#: sc/inc/scfuncs.hrc:4404
msgctxt "ocTEXTAFTER"
msgid "Text"
msgstr "Κείμενο"

#. f5aTy
#: sc/inc/scfuncs.hrc:4405
msgctxt "ocTEXTAFTER"
msgid "The original text."
msgstr "Το αρχικό κείμενο."

#. UNUCB
#: sc/inc/scfuncs.hrc:4406
msgctxt "ocTEXTAFTER"
msgid "Delimiter"
msgstr "Διαχωριστικό"

#. wtkpC
#: sc/inc/scfuncs.hrc:4407
msgctxt "ocTEXTAFTER"
msgid "The delimiter. Multiple delimiters can be supplied."
msgstr "Το διαχωριστικό. Μπορούν να παρασχεθούν πολλαπλά διαχωριστικά."

#. BD2BC
#: sc/inc/scfuncs.hrc:4408
msgctxt "ocTEXTAFTER"
msgid "Instance Number"
msgstr "Αριθμός παρουσίας"

#. hE87s
#: sc/inc/scfuncs.hrc:4409
msgctxt "ocTEXTAFTER"
msgid "The instance of the delimiter after which to extract text. The default is 1. A negative number starts searching from the end."
msgstr "Η παρουσία του διαχωριστικού μετά την οποία θα εξαχθεί κείμενο. Η προεπιλογή είναι 1. Ένας αρνητικός αριθμός ξεκινά την αναζήτηση από το τέλος."

#. GYN4y
#: sc/inc/scfuncs.hrc:4410
msgctxt "ocTEXTAFTER"
msgid "Match Mode"
msgstr "Λειτουργία αντιστοίχισης"

#. pnDDX
#: sc/inc/scfuncs.hrc:4411
msgctxt "ocTEXTAFTER"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Ορίστε την τιμή σε 1 για να εκτελέσετε αντιστοίχιση χωρίς διάκριση πεζών-κεφαλαίων. Η προεπιλογή είναι 0."

#. GG27C
#: sc/inc/scfuncs.hrc:4412
msgctxt "ocTEXTAFTER"
msgid "Match End"
msgstr "Τέλος αντιστοίχισης"

#. 6NMda
#: sc/inc/scfuncs.hrc:4413
msgctxt "ocTEXTAFTER"
msgid "Set to 1 to treat the end of text as a delimiter. The default is 0."
msgstr "Ορίστε την τιμή σε 1 για να θεωρήσετε το τέλος του κειμένου ως διαχωριστικό. Η προεπιλογή είναι 0."

#. xxAE2
#: sc/inc/scfuncs.hrc:4414
msgctxt "ocTEXTAFTER"
msgid "If Not Found"
msgstr "Εάν δεν βρεθεί"

#. yCXFo
#: sc/inc/scfuncs.hrc:4415
msgctxt "ocTEXTAFTER"
msgid "The value returned if no match is found. The default is #N/A."
msgstr "Η τιμή που επιστρέφεται εάν δεν βρεθεί αντιστοιχία. Η προεπιλογή είναι #Δ/Υ."

#. e3CgH
#: sc/inc/scfuncs.hrc:4421
msgctxt "ocTEXTBEFORE"
msgid "Returns the text that occurs before a given substring or delimiter."
msgstr "Επιστρέφει το κείμενο που εμφανίζεται πριν από μια δεδομένη υποσυμβολοσειρά ή διαχωριστικό."

#. fCEkH
#: sc/inc/scfuncs.hrc:4422
msgctxt "ocTEXTBEFORE"
msgid "Text"
msgstr "Κείμενο"

#. 7rRBe
#: sc/inc/scfuncs.hrc:4423
msgctxt "ocTEXTBEFORE"
msgid "The original text."
msgstr "Το αρχικό κείμενο."

#. pD2BF
#: sc/inc/scfuncs.hrc:4424
msgctxt "ocTEXTBEFORE"
msgid "Delimiter"
msgstr "Διαχωριστικό"

#. atLy4
#: sc/inc/scfuncs.hrc:4425
msgctxt "ocTEXTBEFORE"
msgid "The delimiter. Multiple delimiters can be supplied."
msgstr "Το διαχωριστικό. Μπορούν να παρασχεθούν πολλαπλά διαχωριστικά."

#. a8AQn
#: sc/inc/scfuncs.hrc:4426
msgctxt "ocTEXTBEFORE"
msgid "Instance Number"
msgstr "Αριθμός παρουσίας"

#. LKDm8
#: sc/inc/scfuncs.hrc:4427
msgctxt "ocTEXTBEFORE"
msgid "The instance of the delimiter before which to extract text. The default is 1. A negative number starts searching from the end."
msgstr "Η παρουσία του διαχωριστικού πριν από τον οποίο θα εξαχθεί κείμενο. Η προεπιλογή είναι 1. Ένας αρνητικός αριθμός ξεκινά την αναζήτηση από το τέλος."

#. zpBYX
#: sc/inc/scfuncs.hrc:4428
msgctxt "ocTEXTBEFORE"
msgid "Match Mode"
msgstr "Λειτουργία αντιστοίχισης"

#. oDYnK
#: sc/inc/scfuncs.hrc:4429
msgctxt "ocTEXTBEFORE"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Ορίστε την τιμή σε 1 για να εκτελέσετε αντιστοίχιση χωρίς διάκριση πεζών-κεφαλαίων. Η προεπιλογή είναι 0."

#. 3KUNG
#: sc/inc/scfuncs.hrc:4430
msgctxt "ocTEXTBEFORE"
msgid "Match End"
msgstr "Τέλος αντιστοίχισης"

#. VutiR
#: sc/inc/scfuncs.hrc:4431
msgctxt "ocTEXTBEFORE"
msgid "Set to 1 to treat the end of text as a delimiter. The default is 0."
msgstr "Ορίστε την τιμή σε 1 για να θεωρήσετε το τέλος του κειμένου ως διαχωριστικό. Η προεπιλογή είναι 0."

#. zBdc8
#: sc/inc/scfuncs.hrc:4432
msgctxt "ocTEXTBEFORE"
msgid "If Not Found"
msgstr "Εάν δεν βρεθεί"

#. Vo5kF
#: sc/inc/scfuncs.hrc:4433
msgctxt "ocTEXTBEFORE"
msgid "The value returned if no match is found. The default is #N/A."
msgstr "Η τιμή που επιστρέφεται εάν δεν βρεθεί αντιστοιχία. Η προεπιλογή είναι #Δ/Υ."

#. uy7ox
#: sc/inc/scfuncs.hrc:4439
msgctxt "ocTEXTSPLIT"
msgid "Splits text by a given delimiter to an array of multiple cells."
msgstr "Διαχωρίζει το κείμενο με βάση έναν δεδομένο διαχωριστικό σε έναν πίνακα πολλαπλών κελιών."

#. qHpXB
#: sc/inc/scfuncs.hrc:4440
msgctxt "ocTEXTSPLIT"
msgid "Text"
msgstr "Κείμενο"

#. 5HCeW
#: sc/inc/scfuncs.hrc:4441
msgctxt "ocTEXTSPLIT"
msgid "The text to split."
msgstr "Το κείμενο που θα διαιρεθεί."

#. iijbx
#: sc/inc/scfuncs.hrc:4442
msgctxt "ocTEXTSPLIT"
msgid "Column Delimiter"
msgstr "Οριοθέτης στηλών"

#. mtWBs
#: sc/inc/scfuncs.hrc:4443
msgctxt "ocTEXTSPLIT"
msgid "The text to delimit the columns. Multiple delimiters can be supplied."
msgstr "Το κείμενο που θα οριοθετήσει τις στήλες. Μπορούν να παρασχεθούν πολλαπλοί οριοθέτες."

#. RyAtV
#: sc/inc/scfuncs.hrc:4444
msgctxt "ocTEXTSPLIT"
msgid "Row Delimiter"
msgstr "Οριοθέτης γραμμών"

#. 9CxYK
#: sc/inc/scfuncs.hrc:4445
msgctxt "ocTEXTSPLIT"
msgid "The text to delimit the rows. Multiple delimiters can be supplied."
msgstr "Το κείμενο που θα οριοθετήσει τις γραμμές. Μπορούν να παρασχεθούν πολλαπλοί οριοθέτες."

#. CuHLJ
#: sc/inc/scfuncs.hrc:4446
msgctxt "ocTEXTSPLIT"
msgid "Ignore Empty"
msgstr "Αγνόηση κενού"

#. Qrkvd
#: sc/inc/scfuncs.hrc:4447
msgctxt "ocTEXTSPLIT"
msgid "Set to TRUE to ignore consecutive delimiters otherwise it creates an empty cell. The default is FALSE."
msgstr "Ορίστε την τιμή σε TRUE για να αγνοήσετε τους διαδοχικούς οριοθέτες, διαφορετικά δημιουργείται ένα κενό κελί. Η προεπιλογή είναι FALSE."

#. AUSmr
#: sc/inc/scfuncs.hrc:4448
msgctxt "ocTEXTSPLIT"
msgid "Match mode"
msgstr "Λειτουργία αντιστοίχισης"

#. pjYxd
#: sc/inc/scfuncs.hrc:4449
msgctxt "ocTEXTSPLIT"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Ορίστε την τιμή σε 1 για να εκτελέσετε αντιστοίχιση χωρίς διάκριση πεζών-κεφαλαίων. Η προεπιλογή είναι 0."

#. LsoKk
#: sc/inc/scfuncs.hrc:4450
msgctxt "ocTEXTSPLIT"
msgid "Pad with"
msgstr "Συμπλήρωση με"

#. niX3W
#: sc/inc/scfuncs.hrc:4451
msgctxt "ocTEXTSPLIT"
msgid "The value with which to pad. The default is #N/A."
msgstr "Η τιμή με την οποία θα γίνει συμπλήρωση. Η προεπιλογή είναι #Δ/Υ."

#. dv6gP
#: sc/inc/scfuncs.hrc:4457
msgctxt "ocTOCOL"
msgid "Transforms an array into a single column."
msgstr "Μετατρέπει έναν πίνακα σε μία στήλη."

#. A9zBS
#: sc/inc/scfuncs.hrc:4458
msgctxt "ocTOCOL"
msgid "Array"
msgstr "Πίνακας"

#. x95Ef
#: sc/inc/scfuncs.hrc:4459
msgctxt "ocTOCOL"
msgid "The range or array to return as a single column."
msgstr "Το εύρος ή ο πίνακας που θα επιστρέψει ως μία στήλη."

#. weBya
#: sc/inc/scfuncs.hrc:4460
msgctxt "ocTOCOL"
msgid "Ignore"
msgstr "Αγνόηση"

#. 5JhDs
#: sc/inc/scfuncs.hrc:4461
msgctxt "ocTOCOL"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Εάν θα αγνοηθούν ορισμένοι τύποι τιμών. 0 ή παράλειψη - διατήρηση όλων των τιμών (προεπιλογή). 1 - αγνόηση των κενών κελιών. 2 - αγνόηση των κελιών με σφάλμα. 3 - αγνόηση των κενών κελιών και των κελιών με σφάλμα."

#. DDm6x
#: sc/inc/scfuncs.hrc:4462
msgctxt "ocTOCOL"
msgid "Scan by column"
msgstr "Σάρωση ανά στήλη"

#. LwBTC
#: sc/inc/scfuncs.hrc:4463
msgctxt "ocTOCOL"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "Σάρωση του πίνακα ανά στήλη. FALSE ή παράλειψη (προεπιλογή) - ο πίνακας σαρώνεται ανά σειρά. TRUE - ο πίνακας σαρώνεται ανά στήλη."

#. 89qUq
#: sc/inc/scfuncs.hrc:4469
msgctxt "ocTOROW"
msgid "transforms an array into a single row."
msgstr "μετατρέπει έναν πίνακα σε μία απλή γραμμή."

#. GAbkQ
#: sc/inc/scfuncs.hrc:4470
msgctxt "ocTOROW"
msgid "Array"
msgstr "Πίνακας"

#. w7WXB
#: sc/inc/scfuncs.hrc:4471
msgctxt "ocTOROW"
msgid "The range or array to return as a single row."
msgstr "Το εύρος ή ο πίνακας που θα επιστρέψει ως μία γραμμή."

#. GCfA2
#: sc/inc/scfuncs.hrc:4472
msgctxt "ocTOROW"
msgid "Ignore"
msgstr "Αγνόηση"

#. AnEDD
#: sc/inc/scfuncs.hrc:4473
msgctxt "ocTOROW"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Εάν θα αγνοηθούν ορισμένοι τύποι τιμών. 0 ή παράλειψη - διατήρηση όλων των τιμών (προεπιλογή). 1 - αγνόηση των κενών κελιών. 2 - αγνόηση των κελιών με σφάλμα. 3 - αγνόηση των κενών κελιών και των κελιών με σφάλμα."

#. pDD7V
#: sc/inc/scfuncs.hrc:4474
msgctxt "ocTOROW"
msgid "Scan by column"
msgstr "Σάρωση ανά στήλη"

#. qxY7a
#: sc/inc/scfuncs.hrc:4475
msgctxt "ocTOROW"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "Σάρωση του πίνακα ανά στήλη. FALSE ή παράλειψη (προεπιλογή) - ο πίνακας σαρώνεται ανά σειρά. TRUE - ο πίνακας σαρώνεται ανά στήλη."

#. 8p5AW
#: sc/inc/scfuncs.hrc:4481
msgctxt "ocUNIQUE"
msgid "Returns a list of unique values from a range or array."
msgstr "Επιστρέφει έναν κατάλογο με μοναδικές τιμές από μια περιοχή ή πίνακα."

#. LAeWQ
#: sc/inc/scfuncs.hrc:4482
msgctxt "ocUNIQUE"
msgid "Array"
msgstr "Πίνακας"

#. LHrXJ
#: sc/inc/scfuncs.hrc:4483
msgctxt "ocUNIQUE"
msgid "The range or array from which to return unique values."
msgstr "Το εύρος ή ο πίνακας από τον οποίο επιστρέφονται οι μοναδικές τιμές."

#. TBfHR
#: sc/inc/scfuncs.hrc:4484
msgctxt "ocUNIQUE"
msgid "By col"
msgstr "Κατά στήλη"

#. xiVEn
#: sc/inc/scfuncs.hrc:4485
msgctxt "ocUNIQUE"
msgid "Logical value indicating how to compare data: TRUE - compares data across columns. FALSE or omitted (default) - compares data across rows."
msgstr "Λογική τιμή που υποδεικνύει τον τρόπο σύγκρισης δεδομένων: TRUE - συγκρίνει δεδομένα μεταξύ των στηλών. FALSE ή παράλειψη (προεπιλογή) - συγκρίνει δεδομένα μεταξύ των σειρών."

#. GLsJf
#: sc/inc/scfuncs.hrc:4486
msgctxt "ocUNIQUE"
msgid "Uniqueness"
msgstr "Μοναδικότητα"

#. ubRgX
#: sc/inc/scfuncs.hrc:4487
msgctxt "ocUNIQUE"
msgid "Logical value that defines what values are considered unique: TRUE - returns values that occur only once. FALSE or omitted (default) - returns all distinct (different) values in the range or array."
msgstr "Λογική τιμή που καθορίζει ποιες τιμές θεωρούνται μοναδικές: TRUE - επιστρέφει τιμές που εμφανίζονται μόνο μία φορά. FALSE ή παράλειψη (προεπιλογή) - επιστρέφει όλες τις διακριτές (διαφορετικές) τιμές στην περιοχή ή τον πίνακα."

#. 5Aaqr
#: sc/inc/scfuncs.hrc:4493
msgctxt "ocLET"
msgid "The LET function assigns names to calculation results. This allows storing intermediate calculations, values, or defining names inside a formula. These names only apply within the scope of the LET function."
msgstr "Η συνάρτηση LET εκχωρεί ονόματα στα αποτελέσματα των υπολογισμών. Αυτό επιτρέπει την αποθήκευση ενδιάμεσων υπολογισμών, τιμών ή ορισμού ονομάτων μέσα σε έναν τύπο. Αυτά τα ονόματα ισχύουν μόνο εντός του πεδίου εφαρμογής της συνάρτησης LET."

#. GTBCS
#: sc/inc/scfuncs.hrc:4494
msgctxt "ocLET"
msgid "Name 1"
msgstr "Όνομα 1"

#. BXEhz
#: sc/inc/scfuncs.hrc:4495
msgctxt "ocLET"
msgid "The first name to assign. Must start with a letter. Cannot be the output of a formula or conflict with range syntax."
msgstr "Το πρώτο όνομα προς ανάθεση. Πρέπει να ξεκινά με ένα γράμμα. Δεν μπορεί να είναι έξοδος τύπου ή διένεξη με σύνταξη εύρους."

#. agD98
#: sc/inc/scfuncs.hrc:4496
msgctxt "ocLET"
msgid "Name value "
msgstr "Τιμή ονόματος "

#. CjEiH
#: sc/inc/scfuncs.hrc:4497
msgctxt "ocLET"
msgid "Name value 1, Name value 2,... The value or calculation to assign to Name."
msgstr "Τιμή ονόματος 1, τιμή ονόματος 2,... Η τιμή ή ο υπολογισμός που θα εκχωρηθεί στο Όνομα."

#. GCAQK
#: sc/inc/scfuncs.hrc:4498
msgctxt "ocLET"
msgid "Calculation or Name "
msgstr "Υπολογισμός ή Όνομα "

#. uzEFm
#: sc/inc/scfuncs.hrc:4499
msgctxt "ocLET"
msgid "A calculation that uses all names within the LET function. This must be the last argument in the LET function. Or a second Name to assign to a second Name value. If a second Name is specified, Name value 2 and Calculation or Name 3 become required."

#: sc/inc/scfuncs.hrc:3455
msgctxt "ocX_LOOKUP"
msgid "The array or range to search."
msgstr "Ο πίνακας ή το εύρος για αναζήτηση."

#. hkB5Z
#: sc/inc/scfuncs.hrc:3456
msgctxt "ocX_LOOKUP"
msgid "Result Array"
msgstr "Πίνακας αποτελεσμάτων"

#. fAPwy
#: sc/inc/scfuncs.hrc:3457

#: sc/inc/scfuncs.hrc:4460
msgctxt "ocTOCOL"
msgid "Ignore"
msgstr "Ignorar"

#. 5JhDs
#: sc/inc/scfuncs.hrc:4461
msgctxt "ocTOCOL"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Se ignorar determinados tipos de valores. = ou omitido - manter todos os valores (predeterminado). 1 - ignorar celas baleiras. 2 - ignorar celas con erros. 3 - ignorar celas baleiras e celas con erros."


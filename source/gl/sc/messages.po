msgid "The text to be found."
msgstr "Texto que hai que atopar."

#. uREXw
#: sc/inc/scfuncs.hrc:4216
msgctxt "ocSEARCHB"
msgid "Text"
msgstr "Texto"

#. FdNfZ
#: sc/inc/scfuncs.hrc:4217
msgctxt "ocSEARCHB"
msgid "The text in which a search is to be made."
msgstr "Texto en que hai que buscar."

#. gEBkG
#: sc/inc/scfuncs.hrc:4218
msgctxt "ocSEARCHB"
msgid "Position"
msgstr "Posición"

#. YGeMx
#: sc/inc/scfuncs.hrc:4219
msgctxt "ocSEARCHB"
msgid "The position in the text from which the search starts."
msgstr "Posición no texto a partir da cal comezará a busca."

#. VPfDS
#: sc/inc/scfuncs.hrc:4225
msgctxt "ocFOURIER"
msgid "Computes the Discrete Fourier Transform (DFT) of an array"
msgstr "Calcula a Transformada discreta de Fourier (DFT) dunha matriz"

#. SV2Tq
#: sc/inc/scfuncs.hrc:4226
msgctxt "ocFOURIER"
msgid "Array"
msgstr "Matriz"

#. K9YnP
#: sc/inc/scfuncs.hrc:4227
msgctxt "ocFOURIER"
msgid "The array whose DFT needs to be computed. The dimensions of this array can be Nx1 or Nx2 or 1xN or 2xN."
msgstr "A matriz da que hai que calcular a DFT. As dimensións desta matriz poden ser Nx1 ou Nx2 ou 1xN ou 2xN."

#. RL4zG
#: sc/inc/scfuncs.hrc:4228
msgctxt "ocFOURIER"
msgid "GroupedByColumns"
msgstr "AgrupadoPorColumnas"

#. jJ5f8
#: sc/inc/scfuncs.hrc:4229
msgctxt "ocFOURIER"
msgid "Flag to indicate whether the array is grouped by columns or not (default TRUE)."
msgstr "Marca para indicar se a matriz está agrupada por columnas ou non (por omisión, VERDADEIRO)."

#. KqWyU
#: sc/inc/scfuncs.hrc:4230
msgctxt "ocFOURIER"
msgid "Inverse"
msgstr ""

#. RJc49
#: sc/inc/scfuncs.hrc:4231
msgctxt "ocFOURIER"
msgid "Flag to indicate whether an inverse DFT is to be computed (default FALSE)."
msgstr "Marca para indicar se hai que calcular unha DFT inversa (por omisión, FALSO)."

#. UKq8b
#: sc/inc/scfuncs.hrc:4232
msgctxt "ocFOURIER"
msgid "Polar"
msgstr "Polar"

#. 2Fzbq
#: sc/inc/scfuncs.hrc:4233
msgctxt "ocFOURIER"
msgid "Flag to indicate whether to return the results in polar form (default FALSE)."
msgstr "Marca para indicar se hai que devolver os resultados en forma polar (por omisión, FALSO)."

#. 6A3GQ
#: sc/inc/scfuncs.hrc:4234
msgctxt "ocFOURIER"
msgid "MinimumMagnitude"
msgstr "MagnitudeMínima"

#. WFDbz
#: sc/inc/scfuncs.hrc:4235
msgctxt "ocFOURIER"
msgid "In case of Polar=TRUE, the frequency components below this magnitude are clipped out (default 0.0)."
msgstr "No caso de Polar=VERDADEIRO, recórtanse os compoñentes de frecuencia por debaixo desta magnitude (por omisión, 0,0)."

#. SDqjG
#: sc/inc/scfuncs.hrc:4241
msgctxt "ocRANDOM_NV"
msgid "Returns a random number between 0 and 1, non-volatile."
msgstr "Devolve un número aleatorio non volátil entre 0 e 1."

#. zUzWN
#: sc/inc/scfuncs.hrc:4247
msgctxt "ocRANDBETWEEN_NV"
msgid "Returns a random integer between the specified Bottom and Top values (both inclusive), non-volatile."
msgstr "Devolve un enteiro aleatorio entre os valores superior e inferior indicados (ambos incluídos), non volátil."

#. XRTEX
#: sc/inc/scfuncs.hrc:4248
msgctxt "ocRANDBETWEEN_NV"
msgid "Bottom"
msgstr ""

#. Vipt3
#: sc/inc/scfuncs.hrc:4249
msgctxt "ocRANDBETWEEN_NV"
msgid "The smallest integer that can be returned."
msgstr "O enteiro máis pequeno que poda ser devolto."

#. TXWYA
#: sc/inc/scfuncs.hrc:4250
msgctxt "ocRANDBETWEEN_NV"
msgid "Top"
msgstr ""

#. A6fAC
#: sc/inc/scfuncs.hrc:4251
msgctxt "ocRANDBETWEEN_NV"
msgid "The largest integer that can be returned."
msgstr "O enteiro máis grande que poida ser devolto."

#. TVBBo
#: sc/inc/scfuncs.hrc:4257
msgctxt "ocFILTER"
msgid "Filters an array based on a Boolean (True/False) array."
msgstr "Filtra unha matriz con base nunha matriz booleana (verdadeiro/falso)."

#. d65Ge
#: sc/inc/scfuncs.hrc:4258
msgctxt "ocFILTER"
msgid "Range"
msgstr "Intervalo"

#. RMEDy
#: sc/inc/scfuncs.hrc:4259
msgctxt "ocFILTER"
msgid "The array, or range to filter."
msgstr "A matriz ou intervalo que filtrar."

#. DaokM
#: sc/inc/scfuncs.hrc:4260
msgctxt "ocFILTER"
msgid "Include"
msgstr ""

#. AEy68
#: sc/inc/scfuncs.hrc:4261
msgctxt "ocFILTER"
msgid "A Boolean array whose height or width is the same as the array."
msgstr "Unha matriz booleana cuxa altura ou largura é a mesma que a matriz."

#. hGyPL
#: sc/inc/scfuncs.hrc:4262
msgctxt "ocFILTER"
msgid "Result if empty"
msgstr "Resultado se baleiro"

#. Ka6BT
#: sc/inc/scfuncs.hrc:4263
msgctxt "ocFILTER"
msgid "The value to return if all values in the included array are empty (filter returns nothing)."
msgstr "O valor para devolver se todos os valores da matriz incluída están baleiros (o filtro non devolve nada)."

#. nxhBg
#: sc/inc/scfuncs.hrc:4269
msgctxt "ocSORT"
msgid "Sorts the contents of a range or array."
msgstr "Ordena o contido dun intervalo ou matriz."

#. HKENV
#: sc/inc/scfuncs.hrc:4270
msgctxt "ocSORT"
msgid "Range"
msgstr "Intervalo"

#. vgj8a
#: sc/inc/scfuncs.hrc:4271
msgctxt "ocSORT"
msgid "The range, or array to sort."
msgstr "O intervalo ou matriz para ordenar."

#. mdeDi
#: sc/inc/scfuncs.hrc:4272
msgctxt "ocSORT"
msgid "Sort index"
msgstr "Índice de ordenación"

#. DuQFW
#: sc/inc/scfuncs.hrc:4273
msgctxt "ocSORT"
msgid "A number indicating the row or column to sort by."
msgstr "Un número que indica a fila ou columna pola que ordenar."

#. BK4XX
#: sc/inc/scfuncs.hrc:4274
msgctxt "ocSORT"
msgid "Sort order"
msgstr "Criterio de ordenación"

#. zFBzs
#: sc/inc/scfuncs.hrc:4275
msgctxt "ocSORT"
msgid "A number indicating the desired sort order; 1 for ascending order (default), -1 for descending order."
msgstr "Un número que indica a ordenación desexada; 1 para orde ascendente (predeterminado), -1 para orde descendente."

#. ResTu
#: sc/inc/scfuncs.hrc:4276
msgctxt "ocSORT"
msgid "By col"
msgstr "Por columna"

#. DwWWz
#: sc/inc/scfuncs.hrc:4277
msgctxt "ocSORT"
msgid "A logical value indicating the desired sort direction; FALSE to sort by row (default), TRUE to sort by column."
msgstr "Un valor lóxico que indica a dirección de ordenación desexada; FALSO para ordenar por fila (predeterminado), VERDADEIRO para ordenar por columna."

#. UEqVF
#: sc/inc/scfuncs.hrc:4283
msgctxt "ocSORTBY"
msgid "Sorts the contents of a range or array based on the values in a corresponding range or array."
msgstr "Ordena o contido dun intervalo ou matriz con base nos valores dun intervalo ou matriz correspondentes."

#. Htvdm
#: sc/inc/scfuncs.hrc:4284
msgctxt "ocSORTBY"
msgid "Sort range"
msgstr "Intervalo de ordenación"

#. EWvvS
#: sc/inc/scfuncs.hrc:4285
msgctxt "ocSORTBY"
msgid "The array or range to sort."
msgstr "A matriz ou intervalo que hai que ordenar."

#. yh5AE
#: sc/inc/scfuncs.hrc:4286
msgctxt "ocSORTBY"
msgid "Sort by range "
msgstr "Ordenar por intyervalo "

#. g2AAw
#: sc/inc/scfuncs.hrc:4287
msgctxt "ocSORTBY"
msgid "Range 1, range 2,... are the arrays or ranges to sort on."
msgstr "Intervalo 1, invevalo 2,... son as matrices ou intervalos polos que ordenar."

#. Hxhru
#: sc/inc/scfuncs.hrc:4288
msgctxt "ocSORTBY"
msgid "Sort order "
msgstr "Criterio de ordenación "

#. qWxek
#: sc/inc/scfuncs.hrc:4289
msgctxt "ocSORTBY"
msgid "Order 1, order 2,... are the orders to use for sorting. 1 for ascending, -1 for descending. Default is ascending."
msgstr "Orde 1, orde 2,... son as ordes que se empregan para ordenar, 1 para ascendente, -1 para descendente. Por omisión é ascendente."

#. Js6Dj
#: sc/inc/scfuncs.hrc:4295
msgctxt "ocMAT_SEQUENCE"
msgid "Generates a list of sequential numbers in an array, such as 1, 2, 3, 4."
msgstr "Xera unha lista de números secuencias nunha matriz, como por exemplo 1, 2, 3, 4."

#. QBMEL
#: sc/inc/scfuncs.hrc:4296
msgctxt "ocMAT_SEQUENCE"
msgid "Rows"
msgstr "Filas"

#. QJTBL
#: sc/inc/scfuncs.hrc:4297
msgctxt "ocMAT_SEQUENCE"
msgid "The number of rows to return."
msgstr "O número de filas que devolver."

#. GEC8c
#: sc/inc/scfuncs.hrc:4298
msgctxt "ocMAT_SEQUENCE"
msgid "Columns"
msgstr "Columnas"

#. fhnFH
#: sc/inc/scfuncs.hrc:4299
msgctxt "ocMAT_SEQUENCE"
msgid "The number of columns to return."
msgstr "O número de columnas que devolver."

#. kWPVy
#: sc/inc/scfuncs.hrc:4300
msgctxt "ocMAT_SEQUENCE"
msgid "Start"
msgstr "Inicio"

#. dCwre
#: sc/inc/scfuncs.hrc:4301
msgctxt "ocMAT_SEQUENCE"
msgid "The first number in the sequence."
msgstr "O primeiro número da secuencia."

#. Vuu2D
#: sc/inc/scfuncs.hrc:4302
msgctxt "ocMAT_SEQUENCE"
msgid "Step"
msgstr "Paso"

#. usMFD
#: sc/inc/scfuncs.hrc:4303
msgctxt "ocMAT_SEQUENCE"
msgid "The amount to increment each subsequent value in the array."
msgstr "A cantidade no que se incrementa cada valor posterior da matriz."

#. LbVEK
#: sc/inc/scfuncs.hrc:4309
msgctxt "ocRANDARRAY"
msgid "Generates an array of random numbers between two limit values."
msgstr "Xera unha matriz de números aleatorios entre dous valores límite."

#. FkAEX
#: sc/inc/scfuncs.hrc:4310
msgctxt "ocRANDARRAY"
msgid "Rows"
msgstr "Filas"

#. MAEDm
#: sc/inc/scfuncs.hrc:4311
msgctxt "ocRANDARRAY"
msgid "The number of rows to return."
msgstr "O número de filas que devolver."

#. KEjFn
#: sc/inc/scfuncs.hrc:4312
msgctxt "ocRANDARRAY"
msgid "Columns"
msgstr "Columnas"

#. Bf74v
#: sc/inc/scfuncs.hrc:4313
msgctxt "ocRANDARRAY"
msgid "The number of columns to return."
msgstr "O número de columnas que devolver."

#. sH4qD
#: sc/inc/scfuncs.hrc:4314
msgctxt "ocRANDARRAY"
msgid "Min"
msgstr "Mín."

#. gEAsz
#: sc/inc/scfuncs.hrc:4315
msgctxt "ocRANDARRAY"
msgid "The lower limit of the generated numbers."
msgstr "O límite inferior dos números xerados."

#. zBinA
#: sc/inc/scfuncs.hrc:4316
msgctxt "ocRANDARRAY"
msgid "Max"
msgstr "Máx."

#. kSq6A
#: sc/inc/scfuncs.hrc:4317
msgctxt "ocRANDARRAY"
msgid "The upper limit of the generated numbers."
msgstr "O límite superior dos números xerados."

#. 3E6Xi
#: sc/inc/scfuncs.hrc:4318
msgctxt "ocRANDARRAY"
msgid "Integers"
msgstr "Enteiros"

#. RM5HL
#: sc/inc/scfuncs.hrc:4319
msgctxt "ocRANDARRAY"
msgid "Return integer (TRUE) or decimal (FALSE) values."
msgstr "Devolver valores enteiros (VERDADEIRO) ou decimais (FALSO)."

#. 6xiFb
#: sc/inc/scfuncs.hrc:4325
msgctxt "ocCHOOSECOLS"
msgid "Returns the specified columns from an array."
msgstr "Devolve as columnas indicadas dunha matriz."

#. vDNp8
#: sc/inc/scfuncs.hrc:4326
msgctxt "ocCHOOSECOLS"
msgid "Array"
msgstr "Matriz"

#. R3koe
#: sc/inc/scfuncs.hrc:4327
msgctxt "ocCHOOSECOLS"
msgid "The array containing the columns to be returned in the new array."
msgstr "A matriz que contén as columnas que se queren na nova matriz."

#. kZPeA
#: sc/inc/scfuncs.hrc:4328
msgctxt "ocCHOOSECOLS"
msgid "Column "
msgstr "Columna "

#. cwS8A
#: sc/inc/scfuncs.hrc:4329
msgctxt "ocCHOOSECOLS"
msgid "Column 1, Column 2,... The list of column numbers to be returned."
msgstr "Columna 1, Columna 2,... a lista de números de columna que hai que devolver."

#. sGgbA
#: sc/inc/scfuncs.hrc:4335
msgctxt "ocCHOOSEROWS"
msgid "Returns the specified rows from an array."
msgstr "Devolve as filas indicadas dunha matriz."

#. HkSKg
#: sc/inc/scfuncs.hrc:4336
msgctxt "ocCHOOSEROWS"
msgid "Array"
msgstr "Matriz"

#. AL6gZ
#: sc/inc/scfuncs.hrc:4337
msgctxt "ocCHOOSEROWS"
msgid "The array containing the rows to be returned in the new array."
msgstr "A matriz que contén as filas que se queren na nova matriz."

#. eMwdB
#: sc/inc/scfuncs.hrc:4338
msgctxt "ocCHOOSEROWS"
msgid "Row "
msgstr "Fila "

#. z9XmC
#: sc/inc/scfuncs.hrc:4339
msgctxt "ocCHOOSEROWS"
msgid "Row 1, Row 2,... The list of row numbers to be returned."
msgstr "Fila 1, Fila 2,... A lista de números de fila que hai que devolver."

#. 6uAUo
#: sc/inc/scfuncs.hrc:4345
msgctxt "ocDROP"
msgid "Excludes a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Exclúe un número determinado de filas ou columnas contiguos do comezo ou do final da matriz."

#. qqDwt
#: sc/inc/scfuncs.hrc:4346
msgctxt "ocDROP"
msgid "Array"
msgstr "Matriz"

#. 6hEEw
#: sc/inc/scfuncs.hrc:4347
msgctxt "ocDROP"
msgid "The array from which to drop rows or columns."
msgstr "A matriz da que retirar filas ou columnas."

#. CCEFR
#: sc/inc/scfuncs.hrc:4348
msgctxt "ocDROP"
msgid "Rows"
msgstr "Filas"

#. 6afd9
#: sc/inc/scfuncs.hrc:4349
msgctxt "ocDROP"
msgid "The number of rows to drop. A negative value drops from the end of the array."
msgstr "O número de filas que hai que retirar. Un valor negativo retira desde o final da matriz."

#. 4NBh4
#: sc/inc/scfuncs.hrc:4350
msgctxt "ocDROP"
msgid "Columns"
msgstr "Columnas"

#. Smjhs
#: sc/inc/scfuncs.hrc:4351
msgctxt "ocDROP"
msgid "The number of columns to drop. A negative value drops from the end of the array."
msgstr "O número de columnas que hai que retirar. Un valor negativo retira desde o final da matriz."

#. bLqBs
#: sc/inc/scfuncs.hrc:4357
msgctxt "ocEXPAND"
msgid "Expands or pads an array to specified row and column dimensions."
msgstr "Expande ou completa unha matriz até as dimensións de filas e columnas indicadas."

#. nQF65
#: sc/inc/scfuncs.hrc:4358
msgctxt "ocEXPAND"
msgid "Array"
msgstr "Matriz"

#. GZwDK
#: sc/inc/scfuncs.hrc:4359
msgctxt "ocEXPAND"
msgid "The array to expand."
msgstr "A matriz que hai que expandir."

#. YiNrW
#: sc/inc/scfuncs.hrc:4360
msgctxt "ocEXPAND"
msgid "Rows"
msgstr "Filas"

#. xkjNy
#: sc/inc/scfuncs.hrc:4361
msgctxt "ocEXPAND"
msgid "The number of rows in the expanded array. If missing, rows will not be expanded."
msgstr "O número de filas da matriz expandida. Se falta, non se expanden as filas."

#. DjLn4
#: sc/inc/scfuncs.hrc:4362
msgctxt "ocEXPAND"
msgid "Columns"
msgstr "Columnas"

#. EFJZX
#: sc/inc/scfuncs.hrc:4363
msgctxt "ocEXPAND"
msgid "The number of columns in the expanded array. If missing, columns will not be expanded."
msgstr "O número de columnas da matriz expandida. Se faltan, non se expanden as columnas."

#. hBDD6
#: sc/inc/scfuncs.hrc:4364
msgctxt "ocEXPAND"
msgid "Pad with"
msgstr "Encher con"

#. kTicG
#: sc/inc/scfuncs.hrc:4365
msgctxt "ocEXPAND"
msgid "The value with which to pad. The default is #N/A."
msgstr "O valor co que encher. Por omisión é #N/DISP."

#. VuRi8
#: sc/inc/scfuncs.hrc:4371
msgctxt "ocHSTACK"
msgid "Appends arrays horizontally to create a larger array."
msgstr "Amence matrices horizontalmente para crear unha matriz maior."

#. NBBGw
#: sc/inc/scfuncs.hrc:4372 sc/inc/scfuncs.hrc:4374
msgctxt "ocHSTACK"
msgid "Array"
msgstr "Matriz"

#. nM6qp
#: sc/inc/scfuncs.hrc:4373
msgctxt "ocHSTACK"
msgid "The first array to append."
msgstr "A primeira matriz que hai que amecer."

#. atWUi
#: sc/inc/scfuncs.hrc:4375
msgctxt "ocHSTACK"
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer rows, #N/A error will be returned in the additional rows."
msgstr "Matriz 1, Matriz 2,... As matrices seguintes que hai que amecer. Se unha matriz ten menos filas devólvese o erro #N/DISP nas filas adicionais."

#. TzKoX
#: sc/inc/scfuncs.hrc:4381
msgctxt "ocVSTACK"
msgid "Appends arrays vertically to create a larger array."
msgstr "Amece matrices verticalmente para crear unha matriz maior."

#. xBs6J
#: sc/inc/scfuncs.hrc:4382 sc/inc/scfuncs.hrc:4384
msgctxt "ocVSTACK"
msgid "Array"
msgstr "Matriz"

#. oLuqo
#: sc/inc/scfuncs.hrc:4383
msgctxt "ocVSTACK"
msgid "The first array to append."
msgstr "A primeira matriz que hai que amecer."

#. 8A7Me
#: sc/inc/scfuncs.hrc:4385
msgctxt "ocVSTACK"
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer columns, #N/A error will be returned in the additional columns."
msgstr "Matriz 1, Matriz 2,... As matrices seguintes que hai que amecer. Se unha matriz ten menos columnas devólvese un erro #N/DISP nas columnas adicionais."

#. wiwq5
#: sc/inc/scfuncs.hrc:4391
msgctxt "ocTAKE"
msgid "Returns a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Devolve un número determinado de filas ou columnas contiguas desde o comezo ou fin dunha matriz."

#. rvJFs
#: sc/inc/scfuncs.hrc:4392
msgctxt "ocTAKE"
msgid "Array"
msgstr "Matriz"

#. tBVU7
#: sc/inc/scfuncs.hrc:4393
msgctxt "ocTAKE"
msgid "The array from which to take rows or columns."
msgstr "A matriz da que tomar filas ou columnas."

#. A6Jw7
#: sc/inc/scfuncs.hrc:4394
msgctxt "ocTAKE"
msgid "Rows"
msgstr "Filas"

#. VP2FG
#: sc/inc/scfuncs.hrc:4395
msgctxt "ocTAKE"
msgid "The number of rows to take. A negative value takes from the end of the array."
msgstr "O número de filas que hai que tomar. Un valor negativo toma desde o fin da matriz."

#. Bw54q
#: sc/inc/scfuncs.hrc:4396
msgctxt "ocTAKE"
msgid "Columns"
msgstr "Columnas"

#. fGjJX
#: sc/inc/scfuncs.hrc:4397
msgctxt "ocTAKE"
msgid "The number of columns to take. A negative value takes from the end of the array."
msgstr "O número de columnas que hai que tomar. Un valor negativo toma desde o fin da matriz."

#. okoEs
#: sc/inc/scfuncs.hrc:4403
msgctxt "ocTEXTAFTER"
msgid "Returns the text that occurs after a given substring or delimiter."
msgstr "Devolve un texto que aparece despois dunha subcadea ou delimitador dados."

#. FiLe9
#: sc/inc/scfuncs.hrc:4404
msgctxt "ocTEXTAFTER"
msgid "Text"
msgstr "Texto"

#. f5aTy
#: sc/inc/scfuncs.hrc:4405
msgctxt "ocTEXTAFTER"
msgid "The original text."
msgstr "O texto orixinal."

#. UNUCB
#: sc/inc/scfuncs.hrc:4406
msgctxt "ocTEXTAFTER"
msgid "Delimiter"
msgstr "Delimitador"

#. wtkpC
#: sc/inc/scfuncs.hrc:4407
msgctxt "ocTEXTAFTER"
msgid "The delimiter. Multiple delimiters can be supplied."
msgstr "O delimitador. Pódense indicar varios delimitadores."

#. BD2BC
#: sc/inc/scfuncs.hrc:4408
msgctxt "ocTEXTAFTER"
msgid "Instance Number"
msgstr "Número da instancia"

#. hE87s
#: sc/inc/scfuncs.hrc:4409
msgctxt "ocTEXTAFTER"
msgid "The instance of the delimiter after which to extract text. The default is 1. A negative number starts searching from the end."
msgstr "A instancia do delimitador despois da que extraer o texto. Por omisión, 1. Un número negativo comeza a busca polo final."

#. GYN4y
#: sc/inc/scfuncs.hrc:4410
msgctxt "ocTEXTAFTER"
msgid "Match Mode"
msgstr "Modo de coincidencia"

#. pnDDX
#: sc/inc/scfuncs.hrc:4411
msgctxt "ocTEXTAFTER"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Se é 1, ignóranse maiúsculas e minúsculas. Por omisión é 0."

#. GG27C
#: sc/inc/scfuncs.hrc:4412
msgctxt "ocTEXTAFTER"
msgid "Match End"
msgstr "Coincidir o final"

#. 6NMda
#: sc/inc/scfuncs.hrc:4413
msgctxt "ocTEXTAFTER"
msgid "Set to 1 to treat the end of text as a delimiter. The default is 0."
msgstr "Se é 1, trátase o final do texto como delimitador. Por omisión é 0."

#. xxAE2
#: sc/inc/scfuncs.hrc:4414
msgctxt "ocTEXTAFTER"
msgid "If Not Found"
msgstr "Se non se atopa"

#. yCXFo
#: sc/inc/scfuncs.hrc:4415
msgctxt "ocTEXTAFTER"
msgid "The value returned if no match is found. The default is #N/A."
msgstr "O valor devolto se non se atopa coincidencia. Por omisión é #N/DISP."

#. e3CgH
#: sc/inc/scfuncs.hrc:4421
msgctxt "ocTEXTBEFORE"
msgid "Returns the text that occurs before a given substring or delimiter."
msgstr "Devolve o texto que aparece antes dunha subcadea ou delimitador datos."

#. fCEkH
#: sc/inc/scfuncs.hrc:4422
msgctxt "ocTEXTBEFORE"
msgid "Text"
msgstr "Texto"

#. 7rRBe
#: sc/inc/scfuncs.hrc:4423
msgctxt "ocTEXTBEFORE"
msgid "The original text."
msgstr "O texto orixinal."

#. pD2BF
#: sc/inc/scfuncs.hrc:4424
msgctxt "ocTEXTBEFORE"
msgid "Delimiter"
msgstr "Delimitador"

#. atLy4
#: sc/inc/scfuncs.hrc:4425
msgctxt "ocTEXTBEFORE"
msgid "The delimiter. Multiple delimiters can be supplied."
msgstr "O delimitador. Pódense indicar varios delimitadores."

#. a8AQn
#: sc/inc/scfuncs.hrc:4426
msgctxt "ocTEXTBEFORE"
msgid "Instance Number"
msgstr "Número da instancia"

#. LKDm8

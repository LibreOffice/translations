#. pDD7V
#: sc/inc/scfuncs.hrc:4474
msgctxt "ocTOROW"
msgid "Scan by column"
msgstr "Examinar por columna"

#. qxY7a
#: sc/inc/scfuncs.hrc:4475
msgctxt "ocTOROW"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "Examinar a matriz por columna FALSO ou omitido (predeterminado) - a matriz examínase por columna. VERDADEIRO - a matriz examínase por columna."

#. 8p5AW
#: sc/inc/scfuncs.hrc:4481
msgctxt "ocUNIQUE"
msgid "Returns a list of unique values from a range or array."
msgstr "Devolve unha lista de valores únicos dun intervalo ou matriz."

#. LAeWQ
#: sc/inc/scfuncs.hrc:4482
msgctxt "ocUNIQUE"
msgid "Array"
msgstr "Matriz"

#. LHrXJ
#: sc/inc/scfuncs.hrc:4483
msgctxt "ocUNIQUE"
msgid "The range or array from which to return unique values."
msgstr "O intervalo ou matriz do que devolver valores únicos."

#. TBfHR
#: sc/inc/scfuncs.hrc:4484
msgctxt "ocUNIQUE"
msgid "By col"
msgstr "Por columna"

#. xiVEn
#: sc/inc/scfuncs.hrc:4485
msgctxt "ocUNIQUE"
msgid "Logical value indicating how to compare data: TRUE - compares data across columns. FALSE or omitted (default) - compares data across rows."

msgctxt "ocX_MATCH"
msgid ""
"0 - Exact match. Will return #N/A if no match. (default).\n"
"-1 - Exact match or the next smaller item.\n"
"1 - Exact match or the next larger item.\n"
"2 - Wildcard match.\n"
"3 - Regular expression match."
msgstr ""
"0: correspondencia exacta. Devolverá #N/D si no hay correspondencias (predeterminado).\n"
"-1: correspondencia exacta o el elemento sucesivo menor.\n"
"1: correspondencia exacta o el elemento sucesivo mayor.\n"
"2: correspondencia por comodín.\n"
"3: correspondencia por expresión regular."


#. 6A3GQ
#: sc/inc/scfuncs.hrc:4166
msgctxt "ocFOURIER"
msgid "MinimumMagnitude"
msgstr "MagnitudMínima"

#. WFDbz
#: sc/inc/scfuncs.hrc:4167
msgctxt "ocFOURIER"
msgid "In case of Polar=TRUE, the frequency components below this magnitude are clipped out (default 0.0)."
msgstr "Si Polar=VERDADERO, se quitan las frecuencias cuya amplitud es inferior a este valor (predet. 0,0)."

#. SDqjG
#: sc/inc/scfuncs.hrc:4173
msgctxt "ocRANDOM_NV"
msgid "Returns a random number between 0 and 1, non-volatile."
msgstr "Devuelve un número al azar no volátil, entre 0 y 1."

#. zUzWN
#: sc/inc/scfuncs.hrc:4179
msgctxt "ocRANDBETWEEN_NV"
msgid "Returns a random integer between the specified Bottom and Top values (both inclusive), non-volatile."
msgstr "Devuelve un número al azar no volátil, entre los valores inferior y superior (ambos inclusive) especificados."

#. XRTEX
#: sc/inc/scfuncs.hrc:4180
msgctxt "ocRANDBETWEEN_NV"
msgid "Bottom"
msgstr "Inferior"

#. Vipt3
#: sc/inc/scfuncs.hrc:4181
msgctxt "ocRANDBETWEEN_NV"
msgid "The smallest integer that can be returned."
msgstr "El entero más pequeño que se puede devolver."

#. TXWYA
#: sc/inc/scfuncs.hrc:4182
msgctxt "ocRANDBETWEEN_NV"
msgid "Top"
msgstr "Superior"

#. A6fAC
#: sc/inc/scfuncs.hrc:4183
msgctxt "ocRANDBETWEEN_NV"
msgid "The largest integer that can be returned."
msgstr "El entero más grande que se puede devolver."

#. TVBBo
#: sc/inc/scfuncs.hrc:4189
msgctxt "ocFILTER"
msgid "Filters an array based on a Boolean (True/False) array."
msgstr "Filtra una matriz con base en una matriz booleana (verdadero/falso)."

#. d65Ge
#: sc/inc/scfuncs.hrc:4190
msgctxt "ocFILTER"
msgid "Range"
msgstr "Intervalo"

#. RMEDy
#: sc/inc/scfuncs.hrc:4191
msgctxt "ocFILTER"
msgid "The array, or range to filter."
msgstr "La matriz o el intervalo para filtrar."

#. DaokM
#: sc/inc/scfuncs.hrc:4192
msgctxt "ocFILTER"
msgid "Include"
msgstr "Incluir"

#. AEy68
#: sc/inc/scfuncs.hrc:4193
msgctxt "ocFILTER"
msgid "A Boolean array whose height or width is the same as the array."
msgstr "Una matriz booleana cuya altura o anchura es la misma que la de la matriz."

#. hGyPL
#: sc/inc/scfuncs.hrc:4194
msgctxt "ocFILTER"
msgid "Result if empty"
msgstr "Resultado si está vacío"

#. Ka6BT
#: sc/inc/scfuncs.hrc:4195
msgctxt "ocFILTER"
msgid "The value to return if all values in the included array are empty (filter returns nothing)."
msgstr "El valor que se devolverá si todos los valores de la matriz incluida están vacíos (si el filtro no devuelve nada)."

#. nxhBg
#: sc/inc/scfuncs.hrc:4201
msgctxt "ocSORT"
msgid "Sorts the contents of a range or array."
msgstr "Ordena el contenido de un intervalo o una matriz."

#. HKENV
#: sc/inc/scfuncs.hrc:4202
msgctxt "ocSORT"
msgid "Range"
msgstr "Intervalo"

#. vgj8a
#: sc/inc/scfuncs.hrc:4203
msgctxt "ocSORT"
msgid "The range, or array to sort."
msgstr "El intervalo o la matriz que se ordenará."

#. mdeDi
#: sc/inc/scfuncs.hrc:4204
msgctxt "ocSORT"
msgid "Sort index"
msgstr "Índice de ordenación"

#. DuQFW
#: sc/inc/scfuncs.hrc:4205
msgctxt "ocSORT"
msgid "A number indicating the row or column to sort by."
msgstr "Un número que indica por qué fila o columna se debe ordenar."

#. BK4XX
#: sc/inc/scfuncs.hrc:4206
msgctxt "ocSORT"
msgid "Sort order"
msgstr "Criterio de ordenación"

#. zFBzs
#: sc/inc/scfuncs.hrc:4207
msgctxt "ocSORT"
msgid "A number indicating the desired sort order; 1 for ascending order (default), -1 for descending order."
msgstr "Un número que indica el criterio de ordenación deseado: 1 para orden ascendente (predeterminado); -1 para orden descendente."

#. ResTu
#: sc/inc/scfuncs.hrc:4208
msgctxt "ocSORT"
msgid "By col"
msgstr "Por columna"

#. DwWWz
#: sc/inc/scfuncs.hrc:4209
msgctxt "ocSORT"
msgid "A logical value indicating the desired sort direction; FALSE to sort by row (default), TRUE to sort by column."
msgstr "Un valor lógico que indica la dirección de orden deseada; FALSO para ordenar por fila (predeterminado), VERDADERO para ordenar por columna."

#. UEqVF
#: sc/inc/scfuncs.hrc:4215
msgctxt "ocSORTBY"
msgid "Sorts the contents of a range or array based on the values in a corresponding range or array."
msgstr "Ordena el contenido dentro de un intervalo o tabla, en base a los valores en otro intervalo o tabla que se le corresponda."

#. Htvdm
#: sc/inc/scfuncs.hrc:4216
msgctxt "ocSORTBY"
msgid "Sort range"
msgstr "Intervalo de ordenación"

#. EWvvS
#: sc/inc/scfuncs.hrc:4217
msgctxt "ocSORTBY"
msgid "The array or range to sort."
msgstr "La matriz o el intervalo para ordenar."

#. yh5AE
#: sc/inc/scfuncs.hrc:4218
msgctxt "ocSORTBY"
msgid "Sort by range "
msgstr "Ordenar por intervalo "

#. g2AAw
#: sc/inc/scfuncs.hrc:4219
msgctxt "ocSORTBY"
msgid "Range 1, range 2,... are the arrays or ranges to sort on."
msgstr "Intervalo 1, intervalo 2… son matrices o intervalos por los que ordenar."

#. Hxhru
#: sc/inc/scfuncs.hrc:4220
msgctxt "ocSORTBY"
msgid "Sort order "
msgstr "Criterio de ordenación "

#. qWxek
#: sc/inc/scfuncs.hrc:4221
msgctxt "ocSORTBY"
msgid "Order 1, order 2,... are the orders to use for sorting. 1 for ascending, -1 for descending. Default is ascending."
msgstr "Orden 1, orden 2… son los órdenes que se usarán para clasificar. 1 para ascendente, -1 para descendente. El valor predeterminado es ascendente."

#. Js6Dj
#: sc/inc/scfuncs.hrc:4227
msgctxt "ocMAT_SEQUENCE"
msgid "Generates a list of sequential numbers in an array, such as 1, 2, 3, 4."
msgstr "Genera una lista de números secuenciales en una matriz, como por ejemplo 1, 2, 3, 4."

#. QBMEL
#: sc/inc/scfuncs.hrc:4228
msgctxt "ocMAT_SEQUENCE"
msgid "Rows"
msgstr "Filas"

#. QJTBL
#: sc/inc/scfuncs.hrc:4229
msgctxt "ocMAT_SEQUENCE"
msgid "The number of rows to return."
msgstr "El número de filas para devolver."

#. GEC8c
#: sc/inc/scfuncs.hrc:4230
msgctxt "ocMAT_SEQUENCE"
msgid "Columns"
msgstr "Columnas"

#. fhnFH
#: sc/inc/scfuncs.hrc:4231
msgctxt "ocMAT_SEQUENCE"
msgid "The number of columns to return."
msgstr "El número de columnas para devolver."

#. kWPVy
#: sc/inc/scfuncs.hrc:4232
msgctxt "ocMAT_SEQUENCE"
msgid "Start"
msgstr "Inicio"

#. dCwre
#: sc/inc/scfuncs.hrc:4233
msgctxt "ocMAT_SEQUENCE"
msgid "The first number in the sequence."
msgstr "El primer número de la secuencia."

#. Vuu2D
#: sc/inc/scfuncs.hrc:4234
msgctxt "ocMAT_SEQUENCE"
msgid "Step"
msgstr "Paso"

#. usMFD
#: sc/inc/scfuncs.hrc:4235
msgctxt "ocMAT_SEQUENCE"
msgid "The amount to increment each subsequent value in the array."
msgstr "En una matriz, la cantidad que se incrementará entre cada valor sucesivo."

#. LbVEK
#: sc/inc/scfuncs.hrc:4241
msgctxt "ocRANDARRAY"
msgid "Generates an array of random numbers between two limit values."
msgstr "Genera una matriz de números aleatorios entre dos valores límite."

#. FkAEX
#: sc/inc/scfuncs.hrc:4242
msgctxt "ocRANDARRAY"
msgid "Rows"
msgstr "Filas"

#. MAEDm
#: sc/inc/scfuncs.hrc:4243
msgctxt "ocRANDARRAY"
msgid "The number of rows to return."
msgstr "El número de filas para devolver."

#. KEjFn
#: sc/inc/scfuncs.hrc:4244
msgctxt "ocRANDARRAY"
msgid "Columns"
msgstr "Columnas"

#. Bf74v
#: sc/inc/scfuncs.hrc:4245
msgctxt "ocRANDARRAY"
msgid "The number of columns to return."
msgstr "El número de columnas para devolver."

#. sH4qD
#: sc/inc/scfuncs.hrc:4246
msgctxt "ocRANDARRAY"
msgid "Min"
msgstr "Mínimo"

#. gEAsz
#: sc/inc/scfuncs.hrc:4247
msgctxt "ocRANDARRAY"
msgid "The lower limit of the generated numbers."
msgstr "El límite inferior de los números generados."

#. zBinA
#: sc/inc/scfuncs.hrc:4248
msgctxt "ocRANDARRAY"
msgid "Max"
msgstr "Máximo"

#. kSq6A
#: sc/inc/scfuncs.hrc:4249
msgctxt "ocRANDARRAY"
msgid "The upper limit of the generated numbers."
msgstr "El límite superior de los números generados."


msgstr "El intervalo que adaptar"

#. B64X3
#: sc/inc/scfuncs.hrc:4452
msgctxt "ocWRAPROWS"
msgid "Wrap count"
msgstr "Número de adaptaciones"

#. uGwSk
#: sc/inc/scfuncs.hrc:4453

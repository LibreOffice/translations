msgctxt "ocCHOOSEROWS"
msgid "Array"
msgstr "Matriz"

#. AL6gZ
#: sc/inc/scfuncs.hrc:4269
msgctxt "ocCHOOSEROWS"
msgid "The array containing the rows to be returned in the new array."
msgstr "La matriz que contiene las filas que se devolverán en la matriz nueva."

#. eMwdB
#: sc/inc/scfuncs.hrc:4270
msgctxt "ocCHOOSEROWS"
msgid "Row "
msgstr "Fila "

#. z9XmC
#: sc/inc/scfuncs.hrc:4271
msgctxt "ocCHOOSEROWS"
msgid "Row 1, Row 2,... The list of row numbers to be returned."
msgstr "Fila 1, fila 2… La lista de números de fila que se devolverá."

#. 6uAUo
#: sc/inc/scfuncs.hrc:4277
msgctxt "ocDROP"
msgid "Excludes a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Excluye un número específico de filas o columnas contiguas del principio o del final de una matriz."

#. qqDwt
#: sc/inc/scfuncs.hrc:4278
msgctxt "ocDROP"
msgid "Array"
msgstr "Matriz"

#. 6hEEw
#: sc/inc/scfuncs.hrc:4279
msgctxt "ocDROP"
msgid "The array from which to drop rows or columns."
msgstr "La matriz de la que se van a eliminar filas o columnas."

#. CCEFR
#: sc/inc/scfuncs.hrc:4280
msgctxt "ocDROP"
msgid "Rows"
msgstr "Filas"

#. 6afd9
#: sc/inc/scfuncs.hrc:4281
msgctxt "ocDROP"
msgid "The number of rows to drop. A negative value drops from the end of the array."
msgstr "El número de filas que se eliminarán. Un valor negativo las elimina desde el final de la matriz."

#. 4NBh4
#: sc/inc/scfuncs.hrc:4282
msgctxt "ocDROP"
msgid "Columns"
msgstr "Columnas"

#. Smjhs
#: sc/inc/scfuncs.hrc:4283
msgctxt "ocDROP"
msgid "The number of columns to drop. A negative value drops from the end of the array."
msgstr "El número de columnas que se eliminarán. Un valor negativo las elimina desde el final de la matriz."

#. bLqBs

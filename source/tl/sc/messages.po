msgctxt "ocTAKE"
msgid "Array"
msgstr "Array"

#. tBVU7
#: sc/inc/scfuncs.hrc:4393
msgctxt "ocTAKE"
msgid "The array from which to take rows or columns."
msgstr "Ang array kung saan kukuha ng mga row o column."

#. A6Jw7
#: sc/inc/scfuncs.hrc:4394
msgctxt "ocTAKE"
msgid "Rows"
msgstr "Mga hilera"

#. VP2FG
#: sc/inc/scfuncs.hrc:4395
msgctxt "ocTAKE"
msgid "The number of rows to take. A negative value takes from the end of the array."
msgstr "Ang bilang ng mga row na kukunin. Ang isang negatibong halaga ay tumatagal mula sa dulo ng array."

#. Bw54q
#: sc/inc/scfuncs.hrc:4396
msgctxt "ocTAKE"
msgid "Columns"
msgstr "Mga hanay"

#. fGjJX
#: sc/inc/scfuncs.hrc:4397
msgctxt "ocTAKE"
msgid "The number of columns to take. A negative value takes from the end of the array."
msgstr "Ang bilang ng mga column na kukunin. Ang isang negatibong halaga ay tumatagal mula sa dulo ng array."

#. okoEs
#: sc/inc/scfuncs.hrc:4403
msgctxt "ocTEXTAFTER"
msgid "Returns the text that occurs after a given substring or delimiter."
msgstr "Ibinabalik ang text na nangyayari pagkatapos ng isang ibinigay na substring o delimiter."


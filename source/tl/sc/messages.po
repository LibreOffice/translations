msgctxt "ocTEXTAFTER"
msgid "Text"
msgstr "Text"

#. f5aTy
#: sc/inc/scfuncs.hrc:4405
msgctxt "ocTEXTAFTER"
msgid "The original text."
msgstr "Ang orihinal na teksto."

#. UNUCB
#: sc/inc/scfuncs.hrc:4406
msgctxt "ocTEXTAFTER"
msgid "Delimiter"
msgstr "Delimiter"

#. wtkpC
#: sc/inc/scfuncs.hrc:4407
msgctxt "ocTEXTAFTER"
msgid "The delimiter. Multiple delimiters can be supplied."
msgstr "Ang delimiter. Maaaring magbigay ng maramihang mga delimiter."

#. BD2BC
#: sc/inc/scfuncs.hrc:4408
msgctxt "ocTEXTAFTER"
msgid "Instance Number"
msgstr "Numero ng Instance"

#. hE87s
#: sc/inc/scfuncs.hrc:4409
msgctxt "ocTEXTAFTER"
msgid "The instance of the delimiter after which to extract text. The default is 1. A negative number starts searching from the end."
msgstr "Ang instance ng delimiter pagkatapos ay mag-extract ng text. Ang default ay 1. Nagsisimulang maghanap ang negatibong numero mula sa dulo."

#. GYN4y
#: sc/inc/scfuncs.hrc:4410
msgctxt "ocTEXTAFTER"
msgid "Match Mode"
msgstr "Mode ng Pagtutugma"

#. pnDDX
#: sc/inc/scfuncs.hrc:4411
msgctxt "ocTEXTAFTER"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Itakda sa 1 para magsagawa ng case-insensitive na tugma. Ang default ay 0."

#. GG27C
#: sc/inc/scfuncs.hrc:4412
msgctxt "ocTEXTAFTER"
msgid "Match End"
msgstr "Match End"

#. 6NMda
#: sc/inc/scfuncs.hrc:4413
msgctxt "ocTEXTAFTER"
msgid "Set to 1 to treat the end of text as a delimiter. The default is 0."
msgstr "Itakda sa 1 para ituring ang dulo ng text bilang delimiter. Ang default ay 0."

#. xxAE2
#: sc/inc/scfuncs.hrc:4414
msgctxt "ocTEXTAFTER"
msgid "If Not Found"
msgstr "Kung Hindi Nahanap"

#. yCXFo
#: sc/inc/scfuncs.hrc:4415
msgctxt "ocTEXTAFTER"
msgid "The value returned if no match is found. The default is #N/A."
msgstr "Ibinalik ang halaga kung walang nakitang tugma. Ang default ay #N/A."

#. e3CgH
#: sc/inc/scfuncs.hrc:4421
msgctxt "ocTEXTBEFORE"
msgid "Returns the text that occurs before a given substring or delimiter."
msgstr "Ibinabalik ang text na nangyayari bago ang isang ibinigay na substring o delimiter."

#. fCEkH
#: sc/inc/scfuncs.hrc:4422
msgctxt "ocTEXTBEFORE"
msgid "Text"
msgstr "Text"

#. 7rRBe
#: sc/inc/scfuncs.hrc:4423
msgctxt "ocTEXTBEFORE"
msgid "The original text."
msgstr "Ang orihinal na teksto."

#. pD2BF
#: sc/inc/scfuncs.hrc:4424
msgctxt "ocTEXTBEFORE"
msgid "Delimiter"
msgstr "Delimiter"

#. atLy4
#: sc/inc/scfuncs.hrc:4425
msgctxt "ocTEXTBEFORE"
msgid "The delimiter. Multiple delimiters can be supplied."
msgstr "Ang delimiter. Maaaring magbigay ng maramihang mga delimiter."

#. a8AQn
#: sc/inc/scfuncs.hrc:4426
msgctxt "ocTEXTBEFORE"
msgid "Instance Number"
msgstr "Numero ng Instance"

#. LKDm8
#: sc/inc/scfuncs.hrc:4427
msgctxt "ocTEXTBEFORE"
msgid "The instance of the delimiter before which to extract text. The default is 1. A negative number starts searching from the end."
msgstr "Ang instance ng delimiter bago kung saan i-extract ang text. Ang default ay 1. Nagsisimulang maghanap ang negatibong numero mula sa dulo."

#. zpBYX
#: sc/inc/scfuncs.hrc:4428
msgctxt "ocTEXTBEFORE"
msgid "Match Mode"
msgstr "Mode ng Pagtutugma"

#. oDYnK
#: sc/inc/scfuncs.hrc:4429
msgctxt "ocTEXTBEFORE"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Itakda sa 1 para magsagawa ng case-insensitive na tugma. Ang default ay 0."

#. 3KUNG
#: sc/inc/scfuncs.hrc:4430
msgctxt "ocTEXTBEFORE"
msgid "Match End"
msgstr "Match End"

#. VutiR
#: sc/inc/scfuncs.hrc:4431
msgctxt "ocTEXTBEFORE"
msgid "Set to 1 to treat the end of text as a delimiter. The default is 0."
msgstr "Itakda sa 1 para ituring ang dulo ng text bilang delimiter. Ang default ay 0."

#. zBdc8
#: sc/inc/scfuncs.hrc:4432
msgctxt "ocTEXTBEFORE"
msgid "If Not Found"
msgstr "Kung Hindi Nahanap"

#. Vo5kF
#: sc/inc/scfuncs.hrc:4433
msgctxt "ocTEXTBEFORE"
msgid "The value returned if no match is found. The default is #N/A."
msgstr "Ibinalik ang halaga kung walang nakitang tugma. Ang default ay #N/A."

#. uy7ox
#: sc/inc/scfuncs.hrc:4439
msgctxt "ocTEXTSPLIT"
msgid "Splits text by a given delimiter to an array of multiple cells."
msgstr "Hinahati ang teksto sa pamamagitan ng isang ibinigay na delimiter sa isang hanay ng maraming mga cell."

#. qHpXB
#: sc/inc/scfuncs.hrc:4440
msgctxt "ocTEXTSPLIT"
msgid "Text"
msgstr "Text"

#. 5HCeW
#: sc/inc/scfuncs.hrc:4441
msgctxt "ocTEXTSPLIT"
msgid "The text to split."
msgstr "Ang text para hatiin."

#. iijbx
#: sc/inc/scfuncs.hrc:4442
msgctxt "ocTEXTSPLIT"
msgid "Column Delimiter"
msgstr "Delimiter ng Hanay"

#. mtWBs
#: sc/inc/scfuncs.hrc:4443
msgctxt "ocTEXTSPLIT"
msgid "The text to delimit the columns. Multiple delimiters can be supplied."
msgstr "Ang text na maglilimita sa mga column. Maaaring magbigay ng maramihang mga delimiter."

#. RyAtV
#: sc/inc/scfuncs.hrc:4444
msgctxt "ocTEXTSPLIT"
msgid "Row Delimiter"
msgstr "Hilera Delimiter"

#. 9CxYK
#: sc/inc/scfuncs.hrc:4445
msgctxt "ocTEXTSPLIT"
msgid "The text to delimit the rows. Multiple delimiters can be supplied."
msgstr "Ang teksto upang limitahan ang mga hilera. Maaaring magbigay ng maramihang mga delimiter."

#. CuHLJ
#: sc/inc/scfuncs.hrc:4446
msgctxt "ocTEXTSPLIT"
msgid "Ignore Empty"
msgstr "Huwag pansinin ang Empty"

#. Qrkvd
#: sc/inc/scfuncs.hrc:4447
msgctxt "ocTEXTSPLIT"
msgid "Set to TRUE to ignore consecutive delimiters otherwise it creates an empty cell. The default is FALSE."
msgstr "Itakda sa TRUE para balewalain ang magkakasunod na delimiter kung hindi ay gagawa ito ng walang laman na cell. Ang default ay FALSE."

#. AUSmr
#: sc/inc/scfuncs.hrc:4448
msgctxt "ocTEXTSPLIT"
msgid "Match mode"
msgstr "Match mode"

#. pjYxd
#: sc/inc/scfuncs.hrc:4449
msgctxt "ocTEXTSPLIT"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Itakda sa 1 para magsagawa ng case-insensitive na tugma. Ang default ay 0."

#. LsoKk
#: sc/inc/scfuncs.hrc:4450
msgctxt "ocTEXTSPLIT"
msgid "Pad with"
msgstr "Pad na may"

#. niX3W
#: sc/inc/scfuncs.hrc:4451
msgctxt "ocTEXTSPLIT"
msgid "The value with which to pad. The default is #N/A."
msgstr "Ang halaga kung saan i-pad. Ang default ay #N/A."

#. dv6gP
#: sc/inc/scfuncs.hrc:4457
msgctxt "ocTOCOL"
msgid "Transforms an array into a single column."
msgstr "Binabago ang isang array sa isang solong column."

#. A9zBS
#: sc/inc/scfuncs.hrc:4458
msgctxt "ocTOCOL"
msgid "Array"
msgstr "Array"

#. x95Ef
#: sc/inc/scfuncs.hrc:4459
msgctxt "ocTOCOL"
msgid "The range or array to return as a single column."
msgstr "Ang hanay o array na ibabalik bilang isang column."

#. weBya
#: sc/inc/scfuncs.hrc:4460
msgctxt "ocTOCOL"
msgid "Ignore"
msgstr "Huwag pansinin"

#. 5JhDs
#: sc/inc/scfuncs.hrc:4461
msgctxt "ocTOCOL"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Kung babalewalain ang ilang uri ng mga halaga. 0 o tinanggal - panatilihin ang lahat ng mga halaga (default). 1 - huwag pansinin ang mga blangkong cell. 2 - huwag pansinin ang mga cell na may error. 3 - huwag pansinin ang mga blangko na mga cell at mga cell na may error."

#. DDm6x
#: sc/inc/scfuncs.hrc:4462
msgctxt "ocTOCOL"
msgid "Scan by column"
msgstr "I-scan ayon sa column"

#. LwBTC
#: sc/inc/scfuncs.hrc:4463
msgctxt "ocTOCOL"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "I-scan ang array ayon sa column. FALSE o tinanggal (default) - ang array ay ini-scan ayon sa row. TRUE - ang array ay ini-scan ayon sa column."

#. 89qUq
#: sc/inc/scfuncs.hrc:4469
msgctxt "ocTOROW"
msgid "transforms an array into a single row."
msgstr "binabago ang isang array sa isang solong hilera."

#. GAbkQ
#: sc/inc/scfuncs.hrc:4470
msgctxt "ocTOROW"
msgid "Array"
msgstr "Array"

#. w7WXB
#: sc/inc/scfuncs.hrc:4471
msgctxt "ocTOROW"
msgid "The range or array to return as a single row."
msgstr "Ang hanay o array na ibabalik bilang isang row."

#. GCfA2
#: sc/inc/scfuncs.hrc:4472
msgctxt "ocTOROW"
msgid "Ignore"
msgstr "Huwag pansinin"

#. AnEDD
#: sc/inc/scfuncs.hrc:4473
msgctxt "ocTOROW"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Kung babalewalain ang ilang uri ng mga halaga. 0 o tinanggal - panatilihin ang lahat ng mga halaga (default). 1 - huwag pansinin ang mga blangkong cell. 2 - huwag pansinin ang mga cell na may error. 3 - huwag pansinin ang mga blangko na mga cell at mga cell na may error."

#. pDD7V
#: sc/inc/scfuncs.hrc:4474
msgctxt "ocTOROW"
msgid "Scan by column"
msgstr "I-scan ayon sa column"

#. qxY7a
#: sc/inc/scfuncs.hrc:4475
msgctxt "ocTOROW"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "I-scan ang array ayon sa column. FALSE o tinanggal (default) - ang array ay ini-scan ayon sa row. TRUE - ang array ay ini-scan ayon sa column."

#. 8p5AW
#: sc/inc/scfuncs.hrc:4481
msgctxt "ocUNIQUE"
msgid "Returns a list of unique values from a range or array."
msgstr "Nagbabalik ng listahan ng mga natatanging value mula sa isang range o array."

#. LAeWQ
#: sc/inc/scfuncs.hrc:4482
msgctxt "ocUNIQUE"
msgid "Array"
msgstr "Array"

#. LHrXJ
#: sc/inc/scfuncs.hrc:4483
msgctxt "ocUNIQUE"
msgid "The range or array from which to return unique values."
msgstr "Ang range o array kung saan ibabalik ang mga natatanging value."

#. TBfHR
#: sc/inc/scfuncs.hrc:4484
msgctxt "ocUNIQUE"
msgid "By col"
msgstr "Sa pamamagitan ng col"

#. xiVEn
#: sc/inc/scfuncs.hrc:4485
msgctxt "ocUNIQUE"
msgid "Logical value indicating how to compare data: TRUE - compares data across columns. FALSE or omitted (default) - compares data across rows."
msgstr "Lohikal na halaga na nagsasaad kung paano ihambing ang data: TRUE - naghahambing ng data sa mga column. FALSE o inalis (default) - naghahambing ng data sa mga row."

#. GLsJf
#: sc/inc/scfuncs.hrc:4486
msgctxt "ocUNIQUE"
msgid "Uniqueness"
msgstr "Kakaiba"

#. ubRgX
#: sc/inc/scfuncs.hrc:4487
msgctxt "ocUNIQUE"
msgid "Logical value that defines what values are considered unique: TRUE - returns values that occur only once. FALSE or omitted (default) - returns all distinct (different) values in the range or array."
msgstr "Lohikal na halaga na tumutukoy kung anong mga halaga ang itinuturing na natatangi: TRUE - nagbabalik ng mga halaga na nangyayari nang isang beses lamang. FALSE o inalis (default) - ibinabalik ang lahat ng natatanging (iba't ibang) value sa range o array."

#. 5Aaqr
#: sc/inc/scfuncs.hrc:4493
msgctxt "ocLET"
msgid "The LET function assigns names to calculation results. This allows storing intermediate calculations, values, or defining names inside a formula. These names only apply within the scope of the LET function."
msgstr "Ang LET function ay nagtatalaga ng mga pangalan sa mga resulta ng pagkalkula. Nagbibigay-daan ito sa pag-imbak ng mga intermediate na kalkulasyon, mga halaga, o pagtukoy ng mga pangalan sa loob ng isang formula. Nalalapat lang ang mga pangalang ito sa saklaw ng LET function."

#. GTBCS
#: sc/inc/scfuncs.hrc:4494
msgctxt "ocLET"
msgid "Name 1"
msgstr "Pangalan 1"

#. BXEhz
#: sc/inc/scfuncs.hrc:4495
msgctxt "ocLET"
msgid "The first name to assign. Must start with a letter. Cannot be the output of a formula or conflict with range syntax."
msgstr "Ang unang pangalan na itatalaga. Dapat magsimula sa isang liham. Hindi maaaring maging output ng isang formula o sumasalungat sa syntax ng hanay."

#. agD98
#: sc/inc/scfuncs.hrc:4496
msgctxt "ocLET"
msgid "Name value "
msgstr "Halaga ng pangalan "

#. CjEiH
#: sc/inc/scfuncs.hrc:4497
msgctxt "ocLET"
msgid "Name value 1, Name value 2,... The value or calculation to assign to Name."
msgstr "Pangalan ng halaga 1, Pangalan ng halaga 2,... Ang halaga o pagkalkula na itatalaga sa Pangalan."

#. GCAQK
#: sc/inc/scfuncs.hrc:4498
msgctxt "ocLET"
msgid "Calculation or Name "
msgstr "Pagkalkula o Pangalan "

#. uzEFm
#: sc/inc/scfuncs.hrc:4499
msgctxt "ocLET"
msgid "A calculation that uses all names within the LET function. This must be the last argument in the LET function. Or a second Name to assign to a second Name value. If a second Name is specified, Name value 2 and Calculation or Name 3 become required."
msgstr "Isang kalkulasyon na gumagamit ng lahat ng pangalan sa loob ng LET function. Ito dapat ang huling argumento sa LET function. O pangalawang Pangalan na itatalaga sa pangalawang Pangalan na halaga. Kung tinukoy ang pangalawang Pangalan, ang halaga ng Pangalan 2 at Pagkalkula o Pangalan 3 ay kinakailangan."

#. HbPvG
#: sc/inc/scfuncs.hrc:4505
msgctxt "ocWRAPCOLS"
msgid "Wraps the provided row or column of values by columns after a specified number of elements to form a new array."
msgstr "Bina-wrap ang ibinigay na row o column ng mga value ayon sa mga column pagkatapos ng tinukoy na bilang ng mga elemento upang bumuo ng bagong array."

#. ACoFA
#: sc/inc/scfuncs.hrc:4506
msgctxt "ocWRAPCOLS"
msgid "Range"
msgstr "Saklaw"

#. h3vyV
#: sc/inc/scfuncs.hrc:4507
msgctxt "ocWRAPCOLS"
msgid "the range to wrap."
msgstr "ang hanay upang ibalot."

#. nCGAe
#: sc/inc/scfuncs.hrc:4508
msgctxt "ocWRAPCOLS"
msgid "Wrap count"
msgstr "Bilang ng balot"

#. su9gg
#: sc/inc/scfuncs.hrc:4509
msgctxt "ocWRAPCOLS"
msgid "The maximum number of values for each column."
msgstr "Ang maximum na bilang ng mga value para sa bawat column."

#. sCG9H
#: sc/inc/scfuncs.hrc:4510
msgctxt "ocWRAPCOLS"
msgid "Pad with"
msgstr "Pad na may"

#. FnA6D
#: sc/inc/scfuncs.hrc:4511
msgctxt "ocWRAPCOLS"
msgid "The value with which to pad. The default is #N/A."
msgstr "Ang halaga kung saan i-pad. Ang default ay #N/A."

#. Bc4CS
#: sc/inc/scfuncs.hrc:4517
msgctxt "ocWRAPROWS"
msgid "Wraps the provided row or column of values by rows after a specified number of elements to form a new array."
msgstr "Bina-wrap ang ibinigay na row o column ng mga value ayon sa mga row pagkatapos ng tinukoy na bilang ng mga elemento upang bumuo ng bagong array."

#. UeAts
#: sc/inc/scfuncs.hrc:4518
msgctxt "ocWRAPROWS"
msgid "Range"
msgstr "Saklaw"

#. Fo4we

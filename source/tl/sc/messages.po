msgctxt "ocHSTACK"
msgid "Array"
msgstr "Array"

#. nM6qp
#: sc/inc/scfuncs.hrc:4373
msgctxt "ocHSTACK"
msgid "The first array to append."
msgstr "Ang unang array na idaragdag."

#. atWUi
#: sc/inc/scfuncs.hrc:4375
msgctxt "ocHSTACK"
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer rows, #N/A error will be returned in the additional rows."
msgstr "Array 1, Array 2,... Ang mga sumusunod na array ay idaragdag. Kung mas kaunting mga row ang isang array, ibabalik ang #N/A error sa mga karagdagang row."

#. TzKoX
#: sc/inc/scfuncs.hrc:4381
msgctxt "ocVSTACK"
msgid "Appends arrays vertically to create a larger array."
msgstr "Nagdaragdag ng mga array nang patayo upang lumikha ng mas malaking array."

#. xBs6J

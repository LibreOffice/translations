msgid "Array"
msgstr "Array"

#. oLuqo
#: sc/inc/scfuncs.hrc:4383
msgctxt "ocVSTACK"
msgid "The first array to append."
msgstr "Ang unang array na idaragdag."

#. 8A7Me
#: sc/inc/scfuncs.hrc:4385
msgctxt "ocVSTACK"
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer columns, #N/A error will be returned in the additional columns."
msgstr "Array 1, Array 2,... Ang mga sumusunod na array ay idaragdag. Kung mas kaunting column ang isang array, ibabalik ang #N/A error sa mga karagdagang column."

#. wiwq5
#: sc/inc/scfuncs.hrc:4391
msgctxt "ocTAKE"
msgid "Returns a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Ibinabalik ang isang tinukoy na bilang ng magkadikit na mga row o column mula sa simula o dulo ng isang array."

#. rvJFs

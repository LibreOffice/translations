msgctxt "ocEXPAND"
msgid "Pad with"
msgstr "Pad na may"

#. kTicG
#: sc/inc/scfuncs.hrc:4365
msgctxt "ocEXPAND"
msgid "The value with which to pad. The default is #N/A."
msgstr "Ang halaga kung saan i-pad. Ang default ay #N/A."

#. VuRi8
#: sc/inc/scfuncs.hrc:4371
msgctxt "ocHSTACK"
msgid "Appends arrays horizontally to create a larger array."
msgstr "Nagdaragdag ng mga array nang pahalang upang lumikha ng mas malaking array."


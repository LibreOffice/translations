msgstr "hilera "

#. z9XmC
#: sc/inc/scfuncs.hrc:4339
msgctxt "ocCHOOSEROWS"
msgid "Row 1, Row 2,... The list of row numbers to be returned."
msgstr "Row 1, Row 2,... Ang listahan ng mga row number na ibabalik."

#. 6uAUo
#: sc/inc/scfuncs.hrc:4345
msgctxt "ocDROP"
msgid "Excludes a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Ibinubukod ang isang tinukoy na bilang ng magkadikit na mga row o column mula sa simula o dulo ng isang array."

#. qqDwt
#: sc/inc/scfuncs.hrc:4346
msgctxt "ocDROP"
msgid "Array"
msgstr "Array"

#. 6hEEw
#: sc/inc/scfuncs.hrc:4347
msgctxt "ocDROP"
msgid "The array from which to drop rows or columns."
msgstr "Ang array kung saan ihuhulog ang mga row o column."

#. CCEFR
#: sc/inc/scfuncs.hrc:4348
msgctxt "ocDROP"
msgid "Rows"
msgstr "Mga hilera"

#. 6afd9
#: sc/inc/scfuncs.hrc:4349
msgctxt "ocDROP"
msgid "The number of rows to drop. A negative value drops from the end of the array."
msgstr "Ang bilang ng mga hilera na ibababa. Ang isang negatibong halaga ay bumaba mula sa dulo ng array."

#. 4NBh4
#: sc/inc/scfuncs.hrc:4350
msgctxt "ocDROP"
msgid "Columns"
msgstr "Mga hanay"

#. Smjhs
#: sc/inc/scfuncs.hrc:4351
msgctxt "ocDROP"
msgid "The number of columns to drop. A negative value drops from the end of the array."
msgstr "Ang bilang ng mga column na ibababa. Ang isang negatibong halaga ay bumaba mula sa dulo ng array."

#. bLqBs
#: sc/inc/scfuncs.hrc:4357
msgctxt "ocEXPAND"
msgid "Expands or pads an array to specified row and column dimensions."
msgstr "Pinapalawak o pinapadpad ang isang array sa tinukoy na mga dimensyon ng row at column."

#. nQF65
#: sc/inc/scfuncs.hrc:4358
msgctxt "ocEXPAND"
msgid "Array"
msgstr "Array"

#. GZwDK
#: sc/inc/scfuncs.hrc:4359
msgctxt "ocEXPAND"
msgid "The array to expand."
msgstr "Ang array na palawakin."

#. YiNrW
#: sc/inc/scfuncs.hrc:4360
msgctxt "ocEXPAND"
msgid "Rows"
msgstr "Mga hilera"

#. xkjNy
#: sc/inc/scfuncs.hrc:4361
msgctxt "ocEXPAND"
msgid "The number of rows in the expanded array. If missing, rows will not be expanded."
msgstr "Ang bilang ng mga row sa pinalawak na array. Kung nawawala, hindi mapapalawak ang mga row."

#. DjLn4
#: sc/inc/scfuncs.hrc:4362
msgctxt "ocEXPAND"
msgid "Columns"
msgstr "Mga hanay"

#. EFJZX
#: sc/inc/scfuncs.hrc:4363
msgctxt "ocEXPAND"
msgid "The number of columns in the expanded array. If missing, columns will not be expanded."
msgstr "Ang bilang ng mga column sa pinalawak na array. Kung nawawala, hindi mapapalawak ang mga column."

#. hBDD6

msgstr "Walang mga wildcard o regular na expression sa mga formula"

#. BwEWx
#: sc/uiconfig/scalc/ui/optcalculatepage.ui:104
msgctxt "extended_tip|formulaliteral"
msgid "Specifies that only literal strings are used when searching and also for character string comparisons."
msgstr "Tinutukoy na literal na mga string lang ang ginagamit kapag naghahanap at para din sa mga paghahambing ng string ng character."


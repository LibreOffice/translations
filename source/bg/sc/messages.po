#. AL6gZ
#: sc/inc/scfuncs.hrc:4337
msgctxt "ocCHOOSEROWS"
msgid "The array containing the rows to be returned in the new array."
msgstr "Масивът, съдържащ редовете, които да бъдат върнати в новия масив."

#. eMwdB
#: sc/inc/scfuncs.hrc:4338
msgctxt "ocCHOOSEROWS"
msgid "Row "
msgstr "Ред "

#. z9XmC
#: sc/inc/scfuncs.hrc:4339
msgctxt "ocCHOOSEROWS"
msgid "Row 1, Row 2,... The list of row numbers to be returned."
msgstr "Ред 1, Ред2,... са номерата на редовете, които да бъдат върнати."

#. 6uAUo
#: sc/inc/scfuncs.hrc:4345
msgctxt "ocDROP"
msgid "Excludes a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Изключва указан брой последователни редове или колони от началото или кря на масив."

#. qqDwt
#: sc/inc/scfuncs.hrc:4346
msgctxt "ocDROP"
msgid "Array"
msgstr "Масив"

#. 6hEEw
#: sc/inc/scfuncs.hrc:4347
msgctxt "ocDROP"
msgid "The array from which to drop rows or columns."
msgstr "Масивът, от който да се премахнат редове или колони."

#. CCEFR
#: sc/inc/scfuncs.hrc:4348
msgctxt "ocDROP"
msgid "Rows"
msgstr "Редове"

#. 6afd9
#: sc/inc/scfuncs.hrc:4349
msgctxt "ocDROP"
msgid "The number of rows to drop. A negative value drops from the end of the array."
msgstr "Броят редове за премахване. При отрицателна стойност се премахват редове от края на масива."

#. 4NBh4
#: sc/inc/scfuncs.hrc:4350
msgctxt "ocDROP"
msgid "Columns"
msgstr "Колони"

#. Smjhs
#: sc/inc/scfuncs.hrc:4351
msgctxt "ocDROP"
msgid "The number of columns to drop. A negative value drops from the end of the array."
msgstr "Броят колони за премахване. При отрицателна стойност се премахват колони от края на масива."

#. bLqBs
#: sc/inc/scfuncs.hrc:4357
msgctxt "ocEXPAND"
msgid "Expands or pads an array to specified row and column dimensions."
msgstr "Разширява или допълва масив до даден размер в редове и колони."

#. nQF65
#: sc/inc/scfuncs.hrc:4358
msgctxt "ocEXPAND"
msgid "Array"
msgstr "Масив"

#. GZwDK
#: sc/inc/scfuncs.hrc:4359
msgctxt "ocEXPAND"
msgid "The array to expand."
msgstr "Масивът, който да бъде разширен."

#. YiNrW
#: sc/inc/scfuncs.hrc:4360
msgctxt "ocEXPAND"
msgid "Rows"
msgstr "Редове"

#. xkjNy
#: sc/inc/scfuncs.hrc:4361
msgctxt "ocEXPAND"
msgid "The number of rows in the expanded array. If missing, rows will not be expanded."
msgstr "Броят редове в разширения масив. Ако е пропуснат, редовете няма да бъдат разширени."

#. DjLn4
#: sc/inc/scfuncs.hrc:4362
msgctxt "ocEXPAND"
msgid "Columns"
msgstr "Колони"

#. EFJZX
#: sc/inc/scfuncs.hrc:4363
msgctxt "ocEXPAND"
msgid "The number of columns in the expanded array. If missing, columns will not be expanded."
msgstr "Броят колони в разширения масив. Ако е пропуснат, колоните няма да бъдат разширени."

#. hBDD6
#: sc/inc/scfuncs.hrc:4364
msgctxt "ocEXPAND"
msgid "Pad with"
msgstr "Допълване с"

#. kTicG
#: sc/inc/scfuncs.hrc:4365
msgctxt "ocEXPAND"
msgid "The value with which to pad. The default is #N/A."
msgstr "Стойността, с която да се допълва. Подразбира се #N/A."

#. VuRi8
#: sc/inc/scfuncs.hrc:4371
msgctxt "ocHSTACK"
msgid "Appends arrays horizontally to create a larger array."
msgstr "Долепва масиви хоризонтално, за да създаде по-голям масив."

#. NBBGw
#: sc/inc/scfuncs.hrc:4372 sc/inc/scfuncs.hrc:4374
msgctxt "ocHSTACK"
msgid "Array"
msgstr "Масив"

#. nM6qp
#: sc/inc/scfuncs.hrc:4373
msgctxt "ocHSTACK"
msgid "The first array to append."
msgstr "Първият масив, който да се долепи."

#. atWUi
#: sc/inc/scfuncs.hrc:4375
msgctxt "ocHSTACK"
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer rows, #N/A error will be returned in the additional rows."
msgstr "Масив 1, Масив 2,... са следващите масиви за долепване. Ако някой масив има по-малко редове, в допълнителните редове се връща грешка #N/A."

#. TzKoX
#: sc/inc/scfuncs.hrc:4381
msgctxt "ocVSTACK"
msgid "Appends arrays vertically to create a larger array."
msgstr "Долепва масиви вертикално, за да създаде по-голям масив."

#. xBs6J
#: sc/inc/scfuncs.hrc:4382 sc/inc/scfuncs.hrc:4384
msgctxt "ocVSTACK"
msgid "Array"
msgstr "Масив"

#. oLuqo
#: sc/inc/scfuncs.hrc:4383
msgctxt "ocVSTACK"
msgid "The first array to append."
msgstr "Първият масив, който да се долепи."

#. 8A7Me
#: sc/inc/scfuncs.hrc:4385
msgctxt "ocVSTACK"
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer columns, #N/A error will be returned in the additional columns."
msgstr "Масив 1, Масив 2,... са следващите масиви за долепване. Ако някой масив има по-малко колони, в допълнителните колони се връща грешка #N/A."

#. wiwq5
#: sc/inc/scfuncs.hrc:4391
msgctxt "ocTAKE"
msgid "Returns a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Връща указан брой последователни редове или колони от началото или края на масив."

#. rvJFs
#: sc/inc/scfuncs.hrc:4392
msgctxt "ocTAKE"
msgid "Array"
msgstr "Масив"

#. tBVU7
#: sc/inc/scfuncs.hrc:4393
msgctxt "ocTAKE"
msgid "The array from which to take rows or columns."
msgstr "Масивът, от който да се вземат редове или колони."

#. A6Jw7
#: sc/inc/scfuncs.hrc:4394
msgctxt "ocTAKE"
msgid "Rows"
msgstr "Редове"

#. VP2FG
#: sc/inc/scfuncs.hrc:4395
msgctxt "ocTAKE"
msgid "The number of rows to take. A negative value takes from the end of the array."
msgstr "Броят редове за вземане. При отрицателна стойност се вземат редове от края на масива."

#. Bw54q
#: sc/inc/scfuncs.hrc:4396
msgctxt "ocTAKE"
msgid "Columns"
msgstr "Колони"

#. fGjJX
#: sc/inc/scfuncs.hrc:4397
msgctxt "ocTAKE"
msgid "The number of columns to take. A negative value takes from the end of the array."
msgstr "Броят колони за вземане. При отрицателна стойност се вземат редове от края на масива."

#. okoEs
#: sc/inc/scfuncs.hrc:4403
msgctxt "ocTEXTAFTER"
msgid "Returns the text that occurs after a given substring or delimiter."
msgstr "Връща текста, който се среща след даден подниз или разделител."

#. FiLe9
#: sc/inc/scfuncs.hrc:4404
msgctxt "ocTEXTAFTER"
msgid "Text"
msgstr "Текст"

#. f5aTy
#: sc/inc/scfuncs.hrc:4405
msgctxt "ocTEXTAFTER"
msgid "The original text."
msgstr "Оригиналният текст."

#. UNUCB
#: sc/inc/scfuncs.hrc:4406
msgctxt "ocTEXTAFTER"
msgid "Delimiter"
msgstr "Разделител"

#. wtkpC
#: sc/inc/scfuncs.hrc:4407
msgctxt "ocTEXTAFTER"
msgid "The delimiter. Multiple delimiters can be supplied."
msgstr "Разделителят. Можете да подадете няколко разделителя."

#. BD2BC
#: sc/inc/scfuncs.hrc:4408
msgctxt "ocTEXTAFTER"
msgid "Instance Number"
msgstr "Номер на срещане"

#. hE87s
#: sc/inc/scfuncs.hrc:4409
msgctxt "ocTEXTAFTER"
msgid "The instance of the delimiter after which to extract text. The default is 1. A negative number starts searching from the end."
msgstr "Срещането на разделителя, след което да се извлече текст. Подразбира се 1. Отрицателно число означава търсене от края."

#. GYN4y
#: sc/inc/scfuncs.hrc:4410
msgctxt "ocTEXTAFTER"
msgid "Match Mode"
msgstr "Режим на съответствие"

#. pnDDX
#: sc/inc/scfuncs.hrc:4411
msgctxt "ocTEXTAFTER"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Задайте 1 за търсене, нечувствително към регистъра. Подразбира се 0."

#. GG27C
#: sc/inc/scfuncs.hrc:4412
msgctxt "ocTEXTAFTER"
msgid "Match End"
msgstr "Съответствие в края"

#. 6NMda
#: sc/inc/scfuncs.hrc:4413
msgctxt "ocTEXTAFTER"
msgid "Set to 1 to treat the end of text as a delimiter. The default is 0."
msgstr "Задайте 1, за да се смята краят на текста за разделител. Подразбира се 0."

#. xxAE2
#: sc/inc/scfuncs.hrc:4414
msgctxt "ocTEXTAFTER"
msgid "If Not Found"
msgstr "При ненамерен"

#. yCXFo
#: sc/inc/scfuncs.hrc:4415
msgctxt "ocTEXTAFTER"
msgid "The value returned if no match is found. The default is #N/A."
msgstr "Стойността, която се връща, ако не е намерено съответствие. Подразбира се #N/A."

#. e3CgH
#: sc/inc/scfuncs.hrc:4421
msgctxt "ocTEXTBEFORE"
msgid "Returns the text that occurs before a given substring or delimiter."
msgstr "Връща текста, който се среща преди даден подниз или разделител."

#. fCEkH
#: sc/inc/scfuncs.hrc:4422
msgctxt "ocTEXTBEFORE"
msgid "Text"
msgstr "Текст"

#. 7rRBe
#: sc/inc/scfuncs.hrc:4423
msgctxt "ocTEXTBEFORE"
msgid "The original text."
msgstr "Оригиналният текст."

#. pD2BF
#: sc/inc/scfuncs.hrc:4424
msgctxt "ocTEXTBEFORE"
msgid "Delimiter"
msgstr "Разделител"

#. atLy4
#: sc/inc/scfuncs.hrc:4425
msgctxt "ocTEXTBEFORE"
msgid "The delimiter. Multiple delimiters can be supplied."
msgstr "Разделителят. Можете да подадете няколко разделителя."

#. a8AQn
#: sc/inc/scfuncs.hrc:4426
msgctxt "ocTEXTBEFORE"
msgid "Instance Number"
msgstr "Номер на срещане"

#. LKDm8
#: sc/inc/scfuncs.hrc:4427
msgctxt "ocTEXTBEFORE"
msgid "The instance of the delimiter before which to extract text. The default is 1. A negative number starts searching from the end."
msgstr "Срещането на разделителя, преди което да се извлече текст. Подразбира се 1. Отрицателно число означава търсене от края."

#. zpBYX
#: sc/inc/scfuncs.hrc:4428
msgctxt "ocTEXTBEFORE"
msgid "Match Mode"
msgstr "Режим на съответствие"

#. oDYnK
#: sc/inc/scfuncs.hrc:4429
msgctxt "ocTEXTBEFORE"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Задайте 1 за търсене, нечувствително към регистъра. Подразбира се 0."

#. 3KUNG
#: sc/inc/scfuncs.hrc:4430
msgctxt "ocTEXTBEFORE"
msgid "Match End"
msgstr "Съответствие в края"

#. VutiR
#: sc/inc/scfuncs.hrc:4431
msgctxt "ocTEXTBEFORE"
msgid "Set to 1 to treat the end of text as a delimiter. The default is 0."
msgstr "Задайте 1, за да се смята краят на текста за разделител. Подразбира се 0."

#. zBdc8
#: sc/inc/scfuncs.hrc:4432
msgctxt "ocTEXTBEFORE"
msgid "If Not Found"
msgstr "При ненамерен"

#. Vo5kF
#: sc/inc/scfuncs.hrc:4433
msgctxt "ocTEXTBEFORE"
msgid "The value returned if no match is found. The default is #N/A."
msgstr "Стойността, която се връща, ако не е намерено съответствие. Подразбира се #N/A."

#. uy7ox
#: sc/inc/scfuncs.hrc:4439
msgctxt "ocTEXTSPLIT"
msgid "Splits text by a given delimiter to an array of multiple cells."
msgstr "Разделя текст с даден разделител в масив от няколко клетки."

#. qHpXB
#: sc/inc/scfuncs.hrc:4440
msgctxt "ocTEXTSPLIT"
msgid "Text"
msgstr "Текст"

#. 5HCeW
#: sc/inc/scfuncs.hrc:4441
msgctxt "ocTEXTSPLIT"
msgid "The text to split."
msgstr "Текстът, който да бъде разделен."

#. iijbx
#: sc/inc/scfuncs.hrc:4442
msgctxt "ocTEXTSPLIT"
msgid "Column Delimiter"
msgstr "Разделител на колони"

#. mtWBs
#: sc/inc/scfuncs.hrc:4443
msgctxt "ocTEXTSPLIT"
msgid "The text to delimit the columns. Multiple delimiters can be supplied."
msgstr "Текстът, който отделя колоните. Можете да подадете няколко разделителя."

#. RyAtV
#: sc/inc/scfuncs.hrc:4444
msgctxt "ocTEXTSPLIT"
msgid "Row Delimiter"
msgstr "Разделител на редове"

#. 9CxYK
#: sc/inc/scfuncs.hrc:4445
msgctxt "ocTEXTSPLIT"
msgid "The text to delimit the rows. Multiple delimiters can be supplied."
msgstr "Текстът, който отделя редовете. Можете да подадете няколко разделителя."

#. CuHLJ
#: sc/inc/scfuncs.hrc:4446
msgctxt "ocTEXTSPLIT"
msgid "Ignore Empty"
msgstr "Игнориране на празните"

#. Qrkvd
#: sc/inc/scfuncs.hrc:4447
msgctxt "ocTEXTSPLIT"
msgid "Set to TRUE to ignore consecutive delimiters otherwise it creates an empty cell. The default is FALSE."
msgstr "Задайте TRUE, ако искате да се игнорират последователните разделители, иначе ще се създава празна клетка. Подразбира се FALSE."

#. AUSmr
#: sc/inc/scfuncs.hrc:4448
msgctxt "ocTEXTSPLIT"
msgid "Match mode"
msgstr "Режим на съответствие"

#. pjYxd
#: sc/inc/scfuncs.hrc:4449
msgctxt "ocTEXTSPLIT"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Задайте 1 за търсене, нечувствително към регистъра. Подразбира се 0."

#. LsoKk
#: sc/inc/scfuncs.hrc:4450
msgctxt "ocTEXTSPLIT"
msgid "Pad with"
msgstr "Допълване с"

#. niX3W
#: sc/inc/scfuncs.hrc:4451
msgctxt "ocTEXTSPLIT"
msgid "The value with which to pad. The default is #N/A."
msgstr "Стойността, с която да се допълва. Подразбира се #N/A."

#. dv6gP
#: sc/inc/scfuncs.hrc:4457
msgctxt "ocTOCOL"
msgid "Transforms an array into a single column."
msgstr "Преобразува масив в единична колона."

#. A9zBS
#: sc/inc/scfuncs.hrc:4458
msgctxt "ocTOCOL"
msgid "Array"
msgstr "Масив"

#. x95Ef
#: sc/inc/scfuncs.hrc:4459
msgctxt "ocTOCOL"
msgid "The range or array to return as a single column."
msgstr "Масивът или диапазонът, който да бъде върнат като единична колона."

#. weBya
#: sc/inc/scfuncs.hrc:4460
msgctxt "ocTOCOL"
msgid "Ignore"
msgstr "Игнориране"

#. 5JhDs
#: sc/inc/scfuncs.hrc:4461
msgctxt "ocTOCOL"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Дали да се игнорират определени видове стойности. 0 или пропуснат – запазват се всички стойности (подразбира се). 1 – игнорират се празните клетки. 2 – игнорират се клетките с грешки. 3 – игнорират се празните клетки и клетките с грешки."

#. DDm6x
#: sc/inc/scfuncs.hrc:4462
msgctxt "ocTOCOL"
msgid "Scan by column"
msgstr "Обхождане по колони"

#. LwBTC
#: sc/inc/scfuncs.hrc:4463
msgctxt "ocTOCOL"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "Масивът да се обходи по колони. FALSE или пропуснат (подразбира се) – масивът се обхожда по редове. TRUE – масивът се обхожда по колони."

#. 89qUq
#: sc/inc/scfuncs.hrc:4469
msgctxt "ocTOROW"
msgid "transforms an array into a single row."
msgstr "Преобразува масив в единичен ред."

#. GAbkQ
#: sc/inc/scfuncs.hrc:4470
msgctxt "ocTOROW"
msgid "Array"
msgstr "Масив"

#. w7WXB
#: sc/inc/scfuncs.hrc:4471
msgctxt "ocTOROW"
msgid "The range or array to return as a single row."
msgstr "Масивът или диапазонът, който да бъде върнат като единичен ред."

#. GCfA2
#: sc/inc/scfuncs.hrc:4472
msgctxt "ocTOROW"
msgid "Ignore"
msgstr "Игнориране"

#. AnEDD
#: sc/inc/scfuncs.hrc:4473
msgctxt "ocTOROW"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Дали да се игнорират определени видове стойности. 0 или пропуснат – запазват се всички стойности (подразбира се). 1 – игнорират се празните клетки. 2 – игнорират се клетките с грешки. 3 – игнорират се празните клетки и клетките с грешки."

#. pDD7V
#: sc/inc/scfuncs.hrc:4474
msgctxt "ocTOROW"
msgid "Scan by column"
msgstr "Обхождане по колони"

#. qxY7a
#: sc/inc/scfuncs.hrc:4475
msgctxt "ocTOROW"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "Масивът да се обходи по колони. FALSE или пропуснат (подразбира се) – масивът се обхожда по редове. TRUE – масивът се обхожда по колони."

#. 8p5AW
#: sc/inc/scfuncs.hrc:4481
msgctxt "ocUNIQUE"
msgid "Returns a list of unique values from a range or array."
msgstr "Връща списък от уникални стойности от диапазон или масив."

#. LAeWQ
#: sc/inc/scfuncs.hrc:4482
msgctxt "ocUNIQUE"
msgid "Array"
msgstr "Масив"

#. LHrXJ
#: sc/inc/scfuncs.hrc:4483
msgctxt "ocUNIQUE"
msgid "The range or array from which to return unique values."
msgstr "Диапазонът или масивът, от който да се върнат уникалните стойности."

#. TBfHR
#: sc/inc/scfuncs.hrc:4484
msgctxt "ocUNIQUE"
msgid "By col"
msgstr "По колона"

#. xiVEn
#: sc/inc/scfuncs.hrc:4485
msgctxt "ocUNIQUE"
msgid "Logical value indicating how to compare data: TRUE - compares data across columns. FALSE or omitted (default) - compares data across rows."
msgstr "Логическа стойност, указваща как да се сравняват данните: TRUE – сравняват се по колони. FALSE или пропуснато (по подразбиране) – сравняват се по редове."

#. GLsJf
#: sc/inc/scfuncs.hrc:4486
msgctxt "ocUNIQUE"
msgid "Uniqueness"
msgstr "Уникалност"

#. ubRgX
#: sc/inc/scfuncs.hrc:4487
msgctxt "ocUNIQUE"
msgid "Logical value that defines what values are considered unique: TRUE - returns values that occur only once. FALSE or omitted (default) - returns all distinct (different) values in the range or array."
msgstr "Логическа стойност, която определя кои стойности се смятат за уникални: TRUE – връщат се стойности, които се срещат само веднъж. FALSE или пропуснато (по подразбиране) – връщат се всички различни стойности в диапазона или масива."

#. 5Aaqr
#: sc/inc/scfuncs.hrc:4493
msgctxt "ocLET"
msgid "The LET function assigns names to calculation results. This allows storing intermediate calculations, values, or defining names inside a formula. These names only apply within the scope of the LET function."
msgstr "Функцията LET присвоява имена на резултати от изчисления. Това позволява съхраняване на междинни изчисления, стойности или дефиниране на имена във формула. Тези имена важат само в обхвата на функцията LET."

#. GTBCS
#: sc/inc/scfuncs.hrc:4494
msgctxt "ocLET"
msgid "Name 1"
msgstr "Име 1"

#. BXEhz
#: sc/inc/scfuncs.hrc:4495
msgctxt "ocLET"
msgid "The first name to assign. Must start with a letter. Cannot be the output of a formula or conflict with range syntax."
msgstr "Първото име, което да се присвои. Трябва да започва с буква. Не може да е резултат от формула или да е в конфликт със синтаксиса за диапазони."

#. agD98
#: sc/inc/scfuncs.hrc:4496
msgctxt "ocLET"
msgid "Name value "
msgstr "Стойност на име "

#. CjEiH
#: sc/inc/scfuncs.hrc:4497
msgctxt "ocLET"
msgid "Name value 1, Name value 2,... The value or calculation to assign to Name."
msgstr "Стойност на име 1, Стойност на име 2, … Стойността или изчислението, което да се присвои на „Име“."

#. GCAQK
#: sc/inc/scfuncs.hrc:4498
msgctxt "ocLET"
msgid "Calculation or Name "
msgstr "Изчисление или име "

#. uzEFm
#: sc/inc/scfuncs.hrc:4499
msgctxt "ocLET"
msgid "A calculation that uses all names within the LET function. This must be the last argument in the LET function. Or a second Name to assign to a second Name value. If a second Name is specified, Name value 2 and Calculation or Name 3 become required."
msgstr "Изчисление, което използва всички имена във функцията LET. Това трябва да е последният аргумент на функцията LET. Или второ „Име“, на което да се присвои втора „Стойност на име“. Ако е зададено второ „Име“, стават задължителни „Стойност на име 2“ и „Изчисление“ или „Име 3“."


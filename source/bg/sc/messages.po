#. VPfDS
#: sc/inc/scfuncs.hrc:4225
msgctxt "ocFOURIER"
msgid "Computes the Discrete Fourier Transform (DFT) of an array"
msgstr "Изчислява дискретното преобразувание на Фурие за масив."

#. SV2Tq
#: sc/inc/scfuncs.hrc:4226
msgctxt "ocFOURIER"
msgid "Array"
msgstr "Масив"

#. K9YnP
#: sc/inc/scfuncs.hrc:4227
msgctxt "ocFOURIER"
msgid "The array whose DFT needs to be computed. The dimensions of this array can be Nx1 or Nx2 or 1xN or 2xN."
msgstr "Масивът, за който да се изчисли дискретното преобразувание на Фурие. Размерността му може да бъде Nx1, Nx2, 1xN или 2xN."

#. RL4zG
#: sc/inc/scfuncs.hrc:4228
msgctxt "ocFOURIER"
msgid "GroupedByColumns"
msgstr "ГрупиранеПоКолони"

#. jJ5f8
#: sc/inc/scfuncs.hrc:4229
msgctxt "ocFOURIER"
msgid "Flag to indicate whether the array is grouped by columns or not (default TRUE)."
msgstr "Флаг, указващ дали масивът е групиран по колони, или не (подразбира се TRUE)."

#. KqWyU
#: sc/inc/scfuncs.hrc:4230
msgctxt "ocFOURIER"
msgid "Inverse"
msgstr ""

#. RJc49
#: sc/inc/scfuncs.hrc:4231
msgctxt "ocFOURIER"
msgid "Flag to indicate whether an inverse DFT is to be computed (default FALSE)."
msgstr "Флаг, указващ дали да се изчисли обратното дискретно преобразувание на Фурие (подразбира се FALSE)."

#. UKq8b
#: sc/inc/scfuncs.hrc:4232
msgctxt "ocFOURIER"
msgid "Polar"
msgstr "Полярно"

#. 2Fzbq
#: sc/inc/scfuncs.hrc:4233
msgctxt "ocFOURIER"
msgid "Flag to indicate whether to return the results in polar form (default FALSE)."
msgstr "Флаг, указващ дали да резултатът да бъде в полярна форма (подразбира се FALSE)."

#. 6A3GQ
#: sc/inc/scfuncs.hrc:4234
msgctxt "ocFOURIER"
msgid "MinimumMagnitude"
msgstr "МинималнаАмплитуда"

#. WFDbz
#: sc/inc/scfuncs.hrc:4235
msgctxt "ocFOURIER"
msgid "In case of Polar=TRUE, the frequency components below this magnitude are clipped out (default 0.0)."
msgstr "Ако Полярно=TRUE, честотните компоненти под тази амплитуда се отрязват (подразбира се 0)."

#. SDqjG
#: sc/inc/scfuncs.hrc:4241
msgctxt "ocRANDOM_NV"
msgid "Returns a random number between 0 and 1, non-volatile."
msgstr "Връща случайно число между 0 и 1, стабилна."

#. zUzWN
#: sc/inc/scfuncs.hrc:4247
msgctxt "ocRANDBETWEEN_NV"
msgid "Returns a random integer between the specified Bottom and Top values (both inclusive), non-volatile."
msgstr "Връща случайно цяло число между зададените стойности „ДолнаГраница“ и „ГорнаГраница“ (и двете – включително), стабилна."

#. XRTEX
#: sc/inc/scfuncs.hrc:4248
msgctxt "ocRANDBETWEEN_NV"
msgid "Bottom"
msgstr ""

#. Vipt3
#: sc/inc/scfuncs.hrc:4249
msgctxt "ocRANDBETWEEN_NV"
msgid "The smallest integer that can be returned."
msgstr "Най-малкото цяло число, което може да бъде върнато."

#. TXWYA
#: sc/inc/scfuncs.hrc:4250
msgctxt "ocRANDBETWEEN_NV"
msgid "Top"
msgstr ""

#. A6fAC
#: sc/inc/scfuncs.hrc:4251
msgctxt "ocRANDBETWEEN_NV"
msgid "The largest integer that can be returned."
msgstr "Най-голямото цяло число, което може да бъде върнато."

#. TVBBo
#: sc/inc/scfuncs.hrc:4257

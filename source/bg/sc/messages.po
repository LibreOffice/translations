msgid "Filters an array based on a Boolean (True/False) array."
msgstr "Филтрира масив на базата на булев масив (с True/False)."

#. d65Ge
#: sc/inc/scfuncs.hrc:4258
msgctxt "ocFILTER"
msgid "Range"
msgstr "Диапазон"

#. RMEDy
#: sc/inc/scfuncs.hrc:4259
msgctxt "ocFILTER"
msgid "The array, or range to filter."
msgstr "Масивът или диапазонът, който да бъде филтриран."

#. DaokM
#: sc/inc/scfuncs.hrc:4260
msgctxt "ocFILTER"
msgid "Include"
msgstr ""

#. AEy68
#: sc/inc/scfuncs.hrc:4261
msgctxt "ocFILTER"
msgid "A Boolean array whose height or width is the same as the array."
msgstr "Булев масив с височина или ширина колкото на филтрирания масив."

#. hGyPL
#: sc/inc/scfuncs.hrc:4262
msgctxt "ocFILTER"
msgid "Result if empty"
msgstr "Празен резултат"

#. Ka6BT
#: sc/inc/scfuncs.hrc:4263
msgctxt "ocFILTER"
msgid "The value to return if all values in the included array are empty (filter returns nothing)."
msgstr "Стойността, която да се върне, ако всички стойности в масива „Включени“ са празни (филтърът не връща нищо)."

#. nxhBg
#: sc/inc/scfuncs.hrc:4269
msgctxt "ocSORT"
msgid "Sorts the contents of a range or array."
msgstr "Сортира съдържанието на диапазон или масив."

#. HKENV
#: sc/inc/scfuncs.hrc:4270
msgctxt "ocSORT"
msgid "Range"
msgstr "Диапазон"

#. vgj8a
#: sc/inc/scfuncs.hrc:4271
msgctxt "ocSORT"
msgid "The range, or array to sort."
msgstr "Диапазонът или масивът за сортиране."

#. mdeDi
#: sc/inc/scfuncs.hrc:4272
msgctxt "ocSORT"
msgid "Sort index"
msgstr "Индекс за сортиране"

#. DuQFW
#: sc/inc/scfuncs.hrc:4273
msgctxt "ocSORT"
msgid "A number indicating the row or column to sort by."
msgstr "Число, показващо по кой ред или колона да се сортира."


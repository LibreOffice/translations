msgid "Text 1"
msgstr "Текст 1"

#. EKDrK
#: sc/inc/scfuncs.hrc:3743
msgctxt "ocEXACT"
msgid "The first text to be used for comparing texts."
msgstr "Първият текст за сравняване."

#. 8NKYa
#: sc/inc/scfuncs.hrc:3744
msgctxt "ocEXACT"
msgid "Text 2"
msgstr "Текст 2"

#. avCaN

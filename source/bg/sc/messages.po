#: sc/inc/scfuncs.hrc:3506
msgctxt "ocMATCH"
msgid "Search criterion"
msgstr "Критерий за търсене"

#. D3YCq
#: sc/inc/scfuncs.hrc:3507
msgctxt "ocMATCH"
msgid "The value to be used for comparison."
msgstr "Стойността, използвана за сравнение."

#. RS363
#: sc/inc/scfuncs.hrc:3508
msgctxt "ocMATCH"
msgid "Lookup array"
msgstr "Масив"

#. Ftk2C
#: sc/inc/scfuncs.hrc:3509
msgctxt "ocMATCH"
msgid "The array (range) in which the search is made."
msgstr "Масивът (областта), в който се търси."

#. qApjD
#: sc/inc/scfuncs.hrc:3510
msgctxt "ocMATCH"
msgid "Type"
msgstr "Тип"

#. 4q5AC
#: sc/inc/scfuncs.hrc:3511
msgctxt "ocMATCH"
msgid "Type can take the value 1 (first column array ascending), 0 (exact match or wildcard or regular expression match) or -1 (first column array descending) and determines the criteria to be used for comparison purposes."
msgstr "„Тип“ може да приема стойност 1 (масив във възходящ ред в първата колона), 0 (точно съвпадение или съвпадение със заместващи знаци или регулярен израз) или -1 (масив в низходящ ред в първата колона) и определя критериите за сравняване."

#. v7KYE
#: sc/inc/scfuncs.hrc:3517
msgctxt "ocX_MATCH"
msgid "Defines a relative position in an array or range of cells after comparing values."
msgstr "Дефинира относителна позиция в масив или диапазон от клетки след сравняването на стойности."

#. qQMFy
#: sc/inc/scfuncs.hrc:3518
msgctxt "ocX_MATCH"
msgid "Search criterion"
msgstr "Критерий за търсене"

#. F5utc
#: sc/inc/scfuncs.hrc:3519
msgctxt "ocX_MATCH"
msgid "The value to be used for comparison."
msgstr "Стойността, използвана за сравнение."

#. Ac7kz
#: sc/inc/scfuncs.hrc:3520
msgctxt "ocX_MATCH"
msgid "Search Array"
msgstr "Претърсван масив"

#. jdnmq
#: sc/inc/scfuncs.hrc:3521
msgctxt "ocX_MATCH"
msgid "The array or range to search."
msgstr "Масивът или диапазонът, който да бъде претърсен."

#. DQBR3
#: sc/inc/scfuncs.hrc:3522
msgctxt "ocX_MATCH"
msgid "Match Mode"
msgstr "Режим на съответствие"

#. FMDoP
#: sc/inc/scfuncs.hrc:3523
msgctxt "ocX_MATCH"
msgid ""
"0 - Exact match. Will return #N/A if no match. (default).\n"
"-1 - Exact match or the next smaller item.\n"
"1 - Exact match or the next larger item.\n"
"2 - Wildcard match.\n"
"3 - Regular expression match."
msgstr ""
"0 – точно съвпадение. Ще върне #N/A, ако няма съвпадение. (Подразбира се.)\n"
"-1 – точно съвпадение или следващият по-малък елемент.\n"
"1 – точно съвпадение или следващият по-голям елемент.\n"
"2 – съвпадение със заместващи знаци.\n"
"3 – съвпадение с регулярен израз."

#. zXTUT
#: sc/inc/scfuncs.hrc:3524
msgctxt "ocX_MATCH"
msgid "Search Mode"
msgstr "Режим на търсене"

#. LnbBE
#: sc/inc/scfuncs.hrc:3525
msgctxt "ocX_MATCH"
msgid ""
"1 - Search from the first value (default).\n"
"-1 - Search from the last value (reverse).\n"
"2 - Binary search values sorted in ascending order.\n"
"-2 - Binary search values sorted in descending order."
msgstr ""
"1 – търсене от първата стойност (подразбира се).\n"
"-1 – търсене от последната стойност (в обратна посока).\n"
"2 – двоично търсене в стойности, съхранявани във възходящ ред.\n"
"-2 – двоично търсене в стойности, съхранявани в низходящ ред."

#. RGRB3
#: sc/inc/scfuncs.hrc:3531

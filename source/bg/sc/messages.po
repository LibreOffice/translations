msgctxt "ocRANDARRAY"
msgid "Integers"
msgstr "Цели числа"

#. RM5HL
#: sc/inc/scfuncs.hrc:4319
msgctxt "ocRANDARRAY"
msgid "Return integer (TRUE) or decimal (FALSE) values."
msgstr "Да се връщат целочислени (TRUE) или дробни (FALSE) стойности."

#. 6xiFb

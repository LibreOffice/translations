msgstr "Диапазон за сортиране"

#. EWvvS
#: sc/inc/scfuncs.hrc:4285
msgctxt "ocSORTBY"
msgid "The array or range to sort."
msgstr "Масивът или диапазонът, който да бъде сортиран."

#. yh5AE
#: sc/inc/scfuncs.hrc:4286
msgctxt "ocSORTBY"
msgid "Sort by range "
msgstr "Сортиране по диапазон "

#. g2AAw
#: sc/inc/scfuncs.hrc:4287
msgctxt "ocSORTBY"
msgid "Range 1, range 2,... are the arrays or ranges to sort on."
msgstr "Диапазон 1, диапазон 2,... са масивите или диапазоните, по които да се сортира."

#. Hxhru

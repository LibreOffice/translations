msgctxt "pastespecial|paste_transpose|tooltip_text"
msgid "Transpose All"
msgstr "Барлығын транспонирлеу"

#. 3BC6U
#: sc/uiconfig/scalc/ui/pastespecial.ui:210
msgctxt "pastespecial|extended_tip|paste_transpose"

#: sc/inc/scfuncs.hrc:3524
msgctxt "ocX_MATCH"
msgid "Search Mode"
msgstr "Іздеу режимі"

#. LnbBE
#: sc/inc/scfuncs.hrc:3525
msgctxt "ocX_MATCH"
msgid ""
"1 - Search from the first value (default).\n"
"-1 - Search from the last value (reverse).\n"

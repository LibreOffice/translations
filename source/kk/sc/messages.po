msgstr "Есептелетін өріс үшін формуланы енгізіңіз."

#. zb7or
#: sc/uiconfig/scalc/ui/pivotcalcfielddialog.ui:215
msgctxt "pivotcalcfielddialog|extended_tip|addbtn"
msgid "Add new calculated field."
msgstr "Жаңа есептелетін өрісті қосу."

#. DEMNi
#: sc/uiconfig/scalc/ui/pivotcalcfielddialog.ui:227
msgctxt "pivotcalcfielddialog|modbtn"
msgid "M_odify"
msgstr "Тү_зету"

#. nZKiL
#: sc/uiconfig/scalc/ui/pivotcalcfielddialog.ui:235
msgctxt "pivotcalcfielddialog|extended_tip|modbtn"

#. dv6gP
#: sc/inc/scfuncs.hrc:4457
msgctxt "ocTOCOL"
msgid "Transforms an array into a single column."
msgstr "Массивті бір бағанға түрлендіреді."

#. A9zBS
#: sc/inc/scfuncs.hrc:4458
msgctxt "ocTOCOL"
msgid "Array"
msgstr "Массив"

#. x95Ef
#: sc/inc/scfuncs.hrc:4459
msgctxt "ocTOCOL"
msgid "The range or array to return as a single column."
msgstr "Бір баған ретінде қайтарылатын диапазон немесе массив."

#. weBya
#: sc/inc/scfuncs.hrc:4460
msgctxt "ocTOCOL"
msgid "Ignore"
msgstr "Елемеу"

#. 5JhDs
#: sc/inc/scfuncs.hrc:4461
msgctxt "ocTOCOL"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Мәндердің белгілі бір түрлерін ескермеу керек пе. 0 немесе өткізіп жіберілген — барлық мәндерді сақтау (әдепкі). 1 — бос ұяшықтарды ескермеу. 2 — қатесі бар ұяшықтарды ескермеу. 3 — бос ұяшықтар мен қатесі бар ұяшықтарды ескермеу."

#. DDm6x
#: sc/inc/scfuncs.hrc:4462
msgctxt "ocTOCOL"
msgid "Scan by column"
msgstr "Баған бойынша сканерлеу"

#. LwBTC
#: sc/inc/scfuncs.hrc:4463
msgctxt "ocTOCOL"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "Массивті баған бойынша сканерлеу. FALSE немесе өткізіп жіберілген (әдепкі) — массив жол бойынша сканерленеді. TRUE — массив баған бойынша сканерленеді."

#. 89qUq
#: sc/inc/scfuncs.hrc:4469
msgctxt "ocTOROW"
msgid "transforms an array into a single row."
msgstr "массивті бір жолға түрлендіреді."

#. GAbkQ
#: sc/inc/scfuncs.hrc:4470
msgctxt "ocTOROW"
msgid "Array"
msgstr "Массив"

#. w7WXB
#: sc/inc/scfuncs.hrc:4471
msgctxt "ocTOROW"
msgid "The range or array to return as a single row."
msgstr "Бір жол ретінде қайтарылатын ауқым немесе массив."

#. GCfA2
#: sc/inc/scfuncs.hrc:4472
msgctxt "ocTOROW"
msgid "Ignore"
msgstr "Елемеу"

#. AnEDD
#: sc/inc/scfuncs.hrc:4473
msgctxt "ocTOROW"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Мәндердің белгілі бір түрлерін ескермеу керек пе. 0 немесе өткізіп жіберілген — барлық мәндерді сақтау (әдепкі). 1 — бос ұяшықтарды ескермеу. 2 — қатесі бар ұяшықтарды ескермеу. 3 — бос ұяшықтар мен қатесі бар ұяшықтарды ескермеу."

#. pDD7V
#: sc/inc/scfuncs.hrc:4474
msgctxt "ocTOROW"
msgid "Scan by column"
msgstr "Баған бойынша сканерлеу"

#. qxY7a
#: sc/inc/scfuncs.hrc:4475
msgctxt "ocTOROW"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "Массивті баған бойынша сканерлеу. FALSE немесе өткізіп жіберілген (әдепкі) — массив жол бойынша сканерленеді. TRUE — массив баған бойынша сканерленеді."

#. 8p5AW
#: sc/inc/scfuncs.hrc:4481
msgctxt "ocUNIQUE"
msgid "Returns a list of unique values from a range or array."
msgstr "Ауқымнан немесе массивтен бірегей мәндер тізімін қайтарады."

#. LAeWQ
#: sc/inc/scfuncs.hrc:4482
msgctxt "ocUNIQUE"
msgid "Array"
msgstr "Массив"

#. LHrXJ
#: sc/inc/scfuncs.hrc:4483
msgctxt "ocUNIQUE"
msgid "The range or array from which to return unique values."
msgstr "Ішінен бірегей мәндері қайтарылатын ауқым немесе массив."

#. TBfHR
#: sc/inc/scfuncs.hrc:4484
msgctxt "ocUNIQUE"
msgid "By col"
msgstr "Баған бойынша"

#. xiVEn
#: sc/inc/scfuncs.hrc:4485
msgctxt "ocUNIQUE"
msgid "Logical value indicating how to compare data: TRUE - compares data across columns. FALSE or omitted (default) - compares data across rows."
msgstr "Деректерді қалай салыстыру керектігін көрсететін логикалық мән: TRUE - деректерді бағандар бойынша салыстырады. FALSE немесе өткізіп жіберілген (әдепкі) - деректерді жолдар бойынша салыстырады."

#. GLsJf
#: sc/inc/scfuncs.hrc:4486
msgctxt "ocUNIQUE"
msgid "Uniqueness"
msgstr "Бірегейлік"

#. ubRgX
#: sc/inc/scfuncs.hrc:4487
msgctxt "ocUNIQUE"
msgid "Logical value that defines what values are considered unique: TRUE - returns values that occur only once. FALSE or omitted (default) - returns all distinct (different) values in the range or array."
msgstr "Қандай мәндер бірегей болып саналатынын анықтайтын логикалық мән: TRUE - тек бір рет кездесетін мәндерді қайтарады. FALSE немесе өткізіп жіберілген (әдепкі) - ауқымдағы немесе массивтегі барлық ерекше (әртүрлі) мәндерді қайтарады."

#. 5Aaqr
#: sc/inc/scfuncs.hrc:4493
msgctxt "ocLET"
msgid "The LET function assigns names to calculation results. This allows storing intermediate calculations, values, or defining names inside a formula. These names only apply within the scope of the LET function."
msgstr "LET функциясы есептеу нәтижелеріне атаулар тағайындайды. Бұл аралық есептеулерді, мәндерді сақтауға немесе формула ішінде атауларды анықтауға мүмкіндік береді. Бұл атаулар тек LET функциясының ауқымында іске асырылады."

#. GTBCS
#: sc/inc/scfuncs.hrc:4494
msgctxt "ocLET"
msgid "Name 1"
msgstr "Атау 1"

#. BXEhz
#: sc/inc/scfuncs.hrc:4495
msgctxt "ocLET"
msgid "The first name to assign. Must start with a letter. Cannot be the output of a formula or conflict with range syntax."
msgstr "Тағайындалатын бірінші атау. Әріптен басталуы керек. Формуланың нәтижесі болуы немесе диапазон синтаксисімен қайшы келуі мүмкін емес."

#. agD98
#: sc/inc/scfuncs.hrc:4496
msgctxt "ocLET"
msgid "Name value "
msgstr "Атау мәні "

#. CjEiH
#: sc/inc/scfuncs.hrc:4497
msgctxt "ocLET"
msgid "Name value 1, Name value 2,... The value or calculation to assign to Name."
msgstr "Атау мәні 1, Атау мәні 2,... Атауға тағайындалатын мән немесе есептеу."

#. GCAQK
#: sc/inc/scfuncs.hrc:4498
msgctxt "ocLET"
msgid "Calculation or Name "
msgstr "Есептеу немесе Атау "

#. uzEFm
#: sc/inc/scfuncs.hrc:4499
msgctxt "ocLET"
msgid "A calculation that uses all names within the LET function. This must be the last argument in the LET function. Or a second Name to assign to a second Name value. If a second Name is specified, Name value 2 and Calculation or Name 3 become required."
msgstr "LET функциясындағы барлық атауларды қолданатын есептеу. Бұл LET функциясындағы соңғы аргумент болуы керек. Немесе екінші Атау мәніне тағайындалатын екінші Атау. Егер екінші Атау көрсетілсе, Атау мәні 2 және Есептеу немесе Атау 3 қажет болады."

#. HbPvG
#: sc/inc/scfuncs.hrc:4505
msgctxt "ocWRAPCOLS"
msgid "Wraps the provided row or column of values by columns after a specified number of elements to form a new array."
msgstr "Жаңа массив жасау үшін элементтердің көрсетілген санынан кейін берілген жолды немесе бағанды бағандар бойынша тасымалдайды."

#. ACoFA
#: sc/inc/scfuncs.hrc:4506
msgctxt "ocWRAPCOLS"
msgid "Range"
msgstr "Ауқым"

#. h3vyV
#: sc/inc/scfuncs.hrc:4507
msgctxt "ocWRAPCOLS"
msgid "the range to wrap."
msgstr "оралатын диапазон."

#. nCGAe
#: sc/inc/scfuncs.hrc:4508
msgctxt "ocWRAPCOLS"
msgid "Wrap count"
msgstr "Орау саны"

#. su9gg
#: sc/inc/scfuncs.hrc:4509
msgctxt "ocWRAPCOLS"
msgid "The maximum number of values for each column."
msgstr "Әр баған үшін мәндердің максималды саны."

#. sCG9H
#: sc/inc/scfuncs.hrc:4510
msgctxt "ocWRAPCOLS"
msgid "Pad with"
msgstr "Мынамен толтыру"

#. FnA6D
#: sc/inc/scfuncs.hrc:4511
msgctxt "ocWRAPCOLS"
msgid "The value with which to pad. The default is #N/A."
msgstr "Толтыру үшін қолданылатын мән. Әдепкі бойынша #N/A."

#. Bc4CS
#: sc/inc/scfuncs.hrc:4517
msgctxt "ocWRAPROWS"
msgid "Wraps the provided row or column of values by rows after a specified number of elements to form a new array."
msgstr "Жаңа массив жасау үшін элементтердің көрсетілген санынан кейін берілген мәндер жолын немесе бағанын жолдар бойынша орайды."

#. UeAts
#: sc/inc/scfuncs.hrc:4518
msgctxt "ocWRAPROWS"
msgid "Range"
msgstr "Ауқым"

#. Fo4we
#: sc/inc/scfuncs.hrc:4519
msgctxt "ocWRAPROWS"
msgid "the range to wrap."
msgstr "оралатын диапазон."

#. B64X3
#: sc/inc/scfuncs.hrc:4520
msgctxt "ocWRAPROWS"
msgid "Wrap count"
msgstr "Орау саны"

#. uGwSk
#: sc/inc/scfuncs.hrc:4521
msgctxt "ocWRAPROWS"
msgid "The maximum number of values for each row."
msgstr "Әр жол үшін мәндердің максималды саны."

#. AJosm
#: sc/inc/scfuncs.hrc:4522
msgctxt "ocWRAPROWS"
msgid "Pad with"
msgstr "Мынамен толтыру"

#. C3SiR
#: sc/inc/scfuncs.hrc:4523
msgctxt "ocWRAPROWS"
msgid "The value with which to pad. The default is #N/A."
msgstr "Толтыру үшін қолданылатын мән. Әдепкі бойынша #N/A."

#. zSAEX
#: sc/inc/scfuncs.hrc:4529
msgctxt "ocARRAYTOTEXT"
msgid "Returns the values of a range or array as one text string."
msgstr ""

#. BEPpM
#: sc/inc/scfuncs.hrc:4530
msgctxt "ocARRAYTOTEXT"
msgid "Array"
msgstr ""

#. fCQ8J
#: sc/inc/scfuncs.hrc:4531
msgctxt "ocARRAYTOTEXT"
msgid "The range or array to return as text."
msgstr ""

#. HHuDL
#: sc/inc/scfuncs.hrc:4532
msgctxt "ocARRAYTOTEXT"
msgid "Format"
msgstr ""

#. nRGhD
#: sc/inc/scfuncs.hrc:4533
msgctxt "ocARRAYTOTEXT"
msgid "The format of the returned text. 0 or omitted - concise format, the values separated by commas (default). 1 - strict format, an array constant in braces with quoted text, comma column separators and semicolon row separators."
msgstr ""

#. opou5
#: sc/inc/scfuncs.hrc:4539
msgctxt "ocLAMBDA"
msgid "Creates a custom, reusable %PRODUCTNAME function. The function accepts a set of parameters and one formula expression."
msgstr ""


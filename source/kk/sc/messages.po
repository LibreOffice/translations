msgctxt "ocLOOKUP"
msgid "Determines a value in a vector by comparison to values in another vector."
msgstr "Ұяшықтың, немесе бір жолдық не бір бағандық массивтің құрамасын есептейді."

#. H43GU
#: sc/inc/scfuncs.hrc:3494
msgctxt "ocLOOKUP"
msgid "Search criterion"
msgstr "Іздеу шарты"

#. 77pzS
#: sc/inc/scfuncs.hrc:3495
msgctxt "ocLOOKUP"
msgid "The value to be used for comparison."
msgstr "Салыстыру үшін қолданылатын мән."

#. LoFoB
#: sc/inc/scfuncs.hrc:3496
msgctxt "ocLOOKUP"
msgid "Search vector"
msgstr "Іздеу векторы"

#. XBDqm
#: sc/inc/scfuncs.hrc:3497
msgctxt "ocLOOKUP"
msgid "The vector (row or column) in which to search."
msgstr "Қай вектор (жол не баған) ішінен іздеу керек."

#. K5uBH
#: sc/inc/scfuncs.hrc:3498
msgctxt "ocLOOKUP"
msgid "Result vector"
msgstr "Нәтиже векторы"


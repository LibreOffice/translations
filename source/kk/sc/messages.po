#: sc/inc/scfuncs.hrc:3612
msgctxt "ocBAHTTEXT"
msgid "Number"
msgstr "Сан"

#. rPf49
#: sc/inc/scfuncs.hrc:3613
msgctxt "ocBAHTTEXT"
msgid "The number to convert."
msgstr "Түрлендірілетін сан."

#. 3MU3B
#: sc/inc/scfuncs.hrc:3619
msgctxt "ocJIS"
msgid "Converts half-width ASCII and katakana characters to full-width."
msgstr "Жартылай енді ASCII және Катакананы толық енді таңбаларға түрлендіреді."

#. ZSDiD
#: sc/inc/scfuncs.hrc:3620
msgctxt "ocJIS"
msgid "Text"
msgstr "Мәтін"

#. Axw74
#: sc/inc/scfuncs.hrc:3621
msgctxt "ocJIS"
msgid "The text to convert."
msgstr "Түрлендірілетін мәтін."

#. Gp2ii
#: sc/inc/scfuncs.hrc:3627
msgctxt "ocASC"
msgid "Converts full-width ASCII and katakana characters to half-width."
msgstr "Толық енді ASCII және Катакананы жартылай енді таңбаларға түрлендіреді."

#. coTng
#: sc/inc/scfuncs.hrc:3628
msgctxt "ocASC"
msgid "Text"
msgstr "Мәтін"

#. wM2aD
#: sc/inc/scfuncs.hrc:3629
msgctxt "ocASC"
msgid "The text to convert."
msgstr "Түрлендірілетін мәтін."

#. 6AiBS
#: sc/inc/scfuncs.hrc:3635
msgctxt "ocCODE"
msgid "Returns a numeric code for the first character in a text string."
msgstr "Мәтіндік жолдағы бірінші таңбаның сандық кодын қайтарады."

#. DPA6v
#: sc/inc/scfuncs.hrc:3636
msgctxt "ocCODE"
msgid "Text"
msgstr "Мәтін"

#. ZEEhJ
#: sc/inc/scfuncs.hrc:3637
msgctxt "ocCODE"
msgid "This is the text for which the code of the first character is to be found."
msgstr "Бірінші таңба кодын анықтау керек болып тұрған мәтін."

#. 3BhzF
#: sc/inc/scfuncs.hrc:3643
msgctxt "ocCURRENCY"
msgid "Converts a number to text in currency format."
msgstr "Үтірден кейінгі белгілі таңбаға дейін дөңгелектеумен, санды ақша пішіміне түрлендіреді."

#. AmEXJ
#: sc/inc/scfuncs.hrc:3644
msgctxt "ocCURRENCY"
msgid "Value"
msgstr "Мәні"

#. DMqkm
#: sc/inc/scfuncs.hrc:3645
msgctxt "ocCURRENCY"
msgid "Value is a number, a reference to a cell containing a number or a formula that results in a number."
msgstr "Мәні - сан немесе саны бар ұяшыққа сілтеме немесе есептеген кезде санды қайтаратын формула."

#. DknQr
#: sc/inc/scfuncs.hrc:3646
msgctxt "ocCURRENCY"
msgid "Decimals"
msgstr "Разрядтар саны"

#. Dz3XZ
#: sc/inc/scfuncs.hrc:3647
msgctxt "ocCURRENCY"
msgid "Decimal places. Denotes the number of digits to the right of the decimal point."
msgstr "Ондық разряд. Үтірден кейінгі белгілер санын көрсетеді."

#. TbQyW
#: sc/inc/scfuncs.hrc:3653
msgctxt "ocCHAR"
msgid "Converts a code number into a character or letter."
msgstr "Санды таңбаға айналдырады."

#. L8CJx
#: sc/inc/scfuncs.hrc:3654
msgctxt "ocCHAR"
msgid "Number"
msgstr "Саны"

#. Ewxmp
#: sc/inc/scfuncs.hrc:3655
msgctxt "ocCHAR"
msgid "The code value for the character."
msgstr "Таңбаның кодтық мәні."

#. wvTPD
#: sc/inc/scfuncs.hrc:3661
msgctxt "ocCLEAN"
msgid "Removes all nonprintable characters from text."
msgstr "Мәтіннен барлық баспаға шығарылмайтын белгілерді алып тастайды."

#. vuriX
#: sc/inc/scfuncs.hrc:3662
msgctxt "ocCLEAN"
msgid "Text"
msgstr "Мәтін"

#. pHejY
#: sc/inc/scfuncs.hrc:3663
msgctxt "ocCLEAN"
msgid "The text from which nonprintable characters are to be removed."
msgstr "Ішінен баспаға шығарылмайтын белгілерді алып тастау үшін мәтін."

#. qCCXt
#: sc/inc/scfuncs.hrc:3669
msgctxt "ocCONCAT"
msgid "Combines several text items into one."
msgstr "Бірнеше мәтіндік элементті бір жолға біріктіреді."

#. Qfk8d
#: sc/inc/scfuncs.hrc:3670
msgctxt "ocCONCAT"
msgid "Text"
msgstr "Мәтін"

#. Ywoh6
#: sc/inc/scfuncs.hrc:3671
msgctxt "ocCONCAT"
msgid "Text for the concatenation."
msgstr "Біріктіру үшін мәтін."

#. a7n3F
#: sc/inc/scfuncs.hrc:3677
msgctxt "ocCONCAT_MS"
msgid "Combines several text items into one, accepts cell ranges as arguments."
msgstr "Бірнеше мәтіндік элементтерді біріктіреді, аргументтер ретінде ұяшықтау ауқымын қабылдайды."

#. Dt3XC
#: sc/inc/scfuncs.hrc:3678
msgctxt "ocCONCAT_MS"
msgid "Text"
msgstr "Мәтін"

#. 3UKas
#: sc/inc/scfuncs.hrc:3679
msgctxt "ocCONCAT_MS"
msgid "Text and/or cell ranges for the concatenation."
msgstr "Біріктіру үшін мәтін және/немесе ұяшықтар ауқымы."

#. bXDdz
#: sc/inc/scfuncs.hrc:3685
msgctxt "ocTEXTJOIN_MS"
msgid "Combines several text items into one, accepts cell ranges as arguments. Uses delimiter between items."
msgstr "Бірнеше мәтіндік элементтерді біріктіреді, аргументтер ретінде ұяшықтау ауқымын қабылдайды. Элементтер арасында ажыратқышты қолданады."

#. wRn9f
#: sc/inc/scfuncs.hrc:3686
msgctxt "ocTEXTJOIN_MS"
msgid "Delimiter"
msgstr "Ажыратқыш"

#. vBL2U
#: sc/inc/scfuncs.hrc:3687
msgctxt "ocTEXTJOIN_MS"
msgid "Text string to be used as delimiter."
msgstr "Ажыратқыш ретінде қолданылатын мәтін."

#. aWBkD
#: sc/inc/scfuncs.hrc:3688
msgctxt "ocTEXTJOIN_MS"
msgid "Skip empty cells"
msgstr "Бос ұяшықтарды аттап кету"

#. 54rgD
#: sc/inc/scfuncs.hrc:3689
msgctxt "ocTEXTJOIN_MS"
msgid "If TRUE, empty cells will be ignored."
msgstr "TRUE болса, бос ұяшықтар есепке алынбайды."

#. AXZri
#: sc/inc/scfuncs.hrc:3690
msgctxt "ocTEXTJOIN_MS"
msgid "Text"
msgstr "Мәтін"

#. UgtQ9
#: sc/inc/scfuncs.hrc:3691
msgctxt "ocTEXTJOIN_MS"
msgid "Text and/or cell ranges for the concatenation."
msgstr "Біріктіру үшін мәтін және/немесе ұяшықтар ауқымы."

#. UE3Dz
#: sc/inc/scfuncs.hrc:3697
msgctxt "ocIFS_MS"
msgid "Checks 1 or more conditions and returns a value corresponding to the first true condition."
msgstr "Бір немесе бірнеше шарттарды тексеріп, бірінші кездескен шын шартқа сай келетін мәнді қайтарады."

#. FbouL
#: sc/inc/scfuncs.hrc:3698
msgctxt "ocIFS_MS"
msgid "Test"
msgstr "Тест"

#. D3Gnr
#: sc/inc/scfuncs.hrc:3699
msgctxt "ocIFS_MS"
msgid "Any value or expression which can be either TRUE or FALSE."
msgstr "Есептелген кезде TRUE не FALSE қайтаратын кез-келген мән немесе өрнек."

#. 5EAbH
#: sc/inc/scfuncs.hrc:3700
msgctxt "ocIFS_MS"
msgid "Result"
msgstr "Нәтижесі"

#. uMaAz
#: sc/inc/scfuncs.hrc:3701
msgctxt "ocIFS_MS"
msgid "The result of the function if test is TRUE."
msgstr "Сынау TRUE болса, функцияның нәтижесі."

#. bLDmt
#: sc/inc/scfuncs.hrc:3707
msgctxt "ocSWITCH_MS"
msgid "Compares expression against list of value/result pairs, and returns result for first value that matches the expression.  If expression does not match any value, a default result is returned, if it is placed as final item in parameter list without a value."
msgstr "Өрнекті мән/нәтиже жұптарының тізімімен салыстырады және өрнекке сәйкес келетін бірінші мән үшін нәтижені қайтарады. Егер өрнек ешбір мәнге сәйкес келмесе, бастапқы нәтиже қайтарылады, егер ол мәнсіз параметрлер тізімінде соңғы элемент ретінде орналастырылса."

#. YW6AA
#: sc/inc/scfuncs.hrc:3708
msgctxt "ocSWITCH_MS"
msgid "Expression"
msgstr "Өрнек"

#. FFu9v
#: sc/inc/scfuncs.hrc:3709
msgctxt "ocSWITCH_MS"
msgid "Value to be compared against value1…valueN (N ≤ 127)"
msgstr "Мән1…мәнN (N ≤ 127) мәндерімен салыстырылатын мән"

#. sc7xf
#: sc/inc/scfuncs.hrc:3710
msgctxt "ocSWITCH_MS"
msgid "Value"
msgstr "Мәні"

#. XynUw
#: sc/inc/scfuncs.hrc:3711
msgctxt "ocSWITCH_MS"
msgid "Value to compare against expression. If no result is given, then value is returned as default result."
msgstr "Өрнекпен салыстырылатын мән. Егер нәтиже берілмесе, мән бастапқы нәтиже ретінде қайтарылады."

#. WMQ6f
#: sc/inc/scfuncs.hrc:3712
msgctxt "ocSWITCH_MS"
msgid "Result"
msgstr "Нәтижесі"

#. jJqUE
#: sc/inc/scfuncs.hrc:3713
msgctxt "ocSWITCH_MS"
msgid "Value to return when corresponding value argument matches expression."
msgstr "Сәйкес мән өрнекке сай келетін жағдайда қайтарылатын мән."

#. iC2Ps
#: sc/inc/scfuncs.hrc:3718
msgctxt "ocMINIFS_MS"
msgid "Returns the minimum value in a range that meet multiple criteria in multiple ranges."
msgstr "Бірнеше шартқа сай келетін бірнеше ауқымдардың ұяшықтар мәндерінің минималды шамасы."

#. EWx5x
#: sc/inc/scfuncs.hrc:3719
msgctxt "ocMINIFS_MS"
msgid "Min range"
msgstr "Мин. ауқым"

#. fLjGC
#: sc/inc/scfuncs.hrc:3720
msgctxt "ocMINIFS_MS"
msgid "The range from which the minimum will be determined."
msgstr "Ішінен минимумы анықталатын ауқым."

#. aW9bE
#: sc/inc/scfuncs.hrc:3721
msgctxt "ocMINIFS_MS"
msgid "Range "
msgstr "Ауқымы "

#. qrT8q
#: sc/inc/scfuncs.hrc:3722
msgctxt "ocMINIFS_MS"
msgid "Range 1, range 2,... are the ranges to be evaluated by the criteria given."
msgstr "Ауқым 1, ауқым 2, ... - шарттар іске асырылатын ұяшықтар ауқымы."

#. CBwwS
#: sc/inc/scfuncs.hrc:3723
msgctxt "ocMINIFS_MS"
msgid "Criteria "
msgstr "Шарт "

#. U5nDi
#: sc/inc/scfuncs.hrc:3724
msgctxt "ocMINIFS_MS"
msgid "Criteria 1, criteria 2,... are the criteria to be applied to the ranges given."
msgstr "Шарт 1, шарт 2, ... - берілген ұяшықтар ауқымына іске асырылатын шарт."

#. XFfNP
#: sc/inc/scfuncs.hrc:3729
msgctxt "ocMAXIFS_MS"
msgid "Returns the maximum value in a range that meet multiple criteria in multiple ranges."
msgstr "Бірнеше шартқа сай келетін бірнеше ауқымдардың ұяшықтар мәндерінің максималды шамасы."

#. FefDg
#: sc/inc/scfuncs.hrc:3730
msgctxt "ocMAXIFS_MS"
msgid "Max range"
msgstr "Макс. ауқым"

#. K2x3P
#: sc/inc/scfuncs.hrc:3731
msgctxt "ocMAXIFS_MS"
msgid "The range from which the maximum will be determined."
msgstr "Ішінен максимумы анықталатын ауқым."

#. FAmqX
#: sc/inc/scfuncs.hrc:3732
msgctxt "ocMAXIFS_MS"
msgid "Range "
msgstr "Ауқымы "

#. TzfDx
#: sc/inc/scfuncs.hrc:3733
msgctxt "ocMAXIFS_MS"
msgid "Range 1, range 2,... are the ranges to be evaluated by the criteria given."
msgstr "Ауқым 1, ауқым 2, ... - шарттар іске асырылатын ұяшықтар ауқымы."

#. CAoi8
#: sc/inc/scfuncs.hrc:3734
msgctxt "ocMAXIFS_MS"
msgid "Criteria "
msgstr "Шарт "

#. qETAC
#: sc/inc/scfuncs.hrc:3735
msgctxt "ocMAXIFS_MS"
msgid "Criteria 1, criteria 2,... are the criteria to be applied to the ranges given."
msgstr "Шарт 1, шарт 2, ... - берілген ұяшықтар ауқымына іске асырылатын шарт."

#. 8myxA
#: sc/inc/scfuncs.hrc:3741
msgctxt "ocEXACT"
msgid "Specifies whether two texts are identical."
msgstr "Екі мәтіндік жол бірдей ма, соны анықтайды."

#. PLeWB
#: sc/inc/scfuncs.hrc:3742
msgctxt "ocEXACT"
msgid "Text 1"
msgstr "Мәтін 1"

#. EKDrK
#: sc/inc/scfuncs.hrc:3743
msgctxt "ocEXACT"
msgid "The first text to be used for comparing texts."
msgstr "Мәтіндерді салыстыру үшін бірінші мәтін."

#. 8NKYa
#: sc/inc/scfuncs.hrc:3744
msgctxt "ocEXACT"
msgid "Text 2"
msgstr "Мәтін 2"

#. avCaN
#: sc/inc/scfuncs.hrc:3745
msgctxt "ocEXACT"
msgid "The second text for comparing texts."
msgstr "Мәтіндерді салыстыру үшін екінші мәтін."

#. yehHT

#. qQMFy
#: sc/inc/scfuncs.hrc:3518
msgctxt "ocX_MATCH"
msgid "Search criterion"
msgstr "Іздеу шарты"

#. F5utc
#: sc/inc/scfuncs.hrc:3519
msgctxt "ocX_MATCH"
msgid "The value to be used for comparison."
msgstr "Салыстыру үшін қолданылатын мән."


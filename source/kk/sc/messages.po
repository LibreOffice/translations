msgctxt "ocX_LOOKUP"
msgid "Search Array"
msgstr "Ішінен іздеу үшін массив"

#. mwst8
#: sc/inc/scfuncs.hrc:3455
msgctxt "ocX_LOOKUP"
msgid "The array or range to search."
msgstr "Ішінен іздеу үшін массив немесе ауқым."

#. hkB5Z
#: sc/inc/scfuncs.hrc:3456
msgctxt "ocX_LOOKUP"
msgid "Result Array"
msgstr "Нәтиже массиві"

#. fAPwy
#: sc/inc/scfuncs.hrc:3457
msgctxt "ocX_LOOKUP"
msgid "The array or range to return."
msgstr "Қайтару үшін массив немесе ауқым."


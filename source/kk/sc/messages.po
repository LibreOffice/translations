msgctxt "ocX_LOOKUP"
msgid "Search criterion"
msgstr "Іздеу шарты"

#. G5GFh
#: sc/inc/scfuncs.hrc:3453
msgctxt "ocX_LOOKUP"
msgid "The value to be found in the first column."
msgstr "Кестенің бірінші бағанында табу үшін мән."

#. B4aE3

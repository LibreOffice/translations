msgstr "Есептелетін өрісті өшіру."

#. PC7JA
#: sc/uiconfig/scalc/ui/pivotcalcfielddialog.ui:306
msgctxt "pivotcalcfielddialog|label3"
msgid "Fields:"
msgstr "Өрістер:"

#. pZWDA
#: sc/uiconfig/scalc/ui/pivotcalcfielddialog.ui:350
msgctxt "pivotcalcfielddialog|extended_tip|listbox-fields"
msgid "These are the available fields from Pivot table. By double clicking on the field name in the list the name will be added to the formula."
msgstr "Бұл жиынтық кестесінің қолжетімді өрістері. Тізімдегі өріс атын екі рет шерту арқылы ол формулаға қосылады."

#. vvCvX
#: sc/uiconfig/scalc/ui/pivotcalcfielddialog.ui:364
msgctxt "pivotcalcfielddialog|insertbtn"
msgid "_Insert Field"
msgstr "Өрісті _кірістіру"

#. cr5v6
#: sc/uiconfig/scalc/ui/pivotcalcfielddialog.ui:373
msgctxt "pivotcalcfielddialog|extended_tip|insertbtn"
msgid "Insert selected field name to the formula."
msgstr "Таңдалған өріс атын формулаға кірістіру."

#. yoy8y
#: sc/uiconfig/scalc/ui/pivotcalcfielddialog.ui:406
msgctxt "pivotcalcfielddialog|extended_tip|PivotCalcField"
msgid "Insert, modify, or delete calculated fields for the pivot table."
msgstr "Жиынтық кестесі үшін есептелетін өрістерді кірістіру, түзету немесе өшіру."

#. AqzPf
#: sc/uiconfig/scalc/ui/pivotfielddialog.ui:16
msgctxt "pivotfielddialog|PivotFieldDialog"
msgid "Data Field"
msgstr "Деректер өрісі"

#. 8Lex4
#: sc/uiconfig/scalc/ui/pivotfielddialog.ui:34
msgctxt "pivotfielddialog|options"
msgid "_Options..."
msgstr "_Опциялар..."

#. dtMEN
#: sc/uiconfig/scalc/ui/pivotfielddialog.ui:41
msgctxt "pivotfielddialog|extended_tip|options"
msgid "Opens the Data Field Options dialog. The Options button is visible for filters and column or row fields only."
msgstr "«Деректер өрісінің опциялары» сұхбат терезесін ашады. «Опциялар» батырмасы тек сүзгілер мен баған немесе жол өрістері үшін көрінеді."

#. KBmND
#: sc/uiconfig/scalc/ui/pivotfielddialog.ui:133
msgctxt "pivotfielddialog|none"
msgid "_None"
msgstr "_Жоқ"

#. ABmZC
#: sc/uiconfig/scalc/ui/pivotfielddialog.ui:148
msgctxt "pivotfielddialog|auto"

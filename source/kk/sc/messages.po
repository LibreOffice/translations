msgid "GroupedByColumns"
msgstr "Бағандар бойынша топтастырылған"

#. jJ5f8
#: sc/inc/scfuncs.hrc:4229
msgctxt "ocFOURIER"
msgid "Flag to indicate whether the array is grouped by columns or not (default TRUE)."
msgstr "Массив бағандар бойынша топтастырылған ба, соны көрсететін жалауша (бастапқыда TRUE)."

#. KqWyU
#: sc/inc/scfuncs.hrc:4230
msgctxt "ocFOURIER"
msgid "Inverse"
msgstr "Кері"

#. RJc49
#: sc/inc/scfuncs.hrc:4231
msgctxt "ocFOURIER"
msgid "Flag to indicate whether an inverse DFT is to be computed (default FALSE)."
msgstr "КФТ есептеу керек пе, соны көрсететін жалауша (бастапқыда FALSE)."

#. UKq8b
#: sc/inc/scfuncs.hrc:4232
msgctxt "ocFOURIER"
msgid "Polar"
msgstr "Полярлы"

#. 2Fzbq
#: sc/inc/scfuncs.hrc:4233
msgctxt "ocFOURIER"
msgid "Flag to indicate whether to return the results in polar form (default FALSE)."
msgstr "Нәтижелерді полярлы түрде қайтару керек пе, соны көрсететін жалауша (бастапқыда FALSE)."

#. 6A3GQ
#: sc/inc/scfuncs.hrc:4234
msgctxt "ocFOURIER"
msgid "MinimumMagnitude"
msgstr "Минималды магнитуда"

#. WFDbz
#: sc/inc/scfuncs.hrc:4235
msgctxt "ocFOURIER"
msgid "In case of Polar=TRUE, the frequency components below this magnitude are clipped out (default 0.0)."
msgstr "Егер Полярлы = TRUE болса, бұл шамадан төмен жиіліктік құраушылар сөндіріледі (бастапқыда 0,0)."

#. SDqjG
#: sc/inc/scfuncs.hrc:4241
msgctxt "ocRANDOM_NV"
msgid "Returns a random number between 0 and 1, non-volatile."
msgstr "0 мен 1 арасындағы кездейсоқ санды қайтарады, тұрақты сақталады."

#. zUzWN
#: sc/inc/scfuncs.hrc:4247
msgctxt "ocRANDBETWEEN_NV"
msgid "Returns a random integer between the specified Bottom and Top values (both inclusive), non-volatile."
msgstr "Көрсетілген Төменгі және Жоғарғы мәндер (екеуін де қоса алғанда) арасындағы кездейсоқ бүтін санды қайтарады, тұрақты."

#. XRTEX
#: sc/inc/scfuncs.hrc:4248
msgctxt "ocRANDBETWEEN_NV"
msgid "Bottom"
msgstr "Төменгі"

#. Vipt3
#: sc/inc/scfuncs.hrc:4249
msgctxt "ocRANDBETWEEN_NV"
msgid "The smallest integer that can be returned."
msgstr "Қайтаруға болатын ең кіші бүтін сан."

#. TXWYA
#: sc/inc/scfuncs.hrc:4250
msgctxt "ocRANDBETWEEN_NV"
msgid "Top"
msgstr "Үстіңгі"

#. A6fAC
#: sc/inc/scfuncs.hrc:4251
msgctxt "ocRANDBETWEEN_NV"
msgid "The largest integer that can be returned."
msgstr "Қайтаруға болатын ең үлкен бүтін сан."

#. TVBBo
#: sc/inc/scfuncs.hrc:4257
msgctxt "ocFILTER"
msgid "Filters an array based on a Boolean (True/False) array."
msgstr "Массивті логикалық (Ақиқат/Жалған) массив негізінде сүзгілейді."

#. d65Ge
#: sc/inc/scfuncs.hrc:4258
msgctxt "ocFILTER"
msgid "Range"
msgstr "Ауқым"

#. RMEDy
#: sc/inc/scfuncs.hrc:4259
msgctxt "ocFILTER"
msgid "The array, or range to filter."
msgstr "Сүзгілеу үшін массим немесе ауқым."

#. DaokM
#: sc/inc/scfuncs.hrc:4260
msgctxt "ocFILTER"
msgid "Include"
msgstr "Қамту"

#. AEy68
#: sc/inc/scfuncs.hrc:4261
msgctxt "ocFILTER"
msgid "A Boolean array whose height or width is the same as the array."
msgstr "Биіктігі немесе ені массивпен бірдей логикалық массив."

#. hGyPL
#: sc/inc/scfuncs.hrc:4262
msgctxt "ocFILTER"
msgid "Result if empty"
msgstr "Бос болған жағдайдағы нәтиже"

#. Ka6BT
#: sc/inc/scfuncs.hrc:4263
msgctxt "ocFILTER"
msgid "The value to return if all values in the included array are empty (filter returns nothing)."
msgstr "Егер қосылған массивтегі барлық мәндер бос болса (фильтр ештеңе қайтармаса), қайтарылатын мән."

#. nxhBg
#: sc/inc/scfuncs.hrc:4269
msgctxt "ocSORT"
msgid "Sorts the contents of a range or array."
msgstr "Ауқымның немесе массивтің мазмұнын сұрыптайды."

#. HKENV
#: sc/inc/scfuncs.hrc:4270
msgctxt "ocSORT"
msgid "Range"
msgstr "Ауқым"

#. vgj8a
#: sc/inc/scfuncs.hrc:4271
msgctxt "ocSORT"
msgid "The range, or array to sort."
msgstr "Сұрыптау үшін массив немесе ауқым."

#. mdeDi
#: sc/inc/scfuncs.hrc:4272
msgctxt "ocSORT"
msgid "Sort index"
msgstr "Сұрыптау нұсқағышы"

#. DuQFW
#: sc/inc/scfuncs.hrc:4273
msgctxt "ocSORT"
msgid "A number indicating the row or column to sort by."
msgstr "Сұрыптау орындалатын жолды немесе бағанды көрсететін сан."

#. BK4XX
#: sc/inc/scfuncs.hrc:4274
msgctxt "ocSORT"
msgid "Sort order"
msgstr "Сұрыптау реті"

#. zFBzs
#: sc/inc/scfuncs.hrc:4275
msgctxt "ocSORT"
msgid "A number indicating the desired sort order; 1 for ascending order (default), -1 for descending order."
msgstr "Қажетті сұрыптау ретін көрсететін сан; 1 - өсу ретімен (әдепкі), -1 - кему ретімен."

#. ResTu
#: sc/inc/scfuncs.hrc:4276
msgctxt "ocSORT"
msgid "By col"
msgstr "Баған бойынша"

#. DwWWz
#: sc/inc/scfuncs.hrc:4277
msgctxt "ocSORT"
msgid "A logical value indicating the desired sort direction; FALSE to sort by row (default), TRUE to sort by column."
msgstr "Қажетті сұрыптау бағытын көрсететін логикалық мән; ЖАЛҒАН - жол бойынша сұрыптау (әдепкі), АҚИҚАТ - баған бойынша сұрыптау."

#. UEqVF
#: sc/inc/scfuncs.hrc:4283
msgctxt "ocSORTBY"
msgid "Sorts the contents of a range or array based on the values in a corresponding range or array."
msgstr "Сәйкес ауқымдағы немесе массивтегі мәндер негізінде ауқымның немесе массивтің мазмұнын сұрыптайды."

#. Htvdm
#: sc/inc/scfuncs.hrc:4284
msgctxt "ocSORTBY"
msgid "Sort range"
msgstr "Сұрыптау ауқымы"

#. EWvvS
#: sc/inc/scfuncs.hrc:4285
msgctxt "ocSORTBY"
msgid "The array or range to sort."
msgstr "Сұрыпталатын массив немесе ауқым."

#. yh5AE
#: sc/inc/scfuncs.hrc:4286
msgctxt "ocSORTBY"
msgid "Sort by range "
msgstr "Ауқым бойынша сұрыптау "

#. g2AAw
#: sc/inc/scfuncs.hrc:4287
msgctxt "ocSORTBY"
msgid "Range 1, range 2,... are the arrays or ranges to sort on."
msgstr "Ауқым 1, Ауқым 2, ... — сұрыптау орындалатын массивтер немесе ауқымдар."

#. Hxhru
#: sc/inc/scfuncs.hrc:4288
msgctxt "ocSORTBY"
msgid "Sort order "
msgstr "Сұрыптау реті "

#. qWxek
#: sc/inc/scfuncs.hrc:4289
msgctxt "ocSORTBY"
msgid "Order 1, order 2,... are the orders to use for sorting. 1 for ascending, -1 for descending. Default is ascending."
msgstr "Рет 1, Рет 2, ... — сұрыптау үшін пайдаланылатын реттер. 1 - өсу ретімен, -1 - кему ретімен. Әдепкі бойынша - өсу ретімен."

#. Js6Dj
#: sc/inc/scfuncs.hrc:4295
msgctxt "ocMAT_SEQUENCE"
msgid "Generates a list of sequential numbers in an array, such as 1, 2, 3, 4."
msgstr "Массив ішінде 1, 2, 3, 4 сияқты реттік сандар тізімін жасайды."

#. QBMEL
#: sc/inc/scfuncs.hrc:4296
msgctxt "ocMAT_SEQUENCE"
msgid "Rows"
msgstr "Жолдар"

#. QJTBL
#: sc/inc/scfuncs.hrc:4297
msgctxt "ocMAT_SEQUENCE"
msgid "The number of rows to return."
msgstr "Қайтару үшін жолдар саны."

#. GEC8c
#: sc/inc/scfuncs.hrc:4298
msgctxt "ocMAT_SEQUENCE"
msgid "Columns"
msgstr "Бағандар"

#. fhnFH
#: sc/inc/scfuncs.hrc:4299
msgctxt "ocMAT_SEQUENCE"
msgid "The number of columns to return."
msgstr "Қайтару үшін бағандар саны."

#. kWPVy
#: sc/inc/scfuncs.hrc:4300
msgctxt "ocMAT_SEQUENCE"
msgid "Start"
msgstr "Бастау"

#. dCwre
#: sc/inc/scfuncs.hrc:4301
msgctxt "ocMAT_SEQUENCE"
msgid "The first number in the sequence."
msgstr "Тізбектегі бірінші сан."

#. Vuu2D
#: sc/inc/scfuncs.hrc:4302
msgctxt "ocMAT_SEQUENCE"
msgid "Step"
msgstr "Қадам"

#. usMFD
#: sc/inc/scfuncs.hrc:4303
msgctxt "ocMAT_SEQUENCE"
msgid "The amount to increment each subsequent value in the array."
msgstr "Массивтегі әрбір кейінгі мәнді арттыру қадамы."

#. LbVEK
#: sc/inc/scfuncs.hrc:4309
msgctxt "ocRANDARRAY"
msgid "Generates an array of random numbers between two limit values."
msgstr "Екі шекті мән арасындағы кездейсоқ сандар массивін жасайды."

#. FkAEX
#: sc/inc/scfuncs.hrc:4310
msgctxt "ocRANDARRAY"
msgid "Rows"
msgstr "Жолдар"

#. MAEDm
#: sc/inc/scfuncs.hrc:4311
msgctxt "ocRANDARRAY"
msgid "The number of rows to return."
msgstr "Қайтару үшін жолдар саны."

#. KEjFn
#: sc/inc/scfuncs.hrc:4312
msgctxt "ocRANDARRAY"
msgid "Columns"
msgstr "Бағандар"

#. Bf74v
#: sc/inc/scfuncs.hrc:4313
msgctxt "ocRANDARRAY"
msgid "The number of columns to return."
msgstr "Қайтару үшін бағандар саны."

#. sH4qD
#: sc/inc/scfuncs.hrc:4314
msgctxt "ocRANDARRAY"
msgid "Min"
msgstr "Минимум"

#. gEAsz
#: sc/inc/scfuncs.hrc:4315
msgctxt "ocRANDARRAY"
msgid "The lower limit of the generated numbers."
msgstr "Генерацияланатын сандардың төменгі шегі."

#. zBinA
#: sc/inc/scfuncs.hrc:4316
msgctxt "ocRANDARRAY"
msgid "Max"
msgstr "Максимум"

#. kSq6A
#: sc/inc/scfuncs.hrc:4317
msgctxt "ocRANDARRAY"
msgid "The upper limit of the generated numbers."
msgstr "Генерацияланатын сандардың жоғарғы шегі."

#. 3E6Xi
#: sc/inc/scfuncs.hrc:4318
msgctxt "ocRANDARRAY"
msgid "Integers"
msgstr "Бүтін сандар"

#. RM5HL
#: sc/inc/scfuncs.hrc:4319
msgctxt "ocRANDARRAY"
msgid "Return integer (TRUE) or decimal (FALSE) values."
msgstr "Бүтін (TRUE) немесе ондық (FALSE) мәндерді қайтару."

#. 6xiFb
#: sc/inc/scfuncs.hrc:4325
msgctxt "ocCHOOSECOLS"
msgid "Returns the specified columns from an array."
msgstr "Массивтен көрсетілген бағандарды қайтарады."

#. vDNp8
#: sc/inc/scfuncs.hrc:4326
msgctxt "ocCHOOSECOLS"
msgid "Array"
msgstr "Массив"

#. R3koe
#: sc/inc/scfuncs.hrc:4327
msgctxt "ocCHOOSECOLS"
msgid "The array containing the columns to be returned in the new array."
msgstr "Жаңа массивте қайтарылатын бағандары бар массив."

#. kZPeA
#: sc/inc/scfuncs.hrc:4328
msgctxt "ocCHOOSECOLS"
msgid "Column "
msgstr "Баған "

#. cwS8A
#: sc/inc/scfuncs.hrc:4329
msgctxt "ocCHOOSECOLS"
msgid "Column 1, Column 2,... The list of column numbers to be returned."
msgstr "Баған 1, Баған 2,... Қайтарылатын баған нөмірлерінің тізімі."

#. sGgbA
#: sc/inc/scfuncs.hrc:4335
msgctxt "ocCHOOSEROWS"
msgid "Returns the specified rows from an array."
msgstr "Массивтен көрсетілген жолдарды қайтарады."

#. HkSKg
#: sc/inc/scfuncs.hrc:4336
msgctxt "ocCHOOSEROWS"
msgid "Array"
msgstr "Массив"

#. AL6gZ
#: sc/inc/scfuncs.hrc:4337
msgctxt "ocCHOOSEROWS"
msgid "The array containing the rows to be returned in the new array."
msgstr "Жаңа массивте қайтарылатын жолдары бар массив."

#. eMwdB
#: sc/inc/scfuncs.hrc:4338
msgctxt "ocCHOOSEROWS"
msgid "Row "
msgstr "Жол "

#. z9XmC
#: sc/inc/scfuncs.hrc:4339
msgctxt "ocCHOOSEROWS"
msgid "Row 1, Row 2,... The list of row numbers to be returned."
msgstr "Жол 1, Жол 2,... Қайтарылатын жол нөмірлерінің тізімі."

#. 6uAUo
#: sc/inc/scfuncs.hrc:4345
msgctxt "ocDROP"
msgid "Excludes a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Массивтің басынан немесе аяғынан көрсетілген іргелес жолдар немесе бағандар санын алып тастайды."

#. qqDwt
#: sc/inc/scfuncs.hrc:4346
msgctxt "ocDROP"
msgid "Array"
msgstr "Массив"

#. 6hEEw
#: sc/inc/scfuncs.hrc:4347
msgctxt "ocDROP"
msgid "The array from which to drop rows or columns."
msgstr "Ішінен жолдар немесе бағандар алынып тасталатын массив."

#. CCEFR
#: sc/inc/scfuncs.hrc:4348
msgctxt "ocDROP"
msgid "Rows"
msgstr "Жолдар"

#. 6afd9
#: sc/inc/scfuncs.hrc:4349
msgctxt "ocDROP"
msgid "The number of rows to drop. A negative value drops from the end of the array."
msgstr "Алынып тасталатын жолдар саны. Теріс мән массивтің соңынан бастап алып тастайды."

#. 4NBh4
#: sc/inc/scfuncs.hrc:4350
msgctxt "ocDROP"
msgid "Columns"
msgstr "Бағандар"

#. Smjhs
#: sc/inc/scfuncs.hrc:4351
msgctxt "ocDROP"
msgid "The number of columns to drop. A negative value drops from the end of the array."
msgstr "Алынып тасталатын бағандар саны. Теріс мән массивтің соңынан бастап алып тастайды."

#. bLqBs
#: sc/inc/scfuncs.hrc:4357
msgctxt "ocEXPAND"
msgid "Expands or pads an array to specified row and column dimensions."
msgstr "Массивті көрсетілген жол және баған өлшемдеріне дейін кеңейтеді немесе толтырады."

#. nQF65
#: sc/inc/scfuncs.hrc:4358
msgctxt "ocEXPAND"
msgid "Array"
msgstr "Массив"

#. GZwDK
#: sc/inc/scfuncs.hrc:4359
msgctxt "ocEXPAND"
msgid "The array to expand."
msgstr "Кеңейтілетін массив."

#. YiNrW
#: sc/inc/scfuncs.hrc:4360
msgctxt "ocEXPAND"
msgid "Rows"
msgstr "Жолдар"

#. xkjNy
#: sc/inc/scfuncs.hrc:4361
msgctxt "ocEXPAND"
msgid "The number of rows in the expanded array. If missing, rows will not be expanded."
msgstr "Кеңейтілген массивтегі жолдар саны. Егер көрсетілмесе, жолдар кеңейтілмейді."

#. DjLn4
#: sc/inc/scfuncs.hrc:4362
msgctxt "ocEXPAND"
msgid "Columns"
msgstr "Бағандар"

#. EFJZX
#: sc/inc/scfuncs.hrc:4363
msgctxt "ocEXPAND"
msgid "The number of columns in the expanded array. If missing, columns will not be expanded."
msgstr "Кеңейтілген массивтегі бағандар саны. Егер көрсетілмесе, бағандар кеңейтілмейді."

#. hBDD6
#: sc/inc/scfuncs.hrc:4364
msgctxt "ocEXPAND"
msgid "Pad with"
msgstr "Мынамен толтыру"

#. kTicG
#: sc/inc/scfuncs.hrc:4365
msgctxt "ocEXPAND"
msgid "The value with which to pad. The default is #N/A."
msgstr "Толтыру үшін қолданылатын мән. Әдепкі бойынша #N/A."

#. VuRi8
#: sc/inc/scfuncs.hrc:4371
msgctxt "ocHSTACK"
msgid "Appends arrays horizontally to create a larger array."
msgstr "Үлкенірек массив жасау үшін массивтерді горизонталды түрде қосады."

#. NBBGw
#: sc/inc/scfuncs.hrc:4372 sc/inc/scfuncs.hrc:4374
msgctxt "ocHSTACK"
msgid "Array"
msgstr "Массив"

#. nM6qp
#: sc/inc/scfuncs.hrc:4373
msgctxt "ocHSTACK"
msgid "The first array to append."
msgstr "Қосу үшін бірінші массив."

#. atWUi
#: sc/inc/scfuncs.hrc:4375
msgctxt "ocHSTACK"
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer rows, #N/A error will be returned in the additional rows."
msgstr "Массив 1, Массив 2,... Қосылатын келесі массивтер. Егер массивте жолдар саны аз болса, қосымша жолдарда #N/A қатесі қайтарылады."

#. TzKoX
#: sc/inc/scfuncs.hrc:4381
msgctxt "ocVSTACK"
msgid "Appends arrays vertically to create a larger array."
msgstr "Үлкенірек массив жасау үшін массивтерді вертикалды түрде қосады."

#. xBs6J
#: sc/inc/scfuncs.hrc:4382 sc/inc/scfuncs.hrc:4384
msgctxt "ocVSTACK"
msgid "Array"
msgstr "Массив"

#. oLuqo
#: sc/inc/scfuncs.hrc:4383
msgctxt "ocVSTACK"
msgid "The first array to append."
msgstr "Қосу үшін бірінші массив."

#. 8A7Me
#: sc/inc/scfuncs.hrc:4385
msgctxt "ocVSTACK"
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer columns, #N/A error will be returned in the additional columns."
msgstr "Массив 1, Массив 2,... Қосылатын келесі массивтер. Егер массивте бағандар саны аз болса, қосымша бағандарда #N/A қатесі қайтарылады."

#. wiwq5
#: sc/inc/scfuncs.hrc:4391
msgctxt "ocTAKE"
msgid "Returns a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Массивтің басынан немесе соңынан көрсетілген іргелес жолдар немесе бағандар санын қайтарады."

#. rvJFs
#: sc/inc/scfuncs.hrc:4392
msgctxt "ocTAKE"
msgid "Array"
msgstr "Массив"

#. tBVU7
#: sc/inc/scfuncs.hrc:4393
msgctxt "ocTAKE"
msgid "The array from which to take rows or columns."
msgstr "Ішінен жолдар немесе бағандар алынатын массив."

#. A6Jw7
#: sc/inc/scfuncs.hrc:4394
msgctxt "ocTAKE"
msgid "Rows"
msgstr "Жолдар"

#. VP2FG
#: sc/inc/scfuncs.hrc:4395
msgctxt "ocTAKE"
msgid "The number of rows to take. A negative value takes from the end of the array."
msgstr "Алынатын жолдар саны. Теріс мән массивтің соңынан алады."

#. Bw54q
#: sc/inc/scfuncs.hrc:4396
msgctxt "ocTAKE"
msgid "Columns"
msgstr "Бағандар"

#. fGjJX
#: sc/inc/scfuncs.hrc:4397
msgctxt "ocTAKE"
msgid "The number of columns to take. A negative value takes from the end of the array."
msgstr "Алынатын бағандар саны. Теріс мән массивтің соңынан алады."

#. okoEs
#: sc/inc/scfuncs.hrc:4403
msgctxt "ocTEXTAFTER"
msgid "Returns the text that occurs after a given substring or delimiter."
msgstr "Берілген ішкі жолдан немесе ажыратқыштан кейін келетін мәтінді қайтарады."

#. FiLe9
#: sc/inc/scfuncs.hrc:4404
msgctxt "ocTEXTAFTER"
msgid "Text"
msgstr "Мәтін"

#. f5aTy
#: sc/inc/scfuncs.hrc:4405
msgctxt "ocTEXTAFTER"
msgid "The original text."
msgstr "Бастапқы мәтін."

#. UNUCB

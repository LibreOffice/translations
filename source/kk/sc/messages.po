msgctxt "ocX_LOOKUP"
msgid "Result if not found"
msgstr "Табылмаса, қайтарылатын нәтиже"

#. 6mbNe
#: sc/inc/scfuncs.hrc:3459
msgctxt "ocX_LOOKUP"
msgid "If given, return given text, otherwise return #N/A."
msgstr "Көрсетілсе, осы көрсетілген мәтін қайтарылады, болмаса #Қ/Ж."

#. zA7NF
#: sc/inc/scfuncs.hrc:3460
msgctxt "ocX_LOOKUP"
msgid "Match Mode"
msgstr "Сәйкестеу режимі"

#. q6FLc
#: sc/inc/scfuncs.hrc:3461
msgctxt "ocX_LOOKUP"
msgid ""
"0 - Exact match. Will return #N/A if no match. (default).\n"
"-1 - Exact match or the next smaller item.\n"
"1 - Exact match or the next larger item.\n"
"2 - Wildcard match.\n"
"3 - Regular expression match."
msgstr ""
"0 - Дәл сәйкестік. Егер сәйкестік табылмаса, #N/A қайтарады. (әдепкі).\n"
"-1 - Дәл сәйкестік немесе келесі кішілеу элемент.\n"
"1 - Дәл сәйкестік немесе келесі үлкендеу элемент.\n"
"2 - Алмастыру таңбасымен сәйкестік.\n"
"3 - Тұрақты өрнек бойынша сәйкестік."

#. peAXD
#: sc/inc/scfuncs.hrc:3462
msgctxt "ocX_LOOKUP"
msgid "Search Mode"
msgstr "Іздеу режимі"

#. VcnxV
#: sc/inc/scfuncs.hrc:3463
msgctxt "ocX_LOOKUP"
msgid ""
"1 - Search from the first value (default).\n"
"-1 - Search from the last value (reverse).\n"
"2 - Binary search values sorted in ascending order.\n"
"-2 - Binary search values sorted in descending order."
msgstr ""
"1 - Бірінші мәннен бастап іздеу (әдепкі).\n"
"-1 - Соңғы мәннен бастап іздеу (кері).\n"
"2 - Өсу ретімен сұрыпталған мәндер бойынша екілік іздеу.\n"
"-2 - Кему ретімен сұрыпталған мәндер бойынша екілік іздеу."

#. vXvZf
#: sc/inc/scfuncs.hrc:3469
msgctxt "ocINDEX"
msgid "Returns a reference to a cell from a defined range."
msgstr "Берілген ауқымға жататын ұяшық құрамасын қайтарады."

#. EGfDu
#: sc/inc/scfuncs.hrc:3470
msgctxt "ocINDEX"
msgid "Reference"
msgstr "Сілтеме"

#. JStZ5
#: sc/inc/scfuncs.hrc:3471
msgctxt "ocINDEX"
msgid "The reference to a (multiple) range."
msgstr "Бір немесе бірнеше ауқымға сілтеме."


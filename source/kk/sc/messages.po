#: sc/inc/scfuncs.hrc:3520
msgctxt "ocX_MATCH"
msgid "Search Array"
msgstr "Ішінен іздеу үшін массив"

#. jdnmq
#: sc/inc/scfuncs.hrc:3521
msgctxt "ocX_MATCH"
msgid "The array or range to search."
msgstr "Ішінен іздеу үшін массив немесе ауқым."


#. XCCUs
#: sc/inc/scfuncs.hrc:3752
msgctxt "ocFIND"
msgid "Find text"
msgstr "Ізделетін мәтін"

#. EAxVC
#: sc/inc/scfuncs.hrc:3753
msgctxt "ocFIND"
msgid "The text to be found."
msgstr "Табу үшін мәтін."

#. hP6AR
#: sc/inc/scfuncs.hrc:3754
msgctxt "ocFIND"
msgid "Text"
msgstr "Мәтін"

#. MgVxo
#: sc/inc/scfuncs.hrc:3755
msgctxt "ocFIND"
msgid "The text in which a search is to be made."
msgstr "Ішінен іздеу үшін мәтін."

#. EB2Fg
#: sc/inc/scfuncs.hrc:3756
msgctxt "ocFIND"
msgid "Position"
msgstr "Орын"

#. KaK97
#: sc/inc/scfuncs.hrc:3757
msgctxt "ocFIND"
msgid "The position in the text from which the search starts."
msgstr "Мәтіндегі іздеу басталатын орны."

#. Q56N4
#: sc/inc/scfuncs.hrc:3763
msgctxt "ocSEARCH"
msgid "Looks for one text value within another (not case-sensitive)."
msgstr "Мәтінде (регистрді ескермей) басқа мәтінді іздейді."

#. rcKnP
#: sc/inc/scfuncs.hrc:3764
msgctxt "ocSEARCH"
msgid "Find text"
msgstr "Ізделетін мәтін"

#. CCFGR
#: sc/inc/scfuncs.hrc:3765
msgctxt "ocSEARCH"
msgid "The text to be found."
msgstr "Табу үшін мәтін."

#. jCXLx
#: sc/inc/scfuncs.hrc:3766
msgctxt "ocSEARCH"
msgid "Text"
msgstr "Мәтін"

#. GgCCy
#: sc/inc/scfuncs.hrc:3767
msgctxt "ocSEARCH"
msgid "The text in which a search is to be made."
msgstr "Ішінен іздеу үшін мәтін."

#. JdGmJ
#: sc/inc/scfuncs.hrc:3768
msgctxt "ocSEARCH"
msgid "Position"
msgstr "Қызметі"

#. UWg3H
#: sc/inc/scfuncs.hrc:3769
msgctxt "ocSEARCH"
msgid "The position in the text where the search is started."
msgstr "Мәтіндегі іздеу басталатын орны."

#. oxkZC
#: sc/inc/scfuncs.hrc:3775
msgctxt "ocTRIM"
msgid "Removes extra spaces from text."
msgstr "Сөздер арасындағы артық бос аралықтарды өшіреді."

#. VxHVQ
#: sc/inc/scfuncs.hrc:3776
msgctxt "ocTRIM"
msgid "Text"
msgstr "Мәтін"

#. G4RE2
#: sc/inc/scfuncs.hrc:3777
msgctxt "ocTRIM"
msgid "The text in which extra spaces between words are to be deleted."
msgstr "Артық бос аралықтарды өшіру үшін мәтін."

#. KTAkS
#: sc/inc/scfuncs.hrc:3783
msgctxt "ocPROPER"
msgid "Capitalizes the first letter in all words."
msgstr "Барлық сөздердің бірінші әріптерін бас әріп қылады."

#. bs7zA
#: sc/inc/scfuncs.hrc:3784
msgctxt "ocPROPER"
msgid "Text"
msgstr "Мәтін"

#. knQ6h
#: sc/inc/scfuncs.hrc:3785
msgctxt "ocPROPER"
msgid "The text in which the beginning of words are to be replaced by capital letters."
msgstr "Сөздердің бірінші әріптерін бас әріп қылу үшін мәтін."

#. rVBP5
#: sc/inc/scfuncs.hrc:3791
msgctxt "ocUPPER"
msgid "Converts text to uppercase."
msgstr "Мәтінді бас әріптерге түрлендіреді."

#. cQj2B
#: sc/inc/scfuncs.hrc:3792
msgctxt "ocUPPER"
msgid "Text"
msgstr "Мәтін"

#. AEyBM
#: sc/inc/scfuncs.hrc:3793
msgctxt "ocUPPER"
msgid "The text in which lower case letters are to be converted to capitals."
msgstr "Кіші әріптерді бас әріптер етіп қылу үшін мәтін."

#. 5u5iC
#: sc/inc/scfuncs.hrc:3799
msgctxt "ocLOWER"
msgid "Converts text to lowercase."
msgstr "Мәтінді кіші әріптерге түрлендіреді."

#. B5Vzm
#: sc/inc/scfuncs.hrc:3800
msgctxt "ocLOWER"
msgid "Text"
msgstr "Мәтін"

#. Crumi
#: sc/inc/scfuncs.hrc:3801
msgctxt "ocLOWER"
msgid "The text in which capitals are converted to lower case letters."
msgstr "Бас әріптерді кіші әріптер етіп қылу үшін мәтін."

#. S6AN6
#: sc/inc/scfuncs.hrc:3807
msgctxt "ocVALUE"
msgid "Converts text to a number."
msgstr "Мәтінді санға түрлендіреді."

#. kS8WD
#: sc/inc/scfuncs.hrc:3808
msgctxt "ocVALUE"
msgid "Text"
msgstr "Мәтін"

#. s8Xoq
#: sc/inc/scfuncs.hrc:3809
msgctxt "ocVALUE"
msgid "The text to be converted to a number."
msgstr "Санға түрлендірілетін мәтін."

#. 7ufRd
#: sc/inc/scfuncs.hrc:3815
msgctxt "ocTEXT"
msgid "Converts a number to text according to a given format."
msgstr "Көрсетілген пішімге сәйкес санды мәтінге түрлендіреді."

#. ht9Hc
#: sc/inc/scfuncs.hrc:3816
msgctxt "ocTEXT"
msgid "Number"
msgstr "Саны"

#. aifRA
#: sc/inc/scfuncs.hrc:3817
msgctxt "ocTEXT"
msgid "The numeric value to be converted."
msgstr "Түрлендірілетін сандық мән."

#. WegPU
#: sc/inc/scfuncs.hrc:3818
msgctxt "ocTEXT"
msgid "Format"
msgstr "Пішім"

#. gLwBY
#: sc/inc/scfuncs.hrc:3819
msgctxt "ocTEXT"
msgid "The text that describes the format."
msgstr "Пішімді білдіретін мәтін."

#. jWECZ
#: sc/inc/scfuncs.hrc:3825
msgctxt "ocT"
msgid "Returns a value if it is text, otherwise an empty string."
msgstr "Мәні мәтін болса, оны қайтарады, болмаса, бос жолды қайтарады."

#. z7ZYL
#: sc/inc/scfuncs.hrc:3826
msgctxt "ocT"
msgid "Value"
msgstr "Мәні"

#. tGsYm
#: sc/inc/scfuncs.hrc:3827
msgctxt "ocT"

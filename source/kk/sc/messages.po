msgstr "Сұхбат терезесін жабады және барлық өзгерістерден бас тартады."

#. 5DuJ2
#: sc/uiconfig/scalc/ui/pivotcalcfielddialog.ui:119
msgctxt "pivotcalcfielddialog|label1"
msgid "Name:"
msgstr "Аты:"

#. mCCW9
#: sc/uiconfig/scalc/ui/pivotcalcfielddialog.ui:134
msgctxt "pivotcalcfielddialog|label2"
msgid "Formula:"
msgstr "Формула:"


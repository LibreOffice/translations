#: sc/inc/scfuncs.hrc:4540
msgctxt "ocLAMBDA"
msgid "Parameter 1"
msgstr ""

#. 5bxd6
#: sc/inc/scfuncs.hrc:4541
msgctxt "ocLAMBDA"
msgid "The name of the first parameter to the function. The name must follow the range naming rules and cannot be the output of a text formula."
msgstr ""

#. XXGaE
#: sc/inc/scfuncs.hrc:4542
msgctxt "ocLAMBDA"
msgid "Formula or Parameter "

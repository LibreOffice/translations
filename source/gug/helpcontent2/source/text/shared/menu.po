msgctxt ""
"comment_menu.xhp\n"
"par_id171685994484069\n"
"help.text"
msgid "Marks the comment thread as <emph>Resolved</emph> (or <emph>Unresolved</emph>). All comments in the thread are marked <emph>Resolved</emph> (or <emph>Unresolved)</emph>."
msgstr "Marca el hilo de comentarios como <emph>Resuelto</emph> (o <emph>Sin resolver</emph>). Todos los comentarios del hilo están marcados como <emph>Resuelto</emph> (o <emph>Sin resolver)</emph>."


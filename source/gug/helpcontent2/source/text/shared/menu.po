"par_id3147352\n"
"help.text"
msgid "<ahelp hid=\".\">These commands apply to the current document, create a document, open an existing document, or close the application.</ahelp>"
msgstr "<ahelp hid=\".\">Estas órdenes aplicables al documento actual permiten crear un documento, abrir uno existente o cerrar la aplicación.</ahelp>"


msgctxt ""
"PickList.xhp\n"
"par_id3151112\n"
"help.text"
msgid "<ahelp hid=\".\">These commands apply to the current spreadsheet, create a spreadsheet, open an existing spreadsheet, or close the application.</ahelp>"
msgstr "<ahelp hid=\".\">Estas órdenes aplicables a la hoja de cálculo actual permiten crear una hoja de cálculo, abrir una existente o cerrar la aplicación.</ahelp>"

#. C5giA

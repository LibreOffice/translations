#: sc/inc/scfuncs.hrc:4506
msgctxt "ocWRAPCOLS"
msgid "Range"
msgstr "Område"

#. h3vyV
#: sc/inc/scfuncs.hrc:4507
msgctxt "ocWRAPCOLS"
msgid "the range to wrap."
msgstr "området som ska brytas."

#. nCGAe
#: sc/inc/scfuncs.hrc:4508
msgctxt "ocWRAPCOLS"
msgid "Wrap count"
msgstr "Antal brytningar"

#. su9gg
#: sc/inc/scfuncs.hrc:4509
msgctxt "ocWRAPCOLS"
msgid "The maximum number of values for each column."
msgstr "Det maximala antalet värden för varje kolumn."


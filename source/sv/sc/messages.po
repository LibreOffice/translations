#: sc/inc/scfuncs.hrc:4422
msgctxt "ocTEXTBEFORE"
msgid "Text"
msgstr "Text"

#. 7rRBe
#: sc/inc/scfuncs.hrc:4423
msgctxt "ocTEXTBEFORE"
msgid "The original text."
msgstr "Originaltexten."

#. pD2BF
#: sc/inc/scfuncs.hrc:4424
msgctxt "ocTEXTBEFORE"
msgid "Delimiter"
msgstr "Avgränsare"

#. atLy4
#: sc/inc/scfuncs.hrc:4425
msgctxt "ocTEXTBEFORE"
msgid "The delimiter. Multiple delimiters can be supplied."
msgstr "Avgränsare. Flera avgränsare kan anges."

#. a8AQn
#: sc/inc/scfuncs.hrc:4426
msgctxt "ocTEXTBEFORE"
msgid "Instance Number"
msgstr "Instansnummer"

#. LKDm8
#: sc/inc/scfuncs.hrc:4427
msgctxt "ocTEXTBEFORE"
msgid "The instance of the delimiter before which to extract text. The default is 1. A negative number starts searching from the end."
msgstr "Instansen av avgränsaren före vilken text ska extraheras. Standardvärdet är 1. Ett negativt tal börjar söka från slutet."

#. zpBYX
#: sc/inc/scfuncs.hrc:4428
msgctxt "ocTEXTBEFORE"
msgid "Match Mode"
msgstr "Matchningsläge"

#. oDYnK
#: sc/inc/scfuncs.hrc:4429
msgctxt "ocTEXTBEFORE"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Ställ in på 1 för att utföra en skiftlägeskänslig matchning. Standardinställningen är 0."

#. 3KUNG
#: sc/inc/scfuncs.hrc:4430
msgctxt "ocTEXTBEFORE"
msgid "Match End"
msgstr "Slut på match"

#. VutiR
#: sc/inc/scfuncs.hrc:4431
msgctxt "ocTEXTBEFORE"
msgid "Set to 1 to treat the end of text as a delimiter. The default is 0."
msgstr "Ställ in på 1 för att behandla slutet av texten som en avgränsare. Standardvärdet är 0."

#. zBdc8
#: sc/inc/scfuncs.hrc:4432
msgctxt "ocTEXTBEFORE"
msgid "If Not Found"
msgstr "Om den inte hittas"

#. Vo5kF
#: sc/inc/scfuncs.hrc:4433
msgctxt "ocTEXTBEFORE"
msgid "The value returned if no match is found. The default is #N/A."
msgstr "Värdet som returneras om ingen matchning hittas. Standardvärdet är #N/A."

#. uy7ox
#: sc/inc/scfuncs.hrc:4439
msgctxt "ocTEXTSPLIT"
msgid "Splits text by a given delimiter to an array of multiple cells."
msgstr "Delar text med ett givet avgränsningstecken till en matris med flera celler."

#. qHpXB
#: sc/inc/scfuncs.hrc:4440
msgctxt "ocTEXTSPLIT"
msgid "Text"
msgstr "Text"

#. 5HCeW
#: sc/inc/scfuncs.hrc:4441
msgctxt "ocTEXTSPLIT"
msgid "The text to split."
msgstr "Texten som ska delas."

#. iijbx
#: sc/inc/scfuncs.hrc:4442
msgctxt "ocTEXTSPLIT"
msgid "Column Delimiter"
msgstr "Kolumnavgränsare"

#. mtWBs
#: sc/inc/scfuncs.hrc:4443
msgctxt "ocTEXTSPLIT"
msgid "The text to delimit the columns. Multiple delimiters can be supplied."
msgstr "Texten som avgränsar kolumnerna. Flera avgränsare kan anges."

#. RyAtV
#: sc/inc/scfuncs.hrc:4444
msgctxt "ocTEXTSPLIT"
msgid "Row Delimiter"
msgstr "Radavgränsare"

#. 9CxYK
#: sc/inc/scfuncs.hrc:4445
msgctxt "ocTEXTSPLIT"
msgid "The text to delimit the rows. Multiple delimiters can be supplied."
msgstr "Texten som avgränsar raderna. Flera avgränsare kan anges."

#. CuHLJ
#: sc/inc/scfuncs.hrc:4446
msgctxt "ocTEXTSPLIT"
msgid "Ignore Empty"
msgstr "Ignorera tomma"

#. Qrkvd
#: sc/inc/scfuncs.hrc:4447
msgctxt "ocTEXTSPLIT"
msgid "Set to TRUE to ignore consecutive delimiters otherwise it creates an empty cell. The default is FALSE."
msgstr "Sätt till SANT för att ignorera efterföljande avgränsare, annars skapas en tom cell. Standardvärdet är FALSKT."

#. AUSmr
#: sc/inc/scfuncs.hrc:4448
msgctxt "ocTEXTSPLIT"
msgid "Match mode"
msgstr "Matchningsläge"

#. pjYxd
#: sc/inc/scfuncs.hrc:4449
msgctxt "ocTEXTSPLIT"
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Ställ in på 1 för att utföra en skiftlägeskänslig matchning. Standardinställningen är 0."

#. LsoKk
#: sc/inc/scfuncs.hrc:4450
msgctxt "ocTEXTSPLIT"
msgid "Pad with"
msgstr "Fyll ut med"

#. niX3W
#: sc/inc/scfuncs.hrc:4451
msgctxt "ocTEXTSPLIT"
msgid "The value with which to pad. The default is #N/A."
msgstr "Värdet som ska fyllas ut med. Standard är #N/A."

#. dv6gP
#: sc/inc/scfuncs.hrc:4457
msgctxt "ocTOCOL"
msgid "Transforms an array into a single column."
msgstr "Omvandlar en matris till en enda kolumn."

#. A9zBS
#: sc/inc/scfuncs.hrc:4458
msgctxt "ocTOCOL"
msgid "Array"
msgstr "Matris"

#. x95Ef
#: sc/inc/scfuncs.hrc:4459
msgctxt "ocTOCOL"
msgid "The range or array to return as a single column."
msgstr "Området eller matrisen som ska returneras som en enda kolumn."

#. weBya
#: sc/inc/scfuncs.hrc:4460
msgctxt "ocTOCOL"
msgid "Ignore"
msgstr "Ignorera"

#. 5JhDs
#: sc/inc/scfuncs.hrc:4461
msgctxt "ocTOCOL"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Om man ska ignorera vissa typer av värden. 0 eller utelämnad - behåll alla värden (standard). 1 - ignorera tomma celler. 2 - ignorera celler med fel. 3 - ignorera tomma celler och celler med fel."

#. DDm6x
#: sc/inc/scfuncs.hrc:4462
msgctxt "ocTOCOL"
msgid "Scan by column"
msgstr "Skanna efter kolumn"

#. LwBTC
#: sc/inc/scfuncs.hrc:4463
msgctxt "ocTOCOL"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "Skanna matrisen efter kolumn. FALSE eller utelämnad (standard) - matrisen skannas efter rad. TRUE - matrisen skannas efter kolumn."

#. 89qUq
#: sc/inc/scfuncs.hrc:4469
msgctxt "ocTOROW"
msgid "transforms an array into a single row."
msgstr "Omvandlar en matris till en enda rad."

#. GAbkQ
#: sc/inc/scfuncs.hrc:4470
msgctxt "ocTOROW"
msgid "Array"
msgstr "Matris"

#. w7WXB
#: sc/inc/scfuncs.hrc:4471
msgctxt "ocTOROW"
msgid "The range or array to return as a single row."
msgstr "Området eller matrisen som ska returneras som en enda rad."

#. GCfA2
#: sc/inc/scfuncs.hrc:4472
msgctxt "ocTOROW"
msgid "Ignore"
msgstr "Ignorera"

#. AnEDD
#: sc/inc/scfuncs.hrc:4473
msgctxt "ocTOROW"
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Om man ska ignorera vissa typer av värden. 0 eller utelämnad - behåll alla värden (standard). 1 - ignorera tomma celler. 2 - ignorera celler med fel. 3 - ignorera tomma celler och celler med fel."

#. pDD7V
#: sc/inc/scfuncs.hrc:4474
msgctxt "ocTOROW"
msgid "Scan by column"
msgstr "Skanna efter kolumn"

#. qxY7a
#: sc/inc/scfuncs.hrc:4475
msgctxt "ocTOROW"
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "Skanna matrisen efter kolumn. FALSE eller utelämnad (standard) - matrisen skannas efter rad. TRUE - matrisen skannas efter kolumn."

#. 8p5AW
#: sc/inc/scfuncs.hrc:4481
msgctxt "ocUNIQUE"
msgid "Returns a list of unique values from a range or array."
msgstr "Returnerar en lista med unika värden från ett intervall eller en matris."

#. LAeWQ
#: sc/inc/scfuncs.hrc:4482
msgctxt "ocUNIQUE"
msgid "Array"
msgstr "Matris"

#. LHrXJ
#: sc/inc/scfuncs.hrc:4483
msgctxt "ocUNIQUE"
msgid "The range or array from which to return unique values."
msgstr "Området eller matrisen från vilken unika värden ska returneras."

#. TBfHR
#: sc/inc/scfuncs.hrc:4484
msgctxt "ocUNIQUE"
msgid "By col"
msgstr "Efter kolumn"

#. xiVEn
#: sc/inc/scfuncs.hrc:4485
msgctxt "ocUNIQUE"
msgid "Logical value indicating how to compare data: TRUE - compares data across columns. FALSE or omitted (default) - compares data across rows."
msgstr "Logiskt värde som indikerar hur data jämförs: SANN - jämför data mellan kolumner. FALSK eller utelämnad (standard) - jämför data mellan rader."

#. GLsJf
#: sc/inc/scfuncs.hrc:4486
msgctxt "ocUNIQUE"
msgid "Uniqueness"
msgstr "Unikhet"

#. ubRgX
#: sc/inc/scfuncs.hrc:4487
msgctxt "ocUNIQUE"
msgid "Logical value that defines what values are considered unique: TRUE - returns values that occur only once. FALSE or omitted (default) - returns all distinct (different) values in the range or array."
msgstr "Logiskt värde som definierar vilka värden som anses vara unika: SANN - returnerar värden som bara förekommer en gång. FALSK eller utelämnad (standard) - returnerar alla distinkta (olika) värden i intervallet eller matrisen."

#. 5Aaqr
#: sc/inc/scfuncs.hrc:4493
msgctxt "ocLET"
msgid "The LET function assigns names to calculation results. This allows storing intermediate calculations, values, or defining names inside a formula. These names only apply within the scope of the LET function."
msgstr "LET-funktionen tilldelar beräkningsresultat namn. Detta gör det möjligt att lagra mellanliggande beräkningar, värden eller definiera namn i en formel. Dessa namn gäller endast inom ramen för LET-funktionen."

#. GTBCS
#: sc/inc/scfuncs.hrc:4494
msgctxt "ocLET"
msgid "Name 1"
msgstr "Namn 1"

#. BXEhz
#: sc/inc/scfuncs.hrc:4495
msgctxt "ocLET"
msgid "The first name to assign. Must start with a letter. Cannot be the output of a formula or conflict with range syntax."
msgstr "Det första namnet att tilldela. Måste börja med en bokstav. Kan inte vara resultatet av en formel eller konflikt med intervallsyntaxen."

#. agD98
#: sc/inc/scfuncs.hrc:4496
msgctxt "ocLET"
msgid "Name value "
msgstr "Namnvärde "

#. CjEiH
#: sc/inc/scfuncs.hrc:4497
msgctxt "ocLET"
msgid "Name value 1, Name value 2,... The value or calculation to assign to Name."
msgstr "Namnvärde 1, Namnvärde 2,... Värdet eller beräkningen att tilldela Namn."

#. GCAQK
#: sc/inc/scfuncs.hrc:4498
msgctxt "ocLET"
msgid "Calculation or Name "
msgstr "Beräkning eller namn "

#. uzEFm
#: sc/inc/scfuncs.hrc:4499
msgctxt "ocLET"
msgid "A calculation that uses all names within the LET function. This must be the last argument in the LET function. Or a second Name to assign to a second Name value. If a second Name is specified, Name value 2 and Calculation or Name 3 become required."
msgstr "En beräkning som använder alla namn inom LET-funktionen. Detta måste vara det sista argumentet i LET-funktionen. Eller ett andra namn att tilldela ett andra namnvärde. Om ett andra namn anges krävs namnvärde 2 och beräkning eller namn 3."

#. HbPvG
#: sc/inc/scfuncs.hrc:4505
msgctxt "ocWRAPCOLS"
msgid "Wraps the provided row or column of values by columns after a specified number of elements to form a new array."
msgstr "Bryter den angivna raden eller kolumnen med värden efter kolumner efter ett angivet antal element för att bilda en ny matris."


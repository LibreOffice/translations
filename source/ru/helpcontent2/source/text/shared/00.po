"help.text"
msgid "<image id=\"img_id3148685\" src=\"formula/res/refinp1.svg\" width=\"1cm\" height=\"1cm\"><alt id=\"alt_id3148685\">Icon shrink</alt></image>"
msgstr "<image id=\"img_id3148685\" src=\"formula/res/refinp1.svg\" width=\"1cm\" height=\"1cm\"><alt id=\"alt_id3148685\">Значок «Свернуть»</alt></image>"

#. fdGk2

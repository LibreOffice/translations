#. opfuB
#: 00000002.xhp
msgctxt ""
"00000002.xhp\n"
"hd_id3150751\n"
"help.text"
msgid "Tags"
msgstr "Теги"

#. cH38H
#: 00000002.xhp
msgctxt ""
"00000002.xhp\n"
"par_id3156360\n"
"help.text"
msgid "<link href=\"text/shared/00/00000002.xhp#html\">HTML</link> pages contain certain structural and formatting instructions called tags. Tags are code words enclosed by brackets in the document description language HTML. Many tags contain text or hyperlink references between the opening and closing brackets. For example, titles are marked by the tags <h1> at the beginning and </h1> at the end of the title. Some tags only appear on their own such as <br> for a line break or <img ...> to link a graphic."
msgstr "<link href=\"text/shared/00/00000002.xhp#html\">HTML</link>-страницы содержат специальные инструкции для формирования структуры и форматирования, называемые тегами. Теги представляют собой кодовые слова языка описания документов HTML, заключенные в угловые скобки. Многие теги содержат текст или гиперссылки между открывающим и закрывающим тегом. Например, заголовки помечаются тегами <h1> в начале и </h1> в конце. Некоторые теги используются без пары, например, <br> для разрыва строки или <img ...> для вставки изображения."

#. c7EwD
#: 00000002.xhp
msgctxt ""
"00000002.xhp\n"
"bm_id3153766\n"
"help.text"
msgid "<bookmark_value>URL; definition</bookmark_value>"
msgstr "<bookmark_value>URL-адрес; определение</bookmark_value>"

#. d5uGy
#: 00000002.xhp
msgctxt ""
"00000002.xhp\n"
"hd_id3153766\n"
"help.text"
msgid "URL"
msgstr "URL"

#. iNrmL
#: 00000002.xhp
msgctxt ""
"00000002.xhp\n"
"par_id3152931\n"
"help.text"
msgid "The Uniform Resource Locator (URL) displays the address of a document or a server in the Internet. The general structure of a URL varies according to type and is generally in the form Service://Hostname:Port/Path/Page#Mark although not all elements are always required. A URL can be a WWW (HTTP) address, a file address or an email address."
msgstr "URL-адрес (Uniform Resource Locator) определяет адрес документа или сервера в Интернете. Общая структура URL-адреса зависит от его типа и обычно имеет вид «Служба://Хост:Порт/Путь/Страница#Якорь», хоть и не все его элементы являются обязательными. URL-адрес может быть представлен в виде веб-адреса (HTTP), адреса файла или адреса электронной почты."


#. oRhpG
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"hd_id3145609\n"
"help.text"
msgid "Next"
msgstr "Далее"

#. FALip
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"par_id3152473\n"
"help.text"
msgid "<ahelp hid=\".\">Click the <emph>Next</emph> button, and the wizard uses the current dialog settings and proceeds to the next step. If you are on the last step, this button becomes <emph>Create</emph>.</ahelp>"
msgstr "<ahelp hid=\".\">Нажмите кнопку <emph>Далее</emph>, мастер сохранит текущие параметры диалогового окна и перейдёт на следующий шаг. На последнем шаге вместо этой кнопки выводится кнопка <emph>Создать</emph>.</ahelp>"

#. CdxRF
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"hd_id3149671\n"
"help.text"
msgid "Dialog Buttons"
msgstr "Кнопки диалогового окна"

#. kDCfe
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"par_id3145069\n"
"help.text"
msgid "Reset"
msgstr "Сброс"

#. 79sAc
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"par_id3145169\n"
"help.text"
msgid "<ahelp hid=\"cui/ui/autocorrectdialog/reset\">Resets modified values back to the tab page previous values.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/autocorrectdialog/reset\">Сбрасывает изменённые значения параметров на их предыдущие значения на вкладке.</ahelp>"

#. xRFYz
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"par_id3145070\n"
"help.text"
msgid "Cancel"
msgstr "Отмена"

#. DRgMc
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"par_id3145269\n"
"help.text"
msgid "<ahelp hid=\"cui/ui/autocorrectdialog/cancel\">Closes dialog and discards all changes.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/autocorrectdialog/cancel\">Закрывает диалоговое окно и сбрасывает все изменения.</ahelp>"

#. me9Ac
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"par_id3145071\n"
"help.text"
msgid "OK"
msgstr "ОК"

#. Uvi2W
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"par_id3145369\n"
"help.text"
msgid "<ahelp hid=\"cui/ui/autocorrectdialog/ok\">Saves all changes and closes dialog.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/autocorrectdialog/ok\">Сохраняет все изменения и закрывает диалоговое окно.</ahelp>"

#. vTQBi
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"hd_id3149670\n"
"help.text"
msgid "Reset"
msgstr "Сброс"

#. Fm6tQ
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"par_id3145068\n"
"help.text"
msgid "<ahelp hid=\"cui/ui/optionsdialog/revert\">Resets changes made to the current tab to those applicable when this dialog was opened.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/optionsdialog/revert\">Сбрасывает изменения на текущей вкладке до значений, заданных при открытии диалогового окна.</ahelp>"

#. DNiea
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"hd_id3148755\n"
"help.text"
msgid "Reset"
msgstr "Сброс"

#. aGwjy
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"par_id3149651\n"
"help.text"
msgid "<ahelp hid=\".\">Resets changes made to the current tab to those applicable when this dialog was opened. A confirmation query does not appear when you close the dialog.</ahelp>"
msgstr "<ahelp hid=\".\">Сбрасывает изменения на текущей вкладке до значений, заданных при открытии диалогового окна. Подтверждение при закрытии диалогового окна не выводится.</ahelp>"

#. DUgD9
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"hd_id3145173\n"
"help.text"
msgid "Standard"
msgstr "Стандартный"

#. 8ET6i
#: 00000001.xhp
msgctxt ""
"00000001.xhp\n"
"par_id3154153\n"
"help.text"
msgid "<ahelp hid=\".\">Resets the values visible in the dialog back to the default installation values.</ahelp>"
msgstr "<ahelp hid=\".\">Сбрасывает отображаемые в диалоговом окне значения до заданных по умолчанию при установке.</ahelp>"

#. gbTdA
#: 00000001.xhp
msgctxt ""

"par_id3145829\n"
"help.text"
msgid "<ahelp hid=\"modules/swriter/ui/asciifilterdialog/crlf\">Produces a \"Carriage Return\" and a \"Linefeed\". This option is the default.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/asciifilterdialog/crlf\">Производит возврат каретки и перевод строки. Этот параметр задан по умолчанию.</ahelp>"

